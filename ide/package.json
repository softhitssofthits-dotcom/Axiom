{
  "name": "axiom-ide",
  "version": "0.15.3",
  "description": "Desktop IDE for the Axiom language (Electron + Monaco Editor)",
  "main": "src/main/main.js",
  "scripts": {
    "prepare": "node ../scripts/versioning.mjs check && node ../scripts/versioning.mjs install-hooks && node scripts/prepare.js",
    "prestart": "node ../scripts/versioning.mjs check",
    "version:check": "node ../scripts/versioning.mjs check",
    "start": "electron ."
  },
  "license": "MIT",
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
