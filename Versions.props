<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.40</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.40</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.30</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.40</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.30</Version>
  </PropertyGroup>
</Project>
