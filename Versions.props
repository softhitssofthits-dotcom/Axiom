<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.2.7</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.3.6</AxiomCompilerVersion>
    <AxiomIdeVersion>0.8.14</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.3.6</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.8.14</Version>
  </PropertyGroup>
</Project>
