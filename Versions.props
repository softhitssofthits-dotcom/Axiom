<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.13</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.13</AxiomCompilerVersion>
    <AxiomIdeVersion>0.4.11</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.13</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.4.11</Version>
  </PropertyGroup>
</Project>
