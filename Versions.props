<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.7.2</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.8.2</AxiomCompilerVersion>
    <AxiomIdeVersion>0.12.1</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.8.2</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.12.1</Version>
  </PropertyGroup>
</Project>
