<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.12.16</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.13.90</AxiomCompilerVersion>
    <AxiomIdeVersion>0.15.8</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.13.90</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.15.8</Version>
  </PropertyGroup>
</Project>
