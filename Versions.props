<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.2.1</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.2.3</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.35</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.2.3</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.35</Version>
  </PropertyGroup>
</Project>
