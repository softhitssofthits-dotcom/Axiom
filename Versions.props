<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.9.0</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.10.0</AxiomCompilerVersion>
    <AxiomIdeVersion>0.14.2</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.10.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.14.2</Version>
  </PropertyGroup>
</Project>
