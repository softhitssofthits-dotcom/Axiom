<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.10.0</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.11.0</AxiomCompilerVersion>
    <AxiomIdeVersion>0.15.1</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.11.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.15.1</Version>
  </PropertyGroup>
</Project>
