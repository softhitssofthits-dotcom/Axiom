<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.12.0</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.13.33</AxiomCompilerVersion>
    <AxiomIdeVersion>0.15.5</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.13.33</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.15.5</Version>
  </PropertyGroup>
</Project>
