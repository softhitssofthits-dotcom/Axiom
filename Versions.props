<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.12.18</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.13.92</AxiomCompilerVersion>
    <AxiomIdeVersion>0.15.11</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.13.92</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.15.11</Version>
  </PropertyGroup>
</Project>
