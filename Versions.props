<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.7.0</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.8.0</AxiomCompilerVersion>
    <AxiomIdeVersion>0.12.0</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.8.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.12.0</Version>
  </PropertyGroup>
</Project>
