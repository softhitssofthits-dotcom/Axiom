<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.8</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.8</AxiomCompilerVersion>
    <AxiomIdeVersion>0.2.8</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.8</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.2.8</Version>
  </PropertyGroup>
</Project>
