<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.4.0</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.5.0</AxiomCompilerVersion>
    <AxiomIdeVersion>0.9.2</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.5.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.9.2</Version>
  </PropertyGroup>
</Project>
