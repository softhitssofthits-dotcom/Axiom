<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.35</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.35</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.26</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.35</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.26</Version>
  </PropertyGroup>
</Project>
