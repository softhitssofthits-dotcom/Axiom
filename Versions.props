<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.25</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.25</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.22</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.25</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.22</Version>
  </PropertyGroup>
</Project>
