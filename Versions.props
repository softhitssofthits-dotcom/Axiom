<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.38</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.38</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.28</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.38</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.28</Version>
  </PropertyGroup>
</Project>
