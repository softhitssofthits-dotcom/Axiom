<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.2</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.2</AxiomCompilerVersion>
    <AxiomIdeVersion>0.2.2</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.2</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.2.2</Version>
  </PropertyGroup>
</Project>
