<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.18</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.18</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.20</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.18</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.20</Version>
  </PropertyGroup>
</Project>
