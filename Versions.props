<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.5.0</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.6.0</AxiomCompilerVersion>
    <AxiomIdeVersion>0.10.0</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.6.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.10.0</Version>
  </PropertyGroup>
</Project>
