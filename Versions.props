<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.30</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.30</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.24</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.30</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.24</Version>
  </PropertyGroup>
</Project>
