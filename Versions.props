<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.14</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.14</AxiomCompilerVersion>
    <AxiomIdeVersion>0.5.2</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.14</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.5.2</Version>
  </PropertyGroup>
</Project>
