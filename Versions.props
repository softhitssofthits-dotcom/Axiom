<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.9</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.9</AxiomCompilerVersion>
    <AxiomIdeVersion>0.2.9</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.9</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.2.9</Version>
  </PropertyGroup>
</Project>
