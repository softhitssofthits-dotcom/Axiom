<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.2.3</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.3.2</AxiomCompilerVersion>
    <AxiomIdeVersion>0.8.8</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.3.2</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.8.8</Version>
  </PropertyGroup>
</Project>
