<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.15</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.15</AxiomCompilerVersion>
    <AxiomIdeVersion>0.6.14</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.15</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.6.14</Version>
  </PropertyGroup>
</Project>
