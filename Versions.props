<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.2.5</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.3.4</AxiomCompilerVersion>
    <AxiomIdeVersion>0.8.9</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.3.4</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.8.9</Version>
  </PropertyGroup>
</Project>
