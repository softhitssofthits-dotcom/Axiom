<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.12.15</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.13.59</AxiomCompilerVersion>
    <AxiomIdeVersion>0.15.7</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.13.59</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.15.7</Version>
  </PropertyGroup>
</Project>
