<Project>
  <!-- Создан scripts/versioning.mjs из versions.json. -->
  <PropertyGroup>
    <AxiomLanguageVersion>0.1.1</AxiomLanguageVersion>
    <AxiomCompilerVersion>0.1.1</AxiomCompilerVersion>
    <AxiomIdeVersion>0.2.1</AxiomIdeVersion>
    <Version Condition="'$(MSBuildProjectName)' != 'Axiom.DesktopHost'">0.1.1</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Axiom.DesktopHost'">0.2.1</Version>
  </PropertyGroup>
</Project>
