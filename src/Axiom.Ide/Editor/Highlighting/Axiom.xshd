            <Word>OPEN</Word>
            <Word>OR</Word>
            <Word>OUTPUT</Word>
            <Word>PRESERVE</Word>
            <Word>PRINT</Word>
            <Word>REDIM</Word>
            <Word>RETURN</Word>
            <Word>SELF</Word>
            <Word>SELECT</Word>
            <Word>STEP</Word>
            <Word>STOP</Word>
            <Word>SUB</Word>
            <Word>THEN</Word>
            <Word>TO</Word>
            <Word>TRY</Word>
            <Word>TRUE</Word>
            <Word>TYPE</Word>
            <Word>UNTIL</Word>
            <Word>USING</Word>
            <Word>WHILE</Word>
            <Word>XOR</Word>
        </Keywords>

        <Keywords color="TypeName">
            <Word>BOOLEAN</Word>
            <Word>DECIMAL</Word>
            <Word>DOUBLE</Word>
            <Word>FILE</Word>
            <Word>INTEGER</Word>
            <Word>LONG</Word>
            <Word>STRING</Word>
