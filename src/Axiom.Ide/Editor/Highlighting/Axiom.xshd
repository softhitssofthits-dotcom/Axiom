<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="Axiom"
                  extensions=".axm"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <Color name="Comment"
           foreground="#008000"
           fontStyle="italic" />
    <Color name="Keyword"
           foreground="#0000FF" />
    <Color name="String"
           foreground="#A31515" />
    <Color name="Number"
           foreground="#975EAD" />
    <Color name="TypeName"
           foreground="#2B91AF" />
    <Color name="BuiltIn"
           foreground="#795E26" />

    <RuleSet ignoreCase="true">
        <Rule color="Comment">'[^\r\n]*</Rule>
        <Rule color="Comment">\bREM\b[^\r\n]*</Rule>
        <Rule color="String">&quot;(&quot;&quot;|[^&quot;\r\n])*&quot;?</Rule>
        <Rule color="Number">\b\d+(\.\d+)?\b</Rule>

        <Keywords color="Keyword">
            <Word>AND</Word>
            <Word>APPEND</Word>
            <Word>AS</Word>
            <Word>BYREF</Word>
            <Word>BYVAL</Word>
            <Word>CASE</Word>
            <Word>CATCH</Word>
            <Word>CLOSE</Word>
            <Word>CONST</Word>
            <Word>DIM</Word>
            <Word>DO</Word>
            <Word>ELSE</Word>
            <Word>ELSEIF</Word>
            <Word>END</Word>
            <Word>ERROR</Word>
            <Word>EQV</Word>
            <Word>ERASE</Word>
            <Word>EXIT</Word>
            <Word>FALSE</Word>
            <Word>FINALLY</Word>
            <Word>FOR</Word>
            <Word>FUNCTION</Word>
            <Word>IF</Word>
            <Word>IMP</Word>
            <Word>INPUT</Word>
            <Word>IS</Word>
            <Word>KEY</Word>
            <Word>LOOP</Word>
            <Word>MOD</Word>
            <Word>MOUSE</Word>
            <Word>NEXT</Word>
            <Word>NOT</Word>
