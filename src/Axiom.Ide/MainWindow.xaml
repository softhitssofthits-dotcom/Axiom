        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Style="{StaticResource StatusBarStyle}"
                   AutomationProperties.AutomationId="ShellStatusBar"
                   Visibility="{Binding StatusBar.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusBar.StatusText}"
                       AutomationProperties.Name="{Binding StatusBar.StatusText}"
                       AutomationProperties.AutomationId="StatusBarTextBlock">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusBar.IsCompilationProgressVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid AutomationProperties.AutomationId="StatusBarCompilationProgressHost">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusBar.IsCompilationProgressVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Height="14"
                             Margin="0,0,8,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding StatusBar.CompilationProgressPercent}"
                             AutomationProperties.AutomationId="StatusBarCompilationProgressBar" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusBar.CompilationProgressText}"
                           Style="{StaticResource StatusBarItemStyle}"
                           AutomationProperties.AutomationId="StatusBarCompilationProgressTextBlock" />
            </Grid>
            <Border Style="{StaticResource StatusBarSeparatorStyle}" />
            <TextBlock Text="{Binding StatusBar.LineColumnText}"
                       Style="{StaticResource StatusBarItemStyle}"
                       AutomationProperties.AutomationId="LineColumnTextBlock" />
            <Border Style="{StaticResource StatusBarSeparatorStyle}" />
            <TextBlock Text="{Binding StatusBar.PathText}"
                       Style="{StaticResource StatusBarPathTextBlockStyle}"
                       AutomationProperties.AutomationId="StatusBarPathTextBlock"
                       ToolTip="{Binding StatusBar.PathText}"
                       MouseLeftButtonDown="OnStatusBarPathTextBlockMouseLeftButtonDown">
                <TextBlock.ContextMenu>
                    <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                 AutomationProperties.AutomationId="StatusBarPathContextMenu">
                        <MenuItem Header="{DynamicResource Menu.Edit.Copy}"
                                  Click="OnStatusBarPathCopyMenuItemClick"
                                  Style="{StaticResource DropDownMenuItemStyle}"
                                  AutomationProperties.AutomationId="StatusBarPathCopyMenuItem">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatusBarSeparatorStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusBar.IsTimingVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <StackPanel Orientation="Horizontal"
                        AutomationProperties.AutomationId="StatusBarTimingHost">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusBar.IsTimingVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding StatusBar.CompilationTimingText}"
                           AutomationProperties.AutomationId="StatusBarTimingTextBlock">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsCompilationTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusBar.PreparationTimingText}"
                           AutomationProperties.AutomationId="StatusBarPreparationTimingTextBlock">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBarSeparatorStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding StatusBar.ExecutionTimingText}"
                           AutomationProperties.AutomationId="StatusBarExecutionTimingTextBlock">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBarSeparatorStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding StatusBar.TotalTimingText}"
                           AutomationProperties.AutomationId="StatusBarTotalTimingTextBlock">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBarSeparatorStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding StatusBar.CacheTimingText}"
                           AutomationProperties.AutomationId="StatusBarCacheTimingTextBlock">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBarSeparatorStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding StatusBar.EngineTimingText}"
                           AutomationProperties.AutomationId="StatusBarEngineTimingTextBlock">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.IsRunTimingVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StatusBar>

        <!-- Main content area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource FilesPaneWidth}" MinWidth="180" MaxWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.BottomPane.IsVisible, RelativeSource={RelativeSource AncestorType=Grid}}" Value="False">
                                    <Setter Property="Height" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="{StaticResource BottomPaneHeight}" />
                            <Setter Property="MinHeight" Value="100" />
                            <Setter Property="MaxHeight" Value="400" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.BottomPane.IsVisible, RelativeSource={RelativeSource AncestorType=Grid}}" Value="False">
                                    <Setter Property="Height" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MaxHeight" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <!-- Files Pane (left) -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource PaneBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    AutomationProperties.AutomationId="FilesPaneBorder"
                    Visibility="{Binding FilesPane.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource ToolbarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseFilesPaneCommand}"
                                    Style="{StaticResource TabCloseButtonStyle}"
                                    AutomationProperties.AutomationId="CloseFilesPaneButton"
                                    ToolTip="{DynamicResource Files.Close}">
                                <TextBlock Style="{StaticResource TabCloseGlyphStyle}" Text="&#xE711;" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Files.Title}"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource ShellFontFamily}"
                                           FontSize="{StaticResource ShellFontSize}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding FilesPane.RootPath}"
                                           ToolTip="{Binding FilesPane.RootPath}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource ShellFontFamily}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TreeView x:Name="FilesTreeView"
                              Style="{StaticResource FilesTreeStyle}"
                              ItemsSource="{Binding FilesPane.Nodes}"
                              AutomationProperties.AutomationId="FilesTreeView"
                              SelectedItemChanged="OnFilesTreeSelectedItemChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource ShellContextMenuStyle}"
                                         AutomationProperties.AutomationId="FilesTreeContextMenu">
                                <MenuItem Command="{Binding NavigateFilesPaneNodeCommand}"
                                          AutomationProperties.AutomationId="FilesTreeNavigateMenuItem">
                                    <MenuItem.Icon>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MenuItemGlyphStyle}">
                                                    <Setter Property="Text" Value="&#xE8A5;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilesPane.SelectedNode.IsDirectory}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8B7;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource DropDownMenuItemStyle}">
                                            <Setter Property="Header" Value="{DynamicResource Files.Context.OpenInIde}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilesPane.SelectedNode.IsDirectory}" Value="True">
                                                    <Setter Property="Header" Value="{DynamicResource Files.Context.Navigate}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.OpenExternal}"
                                          Command="{Binding OpenFilesPaneNodeExternallyCommand}"
                                          AutomationProperties.AutomationId="FilesTreeOpenExternalMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8A7;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.ShowHidden}"
                                          IsCheckable="True"
                                          IsChecked="{Binding FilesPane.ShowHiddenFiles, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="FilesTreeShowHiddenFilesMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE890;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource Files.Context.NewFile}"
                                          Command="{Binding NewFilesPaneFileCommand}"
                                          AutomationProperties.AutomationId="FilesTreeNewFileMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7C3;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.NewDirectory}"
                                          Command="{Binding NewFilesPaneDirectoryCommand}"
                                          AutomationProperties.AutomationId="FilesTreeNewDirectoryMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8B7;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.Cut}"
                                          Command="{Binding CutFilesPaneNodeCommand}"
                                          AutomationProperties.AutomationId="FilesTreeCutMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C6;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.Copy}"
                                          Command="{Binding CopyFilesPaneNodeCommand}"
                                          AutomationProperties.AutomationId="FilesTreeCopyMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.Paste}"
                                          Command="{Binding PasteIntoFilesPaneCommand}"
                                          AutomationProperties.AutomationId="FilesTreePasteMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE77F;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.Rename}"
                                          Command="{Binding RenameFilesPaneNodeCommand}"
                                          AutomationProperties.AutomationId="FilesTreeRenameMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8AC;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Files.Context.Delete}"
                                          Command="{Binding MoveFilesPaneNodeToRecycleBinCommand}"
                                          AutomationProperties.AutomationId="FilesTreeDeleteMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74D;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource Files.Context.Properties}"
                                          Command="{Binding ShowFilesPaneNodePropertiesCommand}"
                                          AutomationProperties.AutomationId="FilesTreePropertiesMenuItem"
                                          Style="{StaticResource DropDownMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE946;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="0,1,0,1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander"
                                                                  Grid.Column="0"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,2,0"
                                                                  Focusable="False"
                                                                  ClickMode="Press"
                                                                  Background="{DynamicResource TreeExpanderBackgroundBrush}"
                                                                  BorderBrush="{DynamicResource TreeExpanderBorderBrush}"
                                                                  BorderThickness="1"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="ExpanderBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <TextBlock x:Name="ExpanderGlyph"
                                                                               Text="+"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TreeExpanderForegroundBrush}"
                                                                               FontFamily="{StaticResource ShellFontFamily}"
                                                                               FontSize="12"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                                        <Setter TargetName="ExpanderBorder" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ExpanderBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                                                        <Setter TargetName="ExpanderBorder" Property="BorderBrush" Value="{DynamicResource ControlPressedBorderBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ExpanderGlyph" Property="Text" Value="-" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <Border x:Name="HeaderBorder"
                                                            Grid.Column="1"
                                                            Background="Transparent"
                                                            CornerRadius="2"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter ContentSource="Header" />
                                                    </Border>
                                                </Grid>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Margin="16,0,0,0"
                                                                Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger SourceName="Expander" Property="IsChecked" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TreeSelectionBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="Expanded" Handler="OnFilesTreeItemExpanded" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnFilesTreeItemPreviewMouseRightButtonDown" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type files:FileTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE7C3;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Text" Value="&#xE8B7;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid Margin="4,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="120"
                                                 Padding="2,0"
                                                 VerticalAlignment="Center"
                                                 Background="{DynamicResource EditorBackgroundBrush}"
                                                 Foreground="{DynamicResource EditorForegroundBrush}"
                                                 CaretBrush="{DynamicResource EditorForegroundBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="1"
                                                 AutomationProperties.AutomationId="FilesTreeRenameTextBox"
                                                 IsVisibleChanged="OnFilesTreeRenameTextBoxIsVisibleChanged"
                                                 LostKeyboardFocus="OnFilesTreeRenameTextBoxLostKeyboardFocus"
                                                 PreviewKeyDown="OnFilesTreeRenameTextBoxPreviewKeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- GridSplitter (horizontal) -->
            <GridSplitter Grid.Row="0" Grid.Column="1"
                          Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Visibility="{Binding FilesPane.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Document Tabs + Editor (center) -->
            <TabControl x:Name="DocumentTabs"
                        Grid.Row="0"
                        ItemsSource="{Binding Documents.Documents}"
                        SelectedItem="{Binding Documents.ActiveDocument}"
                        AutomationProperties.AutomationId="DocumentTabs"
                SelectionChanged="OnDocumentTabsSelectionChanged">
                <TabControl.Style>
                    <Style TargetType="TabControl" BasedOn="{StaticResource DocumentTabControlStyle}">
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilesPane.IsVisible}" Value="False">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ShellTabItemStyle}" />
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource TabCloseButtonStyle}"
                                    ToolTip="{DynamicResource Tabs.Close}">
                                <TextBlock Style="{StaticResource TabCloseGlyphStyle}" Text="&#xE711;" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="*" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           FontWeight="Bold" Margin="2,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Border Padding="0" Background="{DynamicResource EditorBackgroundBrush}">
                            <avalonedit:TextEditor ShowLineNumbers="True"
                                                   Background="{DynamicResource EditorBackgroundBrush}"
                                                   Foreground="{DynamicResource EditorForegroundBrush}"
                                                   LineNumbersForeground="{DynamicResource LineNumberForegroundBrush}"
                                                   IsReadOnly="{Binding IsReadOnly}"
                                                   FontFamily="{StaticResource EditorFontFamily}"
                                                   FontSize="{StaticResource EditorFontSize}"
                                                   Loaded="OnEditorLoaded"
                                                   Unloaded="OnEditorUnloaded"
                                                   GotKeyboardFocus="OnEditorGotKeyboardFocus"
                                                   LostKeyboardFocus="OnEditorLostKeyboardFocus"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   SyntaxHighlighting="{x:Static highlighting:AxiomHighlighting.Definition}"
                                                   VerticalScrollBarVisibility="Auto"
                                                   editor:AvalonEditTextBinding.Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <avalonedit:TextEditor.ContextMenu>
                                    <ContextMenu Style="{StaticResource ShellContextMenuStyle}">
                                        <MenuItem Header="{DynamicResource Menu.Edit.Undo}" Command="ApplicationCommands.Undo" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7A7;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Edit.Redo}" Command="ApplicationCommands.Redo" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7A6;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Menu.Edit.Cut}" Command="ApplicationCommands.Cut" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C6;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Edit.Copy}" Command="ApplicationCommands.Copy" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Edit.Paste}" Command="ApplicationCommands.Paste" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE77F;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Edit.Delete}" Command="ApplicationCommands.Delete" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74D;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Menu.Edit.SelectAll}" Command="ApplicationCommands.SelectAll" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8B3;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Menu.Search.Find}" Command="ApplicationCommands.Find" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE721;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Search.FindNext}" Command="{x:Static search:SearchCommands.FindNext}" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE893;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Search.FindPrevious}" Command="{x:Static search:SearchCommands.FindPrevious}" Style="{StaticResource DropDownMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE892;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Menu.Debug.ToggleBreakpoint}"
                                                  Click="OnToggleCurrentBreakpointMenuItemClick"
                                                  InputGestureText="F9"
                                                  Style="{StaticResource DropDownMenuItemStyle}"
                                                  AutomationProperties.AutomationId="EditorToggleBreakpointMenuItem">
                                            <MenuItem.Icon>
                                                <Grid Width="18"
                                                      Height="16"
                                                      AutomationProperties.AutomationId="EditorToggleBreakpointMenuIcon">
                                                    <Ellipse Width="9"
                                                             Height="9"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource BreakpointMarkerBrush}" />
                                                </Grid>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Menu.Debug.ClearAllBreakpoints}"
                                                  Click="OnClearAllBreakpointsMenuItemClick"
                                                  InputGestureText="Ctrl+Shift+F9"
                                                  Style="{StaticResource DropDownMenuItemStyle}"
                                                  AutomationProperties.AutomationId="EditorClearAllBreakpointsMenuItem">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74D;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </avalonedit:TextEditor.ContextMenu>
                            </avalonedit:TextEditor>
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- GridSplitter (vertical) -->
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Height="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Visibility="{Binding BottomPane.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Bottom Pane: Output / Diagnostics -->
            <TabControl x:Name="BottomPaneTabs"
                        Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        SelectedIndex="{Binding BottomPane.SelectedTabIndex}"
                        SelectionChanged="OnBottomPaneSelectionChanged"
                        Style="{StaticResource DocumentTabControlStyle}"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        AutomationProperties.AutomationId="BottomPaneTabs"
                Visibility="{Binding BottomPane.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ShellTabItemStyle}" />
                </TabControl.ItemContainerStyle>
                <!-- Output Tab -->
                <TabItem Visibility="{Binding BottomPane.IsOutputVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.AutomationId="OutputTabItem">
                    <TabItem.Header>
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseOutputPaneCommand}"
                                    Style="{StaticResource TabCloseButtonStyle}"
                                    AutomationProperties.AutomationId="CloseOutputPaneButton"
                                    ToolTip="{DynamicResource Bottom.CloseOutput}">
                                <TextBlock Style="{StaticResource TabCloseGlyphStyle}" Text="&#xE711;" />
                            </Button>
                            <TextBlock Text="{DynamicResource Bottom.Output}" VerticalAlignment="Center" />
                        </DockPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="OutputTextBox"
                                 Grid.Row="0"
                                 Text="{Binding InputConsole.OutputText, Mode=OneWay}"
                                 AutomationProperties.AutomationId="OutputTextBox"
                                 Style="{StaticResource OutputTextBoxStyle}"
                                 ContextMenuOpening="OnOutputTextBoxContextMenuOpening"
                                 PreviewKeyDown="OnOutputTextBoxPreviewKeyDown"
                                 PreviewKeyUp="OnOutputTextBoxPreviewKeyUp"
                                 LostKeyboardFocus="OnOutputTextBoxLostKeyboardFocus"
                                 PreviewTextInput="OnOutputTextBoxPreviewTextInput"
                                 >
                            <TextBox.ContextMenu>
                                <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                             AutomationProperties.AutomationId="OutputContextMenu">
                                    <MenuItem x:Name="OutputCopyMenuItem"
                                              Header="{DynamicResource Menu.Edit.Copy}"
                                              Click="OnOutputCopyMenuItemClick"
                                              Style="{StaticResource DropDownMenuItemStyle}"
                                              AutomationProperties.AutomationId="OutputCopyMenuItem">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="OutputClearMenuItem"
                                              Header="{DynamicResource Bottom.Output.Clear}"
                                              Click="OnOutputClearMenuItemClick"
                                              Style="{StaticResource DropDownMenuItemStyle}"
                                              AutomationProperties.AutomationId="OutputClearMenuItem">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE894;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Menu.Edit.SelectAll}"
                                              Click="OnOutputSelectAllMenuItemClick"
                                              Style="{StaticResource DropDownMenuItemStyle}"
                                              AutomationProperties.AutomationId="OutputSelectAllMenuItem">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8B3;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <!-- INPUT line -->
                        <Border Grid.Row="1"
                                Padding="4,4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding BottomPane.IsWaitingForInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding BottomPane.CurrentPromptText}"
                                           FontFamily="{StaticResource EditorFontFamily}"
                                           FontSize="{StaticResource EditorFontSize}"
                                           Foreground="{DynamicResource EditorForegroundBrush}"
                                           Margin="0,0,4,0" />
                                <TextBox x:Name="ConsoleInputTextBox"
                                         Text="{Binding BottomPane.CurrentInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ConsoleInputTextBox"
                                         Style="{StaticResource ConsoleInputStyle}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitInputCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Diagnostics Tab -->
                <TabItem Visibility="{Binding BottomPane.IsDiagnosticsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.AutomationId="DiagnosticsTabItem">
                    <TabItem.Header>
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseDiagnosticsPaneCommand}"
                                    Style="{StaticResource TabCloseButtonStyle}"
                                    AutomationProperties.AutomationId="CloseDiagnosticsPaneButton"
                                    ToolTip="{DynamicResource Bottom.CloseDiagnostics}">
                                <TextBlock Style="{StaticResource TabCloseGlyphStyle}" Text="&#xE711;" />
                            </Button>
                            <TextBlock Text="{DynamicResource Bottom.Diagnostics}" VerticalAlignment="Center" />
                        </DockPanel>
                    </TabItem.Header>
                    <DataGrid x:Name="DiagnosticsDataGrid"
                              ItemsSource="{Binding BottomPane.Diagnostics}"
                              SelectedItem="{Binding BottomPane.SelectedDiagnostic}"
                              SelectionChanged="OnDiagnosticsSelectionChanged"
                              MouseDoubleClick="OnDiagnosticsDataGridMouseDoubleClick"
                              AutomationProperties.AutomationId="DiagnosticsDataGrid"
                              Style="{StaticResource DiagnosticsGridStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                         AutomationProperties.AutomationId="DiagnosticsContextMenu">
                                <MenuItem Header="{DynamicResource Menu.Edit.Copy}"
                                          Click="OnDiagnosticsCopyMenuItemClick"
                                          Style="{StaticResource DropDownMenuItemStyle}"
                                          AutomationProperties.AutomationId="DiagnosticsCopyMenuItem">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Diagnostics.Stage}" Binding="{Binding Stage}" Width="100" />
                            <DataGridTextColumn Header="{DynamicResource Diagnostics.Code}" Binding="{Binding Code}" Width="90" />
                            <DataGridTextColumn Header="{DynamicResource Diagnostics.Line}" Binding="{Binding Line}" Width="60" />
                            <DataGridTextColumn Header="{DynamicResource Diagnostics.Column}" Binding="{Binding Column}" Width="70" />
                            <DataGridTextColumn Header="{DynamicResource Diagnostics.Message}" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Grid>

    </DockPanel>
</Window>
