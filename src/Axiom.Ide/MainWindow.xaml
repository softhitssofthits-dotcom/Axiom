<Window x:Class="Axiom.Ide.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:editor="clr-namespace:Axiom.Ide.Editor"
        xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
        xmlns:highlighting="clr-namespace:Axiom.Ide.Editor.Highlighting"
        xmlns:navigation="clr-namespace:Axiom.Ide.Editor.Navigation"
        xmlns:files="clr-namespace:Axiom.Ide.Files"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Icon="/Axiom.Ide;component/Assets/axiom.ico"
        AutomationProperties.AutomationId="MainWindow"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find"
                        CanExecute="OnFindCanExecute"
                        Executed="OnFindExecuted" />
        <CommandBinding Command="{x:Static search:SearchCommands.FindNext}"
                        CanExecute="OnFindCanExecute"
                        Executed="OnFindNextExecuted" />
        <CommandBinding Command="{x:Static search:SearchCommands.FindPrevious}"
                        CanExecute="OnFindCanExecute"
                        Executed="OnFindPreviousExecuted" />
    </Window.CommandBindings>

    <DockPanel LastChildFill="True">
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top"
              Style="{StaticResource MainMenuStyle}"
              AutomationProperties.AutomationId="MainMenu">
            <!-- File -->
            <MenuItem Header="{DynamicResource Menu.File}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="FileMenuItem">
                <MenuItem Header="{DynamicResource Menu.File.New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8A5;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.File.Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8B7;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.File.Recent}"
                          ItemsSource="{Binding RecentFiles}"
                          IsEnabled="{Binding HasRecentFiles}"
                          Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE823;" />
                    </MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource DropDownMenuItemStyle}">
                            <Setter Property="Header" Value="{Binding FileName}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="ToolTip" Value="{Binding FilePath}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.File.Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74E;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.File.SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE792;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.File.SaveAll}" Command="{Binding SaveAllCommand}" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74E;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.File.CloseTab}"
                          Command="{Binding CloseTabCommand}"
                          InputGestureText="Ctrl+W"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="FileCloseTabMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8BB;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.File.Exit}" Command="{Binding ExitCommand}" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8AC;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Edit -->
            <MenuItem Header="{DynamicResource Menu.Edit}" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="{DynamicResource Menu.Edit.Undo}" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7A7;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Edit.Redo}" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7A6;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Edit.Cut}" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C6;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Edit.Copy}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Edit.Paste}" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE77F;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Edit.Delete}" Command="ApplicationCommands.Delete" InputGestureText="Del" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74D;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Edit.SelectAll}" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8B3;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Format -->
            <MenuItem Header="{DynamicResource Menu.Format}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="FormatMenuItem">
                <MenuItem Header="{DynamicResource Menu.Format.Classic}"
                          IsCheckable="True"
                          IsChecked="{Binding IsClassicFormattingEnabled, Mode=OneWay}"
                          Command="{Binding UseClassicFormattingCommand}"
                          Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8D2;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Format.Modern}"
                          IsCheckable="True"
                          IsChecked="{Binding IsModernFormattingEnabled, Mode=OneWay}"
                          Command="{Binding UseModernFormattingCommand}"
                          Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE790;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Format.SmartIdentifier}"
                          IsCheckable="True"
                          IsChecked="{Binding IsSmartIdentifierEnabled, Mode=OneWay}"
                          Command="{Binding ToggleSmartIdentifierCommand}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="FormatSmartIdentifierMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE943;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Search -->
            <MenuItem Header="{DynamicResource Menu.Search}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="SearchMenuItem">
                <MenuItem Header="{DynamicResource Menu.Search.Find}"
                          Command="ApplicationCommands.Find"
                          InputGestureText="Ctrl+F"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="SearchFindMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE721;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Search.FindNext}" Command="{x:Static search:SearchCommands.FindNext}" InputGestureText="F3" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE893;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Search.FindPrevious}" Command="{x:Static search:SearchCommands.FindPrevious}" InputGestureText="Shift+F3" Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE892;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Run -->
            <MenuItem Header="{DynamicResource Menu.Run}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="RunMenuItem">
                <MenuItem Header="{DynamicResource Menu.Run.Compile}"
                          Command="{Binding CompileCommand}"
                          InputGestureText="F6"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="CompileProgramMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7B8;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Run.Run}"
                          Command="{Binding RunCommand}"
                          InputGestureText="Ctrl+F5"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="RunProgramMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Foreground="{DynamicResource RunAccentBrush}" Text="&#xE768;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Run.Cancel}"
                          Command="{Binding CancelRunCommand}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="CancelRunMenuItem" />
            </MenuItem>

            <!-- Debug -->
            <MenuItem Header="{DynamicResource Menu.Debug}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="DebugMenuItem">
                <MenuItem Header="{DynamicResource Menu.Debug.StartDebugging}"
                          Command="{Binding RunOrContinueCommand}"
                          InputGestureText="F5"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="StartDebuggingMenuItem">
                    <MenuItem.Icon>
                        <Viewbox Width="18"
                                 Height="16"
                                 Stretch="Uniform"
                                 AutomationProperties.AutomationId="StartDebuggingMenuIcon">
                            <Canvas Width="16" Height="16">
                                <Path Fill="{DynamicResource RunAccentBrush}"
                                      Data="M6 10V9h9v1H6zm4-4h5v1h-5V6zm5-3v1H6V3h9zm-9 9v1h9v-1H6z" />
                                <Path Fill="{DynamicResource RunAccentBrush}"
                                      Data="M1 2.795l.783-.419 5.371 3.581v.838l-5.371 3.581L1 9.957V2.795zm1.007.94v5.281l3.96-2.64-3.96-2.64z" />
                            </Canvas>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Debug.StepBack}"
                          Command="{Binding StepBackCommand}"
                          InputGestureText="Ctrl+F10"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="StepBackMenuItem">
                    <MenuItem.Icon>
                        <Viewbox Width="18"
                                 Height="16"
                                 Stretch="Uniform"
                                 AutomationProperties.AutomationId="StepBackMenuIcon">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="{x:Null}"
                                      Data="M13 5H6c-2 0-3.5 1.5-3.5 3.5S4 12 6 12h6" />
                                <Path Fill="{DynamicResource RunAccentBrush}"
                                      Data="M6.2 2.8L2 5.2l4.2 2.4V2.8z" />
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      Data="M3 14h10" />
                            </Canvas>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Debug.StepInto}"
                          Command="{Binding StepIntoCommand}"
                          InputGestureText="F11"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="StepIntoMenuItem">
                    <MenuItem.Icon>
                        <Viewbox Width="18"
                                 Height="16"
                                 Stretch="Uniform"
                                 AutomationProperties.AutomationId="StepIntoMenuIcon">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="{x:Null}"
                                      Data="M8 2v8" />
                                <Path Fill="{DynamicResource RunAccentBrush}"
                                      Data="M4.5 7.8L8 12l3.5-4.2H4.5z" />
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      Data="M3 13h10" />
                            </Canvas>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Debug.StepOver}"
                          Command="{Binding StepOverCommand}"
                          InputGestureText="F10"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="StepOverMenuItem">
                    <MenuItem.Icon>
                        <Viewbox Width="18"
                                 Height="16"
                                 Stretch="Uniform"
                                 AutomationProperties.AutomationId="StepOverMenuIcon">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="{x:Null}"
                                      Data="M3 10C3 5.7 7.3 3.2 11 5.1" />
                                <Path Fill="{DynamicResource RunAccentBrush}"
                                      Data="M10.5 2.8L15 5.2l-4.5 2.4V2.8z" />
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      Data="M3 13h10" />
                            </Canvas>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Debug.StepOut}"
                          Command="{Binding StepOutCommand}"
                          InputGestureText="Shift+F11"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="StepOutMenuItem">
                    <MenuItem.Icon>
                        <Viewbox Width="18"
                                 Height="16"
                                 Stretch="Uniform"
                                 AutomationProperties.AutomationId="StepOutMenuIcon">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="{x:Null}"
                                      Data="M8 13V5" />
                                <Path Fill="{DynamicResource RunAccentBrush}"
                                      Data="M4.5 7.2L8 3l3.5 4.2H4.5z" />
                                <Path Stroke="{DynamicResource RunAccentBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      Data="M3 13h10" />
                            </Canvas>
                        </Viewbox>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Debug.StopDebugging}"
                          Command="{Binding StopDebuggingCommand}"
                          InputGestureText="Shift+F5"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="StopDebuggingMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE71A;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Debug.RestartDebugging}"
                          Command="{Binding RestartDebuggingCommand}"
                          InputGestureText="Ctrl+Shift+F5"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="RestartDebuggingMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE72C;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Debug.ToggleBreakpoint}"
                          Click="OnToggleCurrentBreakpointMenuItemClick"
                          InputGestureText="F9"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ToggleBreakpointMenuItem">
                    <MenuItem.Icon>
                        <Grid Width="18"
                              Height="16"
                              AutomationProperties.AutomationId="ToggleBreakpointMenuIcon">
                            <Ellipse Width="9"
                                     Height="9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource BreakpointMarkerBrush}" />
                        </Grid>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Debug.ClearAllBreakpoints}"
                          Command="{Binding ClearAllSourceBreakpointsCommand}"
                          InputGestureText="Ctrl+Shift+F9"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ClearAllBreakpointsMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE74D;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- View -->
            <MenuItem Header="{DynamicResource Menu.View}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="ViewMenuItem">
                <MenuItem Header="{DynamicResource Menu.View.FileManager}"
                          IsCheckable="True"
                          IsChecked="{Binding FilesPane.IsVisible}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ViewFileManagerMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8B7;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.View.Output}"
                          IsCheckable="True"
                          IsChecked="{Binding BottomPane.IsOutputVisible}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ViewOutputMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE756;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.View.Diagnostics}"
                          IsCheckable="True"
                          IsChecked="{Binding BottomPane.IsDiagnosticsVisible}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ViewDiagnosticsMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE9D9;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.View.StatusBar}"
                          IsCheckable="True"
                          IsChecked="{Binding StatusBar.IsVisible}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ViewStatusBarMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE7F4;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.View.EventLog}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ViewEventLogMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE9D5;" />
                    </MenuItem.Icon>
                    <MenuItem Header="{DynamicResource Menu.View.EventLog.Viewer}"
                              Command="{Binding ShowIdeEventLogViewerCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}"
                              AutomationProperties.AutomationId="ViewEventLogViewerMenuItem" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Menu.View.EventLog.OpenFile}"
                              Command="{Binding OpenIdeEventLogFileCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}"
                              AutomationProperties.AutomationId="ViewEventLogOpenFileMenuItem" />
                    <MenuItem Header="{DynamicResource Menu.View.EventLog.OpenFolder}"
                              Command="{Binding OpenIdeEventLogFolderCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}"
                              AutomationProperties.AutomationId="ViewEventLogOpenFolderMenuItem" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Menu.View.EventLog.Clear}"
                              Command="{Binding ClearIdeEventLogsCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}"
                              AutomationProperties.AutomationId="ViewEventLogClearMenuItem" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.View.Theme}"
                          Style="{StaticResource DropDownMenuItemStyle}">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE790;" />
                    </MenuItem.Icon>
                    <MenuItem Header="{DynamicResource Menu.View.Theme.Light}"
                              IsCheckable="True"
                              IsChecked="{Binding IsLightThemeEnabled, Mode=OneWay}"
                              Command="{Binding UseLightThemeCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}" />
                    <MenuItem Header="{DynamicResource Menu.View.Theme.Dark}"
                              IsCheckable="True"
                              IsChecked="{Binding IsDarkThemeEnabled, Mode=OneWay}"
                              Command="{Binding UseDarkThemeCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.View.Language}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="ViewLanguageMenuItem">
                    <MenuItem Header="{DynamicResource Menu.View.Language.Russian}"
                              IsCheckable="True"
                              IsChecked="{Binding IsRussianLanguageEnabled, Mode=OneWay}"
                              Command="{Binding UseRussianLanguageCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}"
                              AutomationProperties.AutomationId="ViewLanguageRussianMenuItem" />
                    <MenuItem Header="{DynamicResource Menu.View.Language.English}"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglishLanguageEnabled, Mode=OneWay}"
                              Command="{Binding UseEnglishLanguageCommand}"
                              Style="{StaticResource DropDownMenuItemStyle}"
                              AutomationProperties.AutomationId="ViewLanguageEnglishMenuItem" />
                </MenuItem>
            </MenuItem>

            <!-- Help -->
            <MenuItem Header="{DynamicResource Menu.Help}"
                      Style="{StaticResource MainMenuItemStyle}"
                      AutomationProperties.AutomationId="HelpMenuItem">
                <MenuItem Header="{DynamicResource Menu.Help.Manual}"
                          Command="{Binding OpenManualCommand}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="HelpOpenManualMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8A5;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Help.About}"
                          Command="{Binding AboutCommand}"
                          Style="{StaticResource DropDownMenuItemStyle}"
                          AutomationProperties.AutomationId="HelpAboutMenuItem">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE946;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Quick access toolbar -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource QuickAccessToolbarBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NewCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.New}">
                    <TextBlock Style="{StaticResource QuickAccessGlyphStyle}" Text="&#xE8A5;" />
                </Button>
                <Button Command="{Binding OpenCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.Open}">
                    <TextBlock Style="{StaticResource QuickAccessGlyphStyle}" Text="&#xE8B7;" />
                </Button>
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.Save}">
                    <TextBlock Style="{StaticResource QuickAccessGlyphStyle}" Text="&#xE74E;" />
                </Button>

                <Rectangle Width="1"
                           Height="20"
                           Margin="6,3"
                           Fill="{DynamicResource BorderBrush}" />

                <Button Command="{Binding CompileCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.Compile}">
                    <TextBlock Style="{StaticResource QuickAccessGlyphStyle}" Text="&#xE7B8;" />
                </Button>

                <Rectangle Width="1"
                           Height="20"
                           Margin="6,3"
                           Fill="{DynamicResource BorderBrush}" />

                <Button Command="{Binding RunCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.Run}">
                    <TextBlock Style="{StaticResource QuickAccessRunGlyphStyle}" Text="&#xE768;" />
                </Button>
                <Button Command="{Binding RunOrContinueCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.StartDebugging}">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform"
                             AutomationProperties.AutomationId="StartDebuggingToolbarIcon">
                        <Canvas Width="16" Height="16">
                            <Path Fill="{DynamicResource RunAccentBrush}"
                                  Data="M6 10V9h9v1H6zm4-4h5v1h-5V6zm5-3v1H6V3h9zm-9 9v1h9v-1H6z" />
                            <Path Fill="{DynamicResource RunAccentBrush}"
                                  Data="M1 2.795l.783-.419 5.371 3.581v.838l-5.371 3.581L1 9.957V2.795zm1.007.94v5.281l3.96-2.64-3.96-2.64z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Command="{Binding StepBackCommand}"
                        Style="{StaticResource QuickAccessButtonStyle}"
                        ToolTip="{DynamicResource Toolbar.StepBack}">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform"
