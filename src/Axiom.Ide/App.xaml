<Application x:Class="Axiom.Ide.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Legacy shared resources for backward compatibility -->
                <ResourceDictionary Source="Resources/ShellResources.xaml" />
                <!-- Colors and brushes -->
                <ResourceDictionary Source="Resources/ShellColors.xaml" />
                <!-- Localized shell strings -->
                <ResourceDictionary Source="Resources/ShellStrings.ru.xaml" />
                <!-- Styles for controls -->
                <ResourceDictionary Source="Resources/ShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
