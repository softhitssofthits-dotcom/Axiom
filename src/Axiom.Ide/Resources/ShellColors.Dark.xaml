<!-- Colors and brushes for the dark IDE shell theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#1E1E1E</Color>
    <Color x:Key="EditorBackgroundColor">#1E1E1E</Color>
    <Color x:Key="EditorForegroundColor">#D4D4D4</Color>
    <Color x:Key="EditorCaretColor">#FFFFFF</Color>
    <Color x:Key="PaneBackgroundColor">#252526</Color>
    <Color x:Key="BorderColor">#3F4349</Color>
    <Color x:Key="MenuBackgroundColor">#2D2D30</Color>
    <Color x:Key="ToolbarBackgroundColor">#252526</Color>
    <Color x:Key="StatusBarBackgroundColor">#007ACC</Color>
    <Color x:Key="StatusBarForegroundColor">#FFFFFF</Color>
    <Color x:Key="TabBackgroundColor">#2D2D30</Color>
    <Color x:Key="SelectedTabColor">#1E1E1E</Color>
    <Color x:Key="AccentColor">#3794FF</Color>
    <Color x:Key="RunAccentColor">#89D185</Color>
    <Color x:Key="TextPrimaryColor">#D4D4D4</Color>
    <Color x:Key="TextSecondaryColor">#A6A6A6</Color>
    <Color x:Key="OutputBackgroundColor">#252526</Color>
    <Color x:Key="ControlHoverColor">#33373D</Color>
    <Color x:Key="ControlPressedColor">#3C4148</Color>
    <Color x:Key="ControlHoverBorderColor">#565B63</Color>
    <Color x:Key="ControlPressedBorderColor">#6B727C</Color>
    <Color x:Key="MenuHighlightColor">#3A3D41</Color>
    <Color x:Key="MenuHighlightBorderColor">#5C646E</Color>
    <Color x:Key="MenuDisabledTextColor">#7A7A7A</Color>
    <Color x:Key="MenuIconColor">#B8BDC5</Color>
    <Color x:Key="MenuSeparatorColor">#4A4F55</Color>
    <Color x:Key="StatusBarSelectionColor">#10304B</Color>
    <Color x:Key="StatusBarSelectionForegroundColor">#F4FAFF</Color>
    <Color x:Key="StatusBarSelectionInactiveColor">#21425D</Color>
    <Color x:Key="StatusBarSelectionInactiveForegroundColor">#D7E9F8</Color>
    <Color x:Key="TabHoverColor">#34373C</Color>
    <Color x:Key="TreeSelectionColor">#094771</Color>
    <Color x:Key="TreeExpanderBackgroundColor">#2D2D30</Color>
    <Color x:Key="TreeExpanderBorderColor">#7A7D82</Color>
    <Color x:Key="TreeExpanderForegroundColor">#F3F3F3</Color>
    <Color x:Key="DiagnosticErrorColor">#F48771</Color>
    <Color x:Key="DiagnosticWarningColor">#CCA700</Color>
    <Color x:Key="EditorCurrentLineHighlightColor">#242A31</Color>
    <Color x:Key="EditorCurrentLineBorderColor">#3A434F</Color>
    <Color x:Key="DiagnosticLineHighlightColor">#332B1F</Color>
    <Color x:Key="DiagnosticLineBorderColor">#8A6B3C</Color>
    <Color x:Key="BreakpointMarkerColor">#F14C4C</Color>
    <Color x:Key="StoppedRunLineHighlightColor">#3A2326</Color>
    <Color x:Key="StoppedRunLineBorderColor">#F14C4C</Color>
    <Color x:Key="StoppedRunExecutionSpanColor">#88F14C4C</Color>
    <Color x:Key="StoppedRunExecutionSpanBorderColor">#FF9A9E</Color>
    <Color x:Key="DiagnosticsSelectionColor">#094771</Color>
    <Color x:Key="DiagnosticsSelectionForegroundColor">#FFFFFF</Color>
    <Color x:Key="LineNumberForegroundColor">#858585</Color>
    <Color x:Key="ScrollBarTrackColor">#F1F1F1</Color>
    <Color x:Key="ScrollBarThumbColor">#C2C2C2</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#A8A8A8</Color>
    <Color x:Key="ScrollBarThumbPressedColor">#909090</Color>
    <Color x:Key="ScrollBarThumbBorderColor">#8A8A8A</Color>
    <Color x:Key="ScrollBarButtonColor">#F1F1F1</Color>
    <Color x:Key="ScrollBarButtonHoverColor">#E6E6E6</Color>
    <Color x:Key="ScrollBarButtonPressedColor">#D6D6D6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource EditorForegroundColor}" />
    <SolidColorBrush x:Key="EditorCaretBrush" Color="{StaticResource EditorCaretColor}" />
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{StaticResource PaneBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="{StaticResource ToolbarBackgroundColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{StaticResource StatusBarForegroundColor}" />
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="{StaticResource TabBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedTabBrush" Color="{StaticResource SelectedTabColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RunAccentBrush" Color="{StaticResource RunAccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="OutputBackgroundBrush" Color="{StaticResource OutputBackgroundColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="{StaticResource ControlHoverBorderColor}" />
    <SolidColorBrush x:Key="ControlPressedBorderBrush" Color="{StaticResource ControlPressedBorderColor}" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="{StaticResource MenuHighlightColor}" />
    <SolidColorBrush x:Key="MenuHighlightBorderBrush" Color="{StaticResource MenuHighlightBorderColor}" />
    <SolidColorBrush x:Key="MenuDisabledTextBrush" Color="{StaticResource MenuDisabledTextColor}" />
    <SolidColorBrush x:Key="MenuIconBrush" Color="{StaticResource MenuIconColor}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{StaticResource MenuSeparatorColor}" />
    <SolidColorBrush x:Key="StatusBarSelectionBrush" Color="{StaticResource StatusBarSelectionColor}" />
    <SolidColorBrush x:Key="StatusBarSelectionForegroundBrush" Color="{StaticResource StatusBarSelectionForegroundColor}" />
    <SolidColorBrush x:Key="StatusBarSelectionInactiveBrush" Color="{StaticResource StatusBarSelectionInactiveColor}" />
    <SolidColorBrush x:Key="StatusBarSelectionInactiveForegroundBrush" Color="{StaticResource StatusBarSelectionInactiveForegroundColor}" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="{StaticResource TabHoverColor}" />
    <SolidColorBrush x:Key="TreeSelectionBrush" Color="{StaticResource TreeSelectionColor}" />
    <SolidColorBrush x:Key="TreeExpanderBackgroundBrush" Color="{StaticResource TreeExpanderBackgroundColor}" />
    <SolidColorBrush x:Key="TreeExpanderBorderBrush" Color="{StaticResource TreeExpanderBorderColor}" />
    <SolidColorBrush x:Key="TreeExpanderForegroundBrush" Color="{StaticResource TreeExpanderForegroundColor}" />
    <SolidColorBrush x:Key="DiagnosticErrorBrush" Color="{StaticResource DiagnosticErrorColor}" />
    <SolidColorBrush x:Key="DiagnosticWarningBrush" Color="{StaticResource DiagnosticWarningColor}" />
    <SolidColorBrush x:Key="EditorCurrentLineHighlightBrush" Color="{StaticResource EditorCurrentLineHighlightColor}" />
    <SolidColorBrush x:Key="EditorCurrentLineBorderBrush" Color="{StaticResource EditorCurrentLineBorderColor}" />
    <SolidColorBrush x:Key="DiagnosticLineHighlightBrush" Color="{StaticResource DiagnosticLineHighlightColor}" />
    <SolidColorBrush x:Key="DiagnosticLineBorderBrush" Color="{StaticResource DiagnosticLineBorderColor}" />
    <SolidColorBrush x:Key="BreakpointMarkerBrush" Color="{StaticResource BreakpointMarkerColor}" />
    <SolidColorBrush x:Key="StoppedRunLineHighlightBrush" Color="{StaticResource StoppedRunLineHighlightColor}" />
    <SolidColorBrush x:Key="StoppedRunLineBorderBrush" Color="{StaticResource StoppedRunLineBorderColor}" />
    <SolidColorBrush x:Key="StoppedRunExecutionSpanBrush" Color="{StaticResource StoppedRunExecutionSpanColor}" />
    <SolidColorBrush x:Key="StoppedRunExecutionSpanBorderBrush" Color="{StaticResource StoppedRunExecutionSpanBorderColor}" />
    <SolidColorBrush x:Key="DiagnosticsSelectionBrush" Color="{StaticResource DiagnosticsSelectionColor}" />
    <SolidColorBrush x:Key="DiagnosticsSelectionForegroundBrush" Color="{StaticResource DiagnosticsSelectionForegroundColor}" />
    <SolidColorBrush x:Key="LineNumberMarginBackgroundBrush" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="LineNumberForegroundBrush" Color="{StaticResource LineNumberForegroundColor}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ScrollBarTrackColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource ScrollBarThumbPressedColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="{StaticResource ScrollBarThumbBorderColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonBrush" Color="{StaticResource ScrollBarButtonColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonHoverBrush" Color="{StaticResource ScrollBarButtonHoverColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonPressedBrush" Color="{StaticResource ScrollBarButtonPressedColor}" />
    <Pen x:Key="EditorCurrentLineBorderPen"
         Brush="{StaticResource EditorCurrentLineBorderBrush}"
         Thickness="1" />
    <Pen x:Key="DiagnosticLineBorderPen"
         Brush="{StaticResource DiagnosticLineBorderBrush}"
         Thickness="1" />
    <Pen x:Key="StoppedRunLineBorderPen"
         Brush="{StaticResource StoppedRunLineBorderBrush}"
         Thickness="1" />
    <Pen x:Key="StoppedRunExecutionSpanBorderPen"
         Brush="{StaticResource StoppedRunExecutionSpanBorderBrush}"
         Thickness="1" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource PaneBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource PaneBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#383C42" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#454A52" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#26292E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#181A1D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource MenuBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3A3D41" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource TreeSelectionColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3D41" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#808080" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="{StaticResource PaneBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />

    <Thickness x:Key="ShellMargin">0</Thickness>
    <Thickness x:Key="ToolbarBottomMargin">0,0,0,2</Thickness>
    <Thickness x:Key="SectionSideMargin">4,0,4,0</Thickness>
    <Thickness x:Key="SectionTopMargin">0,4,0,0</Thickness>
    <Thickness x:Key="MenuItemMargin">8,4</Thickness>
    <Thickness x:Key="StatusTextMargin">12,0,0,0</Thickness>

    <FontFamily x:Key="ShellFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="EditorFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>

    <system:Double x:Key="EditorFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="ShellFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="MenuFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="StatusFontSize" xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>
    <system:Double x:Key="LineNumberMarginMinWidth" xmlns:system="clr-namespace:System;assembly=mscorlib">52</system:Double>

    <GridLength x:Key="FilesPaneWidth">240</GridLength>
    <GridLength x:Key="BottomPaneHeight">220</GridLength>

</ResourceDictionary>
