<Window x:Class="Axiom.Ide.Services.Prompts.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Prompts.DefaultTitle}"
        Width="420"
        MinWidth="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="TextInputDialog"
        Style="{StaticResource DialogWindowStyle}">
    <Border Margin="12"
            Padding="4"
            Background="{DynamicResource PaneBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptTextBlock"
                       AutomationProperties.AutomationId="TextInputPromptTextBlock"
                       Style="{StaticResource DialogTextBlockStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBox x:Name="InputTextBox"
                     Grid.Row="1"
                     AutomationProperties.AutomationId="TextInputTextBox"
                     Style="{StaticResource DialogTextBoxStyle}"
                     MinWidth="320"
                     Margin="0,0,0,16" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Width="88"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        AutomationProperties.AutomationId="TextInputOkButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="OnOkClick"
                        Content="{DynamicResource Prompts.Ok}" />
                <Button Width="88"
                        AutomationProperties.AutomationId="TextInputCancelButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="{DynamicResource TextInput.Cancel}"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
