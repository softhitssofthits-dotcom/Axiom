<Window x:Class="Axiom.Ide.Services.EventLog.IdeEventLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        MinWidth="920"
        MinHeight="520"
        Width="1080"
        Height="720"
        ShowInTaskbar="False"
        Style="{StaticResource DialogWindowStyle}"
        AutomationProperties.AutomationId="IdeEventLogViewerWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="180" MinHeight="80" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{DynamicResource EventLog.Viewer.SearchLabel}" />
        <TextBox x:Name="SearchTextBox"
                 Grid.Row="0"
                 Grid.Column="2"
                 MinWidth="320"
                 Style="{StaticResource FindReplaceTextBoxStyle}"
                 AutomationProperties.AutomationId="IdeEventLogViewerSearchTextBox"
                 TextChanged="OnSearchTextChanged" />
        <TextBlock Grid.Row="0"
                   Grid.Column="4"
                   VerticalAlignment="Center"
                   Text="{DynamicResource EventLog.Viewer.CategoryLabel}" />
        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="0"
                  Grid.Column="6"
                  Style="{StaticResource DialogComboBoxStyle}"
                  AutomationProperties.AutomationId="IdeEventLogViewerCategoryComboBox"
                  SelectionChanged="OnCategoryChanged" />
        <Button Grid.Row="0"
                Grid.Column="8"
                MinWidth="95"
                Padding="12,4"
                Style="{StaticResource DialogButtonStyle}"
                Click="OnRefreshClick"
                Content="{DynamicResource EventLog.Viewer.RefreshButton}"
                AutomationProperties.AutomationId="IdeEventLogViewerRefreshButton" />
        <Button Grid.Row="0"
                Grid.Column="10"
                MinWidth="110"
                Padding="12,4"
                Style="{StaticResource DialogButtonStyle}"
                Click="OnCopySelectedClick"
                Content="{DynamicResource EventLog.Viewer.CopySelectedButton}"
                AutomationProperties.AutomationId="IdeEventLogViewerCopySelectedButton" />

        <TextBlock x:Name="FilePathTextBlock"
                   Grid.Row="2"
                   Grid.ColumnSpan="11"
                   TextTrimming="CharacterEllipsis"
                   FontFamily="Consolas"
                   Opacity="0.85"
                   AutomationProperties.AutomationId="IdeEventLogViewerFilePathText" />

        <DataGrid x:Name="EntriesDataGrid"
                  Grid.Row="4"
                  Grid.ColumnSpan="11"
                  Style="{StaticResource DiagnosticsGridStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionChanged="OnEntrySelectionChanged"
                  PreviewMouseRightButtonDown="OnEntriesDataGridPreviewMouseRightButtonDown"
                  AutomationProperties.AutomationId="IdeEventLogViewerDataGrid">
            <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource ShellContextMenuStyle}">
                    <MenuItem Header="{DynamicResource EventLog.Viewer.CopyCellMenuItem}"
                              Click="OnCopyCellClick"
                              Style="{StaticResource DropDownMenuItemStyle}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource EventLog.Viewer.CopySelectedMenuItem}"
                              Click="OnCopySelectedClick"
                              Style="{StaticResource DropDownMenuItemStyle}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource EventLog.Viewer.CopyDetailsMenuItem}"
                              Click="OnCopyDetailsClick"
                              Style="{StaticResource DropDownMenuItemStyle}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="SequenceColumn"
                                    Header="Seq"
                                    Binding="{Binding Sequence}"
                                    Width="80" />
                <DataGridTextColumn x:Name="TimeColumn"
                                    Header="{DynamicResource EventLog.Viewer.TimeHeader}"
                                    Binding="{Binding TimestampLocalText}"
                                    Width="180" />
                <DataGridTextColumn x:Name="LevelColumn"
                                    Header="{DynamicResource EventLog.Viewer.LevelHeader}"
                                    Binding="{Binding Level}"
                                    Width="90" />
                <DataGridTextColumn x:Name="CategoryColumn"
                                    Header="{DynamicResource EventLog.Viewer.CategoryHeader}"
                                    Binding="{Binding Category}"
                                    Width="120" />
                <DataGridTextColumn x:Name="EventColumn"
                                    Header="{DynamicResource EventLog.Viewer.EventHeader}"
                                    Binding="{Binding EventName}"
                                    Width="200" />
                <DataGridTextColumn x:Name="CommandColumn"
                                    Header="{DynamicResource EventLog.Viewer.CommandHeader}"
                                    Binding="{Binding CommandName}"
                                    Width="140" />
                <DataGridTextColumn x:Name="DocumentColumn"
                                    Header="{DynamicResource EventLog.Viewer.DocumentHeader}"
                                    Binding="{Binding DocumentName}"
                                    Width="180" />
                <DataGridTextColumn x:Name="DetailsColumn"
                                    Header="{DynamicResource EventLog.Viewer.DetailsHeader}"
                                    Binding="{Binding Details}"
                                    Width="360" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="5"
                      Grid.ColumnSpan="11"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Background="{DynamicResource SectionBorderBrush}"
                      AutomationProperties.AutomationId="IdeEventLogViewerDetailsGridSplitter" />

        <Grid Grid.Row="6"
              Grid.ColumnSpan="11"
              AutomationProperties.AutomationId="IdeEventLogViewerDetailsPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource EventLog.Viewer.SelectedDetailsLabel}" />
            <TextBox x:Name="SelectedDetailsTextBox"
                     Grid.Row="2"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     AutomationProperties.AutomationId="IdeEventLogViewerSelectedDetailsTextBox">
                <TextBox.ContextMenu>
                    <ContextMenu Style="{StaticResource ShellContextMenuStyle}">
                        <MenuItem Header="{DynamicResource EventLog.Viewer.CopyDetailsMenuItem}"
                                  Click="OnCopyDetailsClick"
                                  Style="{StaticResource DropDownMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource EventLog.Viewer.CopySelectedMenuItem}"
                                  Click="OnCopySelectedClick"
                                  Style="{StaticResource DropDownMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuItemGlyphStyle}" Text="&#xE8C8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </Grid>

        <DockPanel Grid.Row="8"
                   Grid.ColumnSpan="11">
            <TextBlock x:Name="CountTextBlock"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="IdeEventLogViewerCountText" />
            <Button DockPanel.Dock="Right"
                    MinWidth="90"
                    Padding="12,5"
                    Margin="12,0,0,0"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="OnCloseClick"
                    Content="{DynamicResource EventLog.Viewer.CloseButton}"
                    AutomationProperties.AutomationId="IdeEventLogViewerCloseButton" />
        </DockPanel>
    </Grid>
</Window>
