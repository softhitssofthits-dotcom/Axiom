' Спецификаторы формата в интерполированных строках
' Синтаксис: {выражение:формат} или {выражение,выравнивание} или {выражение,выравнивание:формат}

DIM price AS DOUBLE = 1234.5
DIM code AS INTEGER = 42
DIM ratio AS DOUBLE = 0.856
DIM name AS STRING = "Алиса"
DIM big AS INTEGER = 1234567

' Фиксированная точка: F2 = два знака после запятой
PRINT $"Цена: {price:F2}"

' Целое с ведущими нулями: D5 = минимум 5 цифр
PRINT $"Код: {code:D5}"

' Процент: P1 = умножить на 100, один знак, добавить %
PRINT $"Доля: {ratio:P1}"

' Разделитель тысяч: N0 = целое с разделителем тысяч
PRINT $"Большое число: {big:N0}"

' Научная запись: E3 = три знака после запятой в мантиссе
' 0.856 = 8.56 × 10^(-1) → "8.560E-001"
PRINT $"Научная запись: {ratio:E3}"

' Шестнадцатеричное: X = верхний регистр
PRINT $"Hex: {code:X}"

' Выравнивание вправо: 20 символов
PRINT $"Имя вправо: |{name, 10}|"

' Выравнивание влево: -20 символов
PRINT $"Имя влево: |{name, -20}|"

' Комбинация выравнивания и формата: 12 символов, два знака
PRINT $"Цена выровненная: |{price, 12:F2}|"

' Выражения внутри формата
DIM a AS INTEGER = 10
DIM b AS INTEGER = 3
PRINT $"Сумма: {a + b:D4}"
PRINT $"Частное: {a / b:F4}"
