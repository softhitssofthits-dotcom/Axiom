' Интерполяция строк — подстановка выражений внутри $"..."
' Результат: значения автоматически преобразуются в строку

DIM name AS STRING = "Алиса"
DIM age AS INTEGER = 25
DIM score AS DOUBLE = 98.5
DIM active AS BOOLEAN = TRUE

' Простая интерполяция
PRINT $"Привет, {name}!"

' Несколько выражений
PRINT $"{name}, {age} лет, {score} баллов"

' Выражения внутри {}
PRINT $"Сумма: {age + 1}"

' Автоматическое преобразование типов
PRINT $"Студент: {name}, Активен: {active}"

' Смешивание с обычным текстом
PRINT $"Результат: {score / 10 * 100}%"
