' Проверка LONG-массива: копирование, вставка, удаление и сохранение границ.
DIM a[-2 TO 2] AS LONG
DIM saved[] AS LONG
' Заполняем числами вне кэша малых значений.
FOR i = -2 TO 2
    a[i] = i + 10000
NEXT
' Вставляем число, затем удаляем другой элемент со сдвигом.
ARRAYINSERT(a[], 0, CLNG(77777))
PRINT ARRAYREMOVE(a[], -1)
PRINT a[-1]
' Сохраняем прежние данные при расширении: новый элемент равен нулю.
REDIM PRESERVE a[-2 TO 3]
PRINT a[3]
' Сохранённая копия должна остаться независимой.
saved[] = a[]
a[-2] = 42
PRINT saved[-2]
PRINT a[-2]
PRINT UBOUND(a[])
