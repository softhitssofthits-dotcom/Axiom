' Ручная проверка автоматического дополнения блоков и отступов в редакторе IDE.
' Как проверять:
' 1. Откройте этот файл в Axiom IDE или вводите его построчно в новом документе.
' 2. Проверьте клавишу Enter, повторные ElseIf, Case и Case Else, вложенные If и
'    Select Case, а также блоки For, While, Do ... Loop, Sub и Function.

DIM source AS INTEGER = 2
DIM result AS INTEGER = EvaluateScenario(source)

IF result > 0 THEN
    SELECT CASE result
        CASE 1
            FOR outer = 1 TO 2
                IF outer = 1 THEN
                    DO
                        PRINT "блок 1: цикл DO"
                        EXIT DO
                    LOOP
                ELSEIF outer = 2 THEN
                    WHILE source < 4
                        source = source + 1
                        PRINT "блок 1: цикл WHILE"; source
                    END WHILE
                ELSE
                    PRINT "иначе в блоке 1"
                END IF
            NEXT
        CASE 2
            IF source = 2 THEN
                SELECT CASE source + 1
                    CASE 3
                        PRINT "вложенный SELECT CASE"
                    CASE ELSE
                        PRINT "вложенный CASE ELSE"
                END SELECT
            ELSEIF source = 3 THEN
                PRINT "иначе если: блок 2"
            ELSE
                PRINT "иначе: блок 2"
            END IF
        CASE ELSE
            ShowSummary(result)
    END SELECT
ELSEIF result = 0 THEN
    FOR retry = 1 TO 2
        IF retry = 1 THEN
            PRINT "повтор: шаг 1"
        ELSEIF retry = 2 THEN
            PRINT "повтор: шаг 2"
        ELSE
            PRINT "иначе при повторе"
        END IF
    NEXT
ELSE
    DO WHILE source > 0
        source = source - 1
        PRINT "резервный путь"; source
    LOOP
END IF

ExerciseLoops(0)
ShowSummary(result)
PRINT AdjustValue(result)

SUB ExerciseLoops(seed AS INTEGER)
    DIM counter AS INTEGER = seed

    DO WHILE counter < 2
        counter = counter + 1
        IF counter = 1 THEN
            PRINT "цикл DO WHILE"; counter
        ELSE
            PRINT "иначе в DO WHILE"; counter
        END IF
    LOOP

    DO UNTIL counter = 4
        counter = counter + 1
        SELECT CASE counter
            CASE 3
                PRINT "ветвь DO UNTIL"; counter
            CASE ELSE
                PRINT "иначе в DO UNTIL"; counter
        END SELECT
    LOOP

    DO
        counter = counter - 1
        IF counter > 1 THEN
            PRINT "цикл LOOP WHILE"; counter
        ELSE
            PRINT "последний шаг LOOP WHILE"; counter
        END IF
    LOOP WHILE counter > 1

    DO
        counter = counter + 1
        IF counter = 2 THEN
            PRINT "цикл LOOP UNTIL"; counter
        ELSE
            PRINT "последний шаг LOOP UNTIL"; counter
        END IF
    LOOP UNTIL counter = 3
END SUB

SUB ShowSummary(value AS INTEGER)
    IF value > 10 THEN
        PRINT "большое значение"
    ELSEIF value > 5 THEN
        PRINT "среднее значение"
    ELSE
        PRINT "малое значение"
    END IF
END SUB

FUNCTION EvaluateScenario(value AS INTEGER) AS INTEGER
    IF value = 1 THEN
        RETURN 1
    ELSEIF value = 2 THEN
        RETURN 2
    ELSE
        RETURN 0
    END IF
END FUNCTION

FUNCTION AdjustValue(value AS INTEGER) AS INTEGER
    SELECT CASE value
        CASE 0
            RETURN 10
        CASE 1
            RETURN 20
        CASE ELSE
            RETURN 30
    END SELECT
END FUNCTION
