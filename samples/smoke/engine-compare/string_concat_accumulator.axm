' Проверка горячего сценария накопления строк через & и строковый +.
' Ожидаемый вывод: три строки с длинами и контрольными фрагментами.

FUNCTION Piece(index AS INTEGER) AS STRING
    IF index MOD 2 = 0 THEN
        RETURN "R"
    END IF

    RETURN "L"
END FUNCTION

DIM textAmp AS STRING = ""
DIM textPlus AS STRING = ""
DIM textFunction AS STRING = ""

FOR i = 1 TO 3000
    textAmp = textAmp & i
    textAmp = textAmp & ":"
    textPlus = textPlus + "x"
    textFunction = textFunction & Piece(i)
NEXT

PRINT LEN(textAmp)
PRINT LEFT(textPlus, 5) & ":" & LEN(textPlus)
PRINT LEFT(textFunction, 6) & ":" & LEN(textFunction)
