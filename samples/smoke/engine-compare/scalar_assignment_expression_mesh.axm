' Сравнительный сценарий: скалярные выражения и присваивания.
' Нагружает локальные и глобальные присваивания, арифметику, побитовые операции,
' сдвиги и сравнения, почти не опираясь на встроенные функции.

DIM globalCounter AS LONG = 0
DIM globalMask AS INTEGER = 0
DIM globalText AS STRING = ""
DIM globalFlag AS BOOLEAN = FALSE

DIM integerChecksum AS LONG = 0
DIM longChecksum AS LONG = 0
DIM doubleChecksum AS DOUBLE = 0
DIM compareChecksum AS LONG = 0

FOR outerIndex = 1 TO 320
    DIM localInt AS INTEGER = outerIndex
    DIM localLong AS LONG = outerIndex * 1000
    DIM localDouble AS DOUBLE = outerIndex / 9.0
    DIM localText AS STRING = "R" + STR(outerIndex)
    DIM localFlag AS BOOLEAN = outerIndex MOD 2 = 0

    FOR innerIndex = 1 TO 18
        localInt = ((localInt + innerIndex) XOR (outerIndex AND 15)) + (innerIndex MOD 5)
        localInt = localInt - ((outerIndex MOD 7) << 1)
        localInt = localInt + ((innerIndex AND 3) << 2)

        localLong = localLong + localInt
        localLong = localLong - (outerIndex MOD 9)
        localLong = localLong + (innerIndex << 3)

        localDouble = localDouble + localInt / 7.0
        localDouble = localDouble - innerIndex / 13.0
        localDouble = localDouble * 1.0005

        localFlag = (localInt MOD 2 = 0) AND NOT (innerIndex MOD 4 = 0)

        IF localInt > outerIndex THEN
            compareChecksum = compareChecksum + 3
        ELSEIF localInt = outerIndex THEN
            compareChecksum = compareChecksum + 2
        ELSE
            compareChecksum = compareChecksum + 1
        END IF

        IF localLong >= globalCounter THEN
            globalCounter = globalCounter + (localLong MOD 97)
        ELSE
            globalCounter = globalCounter - (localLong MOD 31)
        END IF

        globalMask = globalMask XOR ((localInt AND 255) << (innerIndex MOD 3))

        IF localFlag THEN
            globalFlag = NOT globalFlag
        END IF
    NEXT

    globalText = localText
    integerChecksum = integerChecksum + localInt
    longChecksum = longChecksum + localLong
    doubleChecksum = doubleChecksum + localDouble
NEXT

PRINT integerChecksum
PRINT longChecksum
PRINT INT(doubleChecksum)
PRINT compareChecksum + globalCounter
PRINT globalMask
PRINT globalText
PRINT globalFlag
