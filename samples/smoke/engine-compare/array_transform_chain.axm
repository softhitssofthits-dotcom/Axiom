' Сравнительный сценарий: преобразования массивов + плотные циклы.
' Программа строит двумерную матрицу, затем прогоняет цепочку ARRAYFLATTEN/ARRAYTOSORTED/ARRAYRESHAPE/ARRAYTAKE/ARRAYSKIP/ARRAYCONCAT.

DIM board(1 TO 24, 1 TO 24) AS INTEGER
DIM flat() AS INTEGER
DIM sorted() AS INTEGER
DIM reshaped(,) AS INTEGER
DIM topRows(,) AS INTEGER
DIM bottomRows(,) AS INTEGER
DIM merged(,) AS INTEGER
DIM total AS LONG = 0

FOR rowIndex = 1 TO 24
    FOR columnIndex = 1 TO 24
        board(rowIndex, columnIndex) = rowIndex * 100 + (25 - columnIndex)
    NEXT
NEXT

flat = ARRAYFLATTEN(board)
sorted = ARRAYTOSORTED(flat)
reshaped = ARRAYRESHAPE(sorted, board)
topRows = ARRAYTAKE(reshaped, 12, ROW)
bottomRows = ARRAYSKIP(reshaped, 12, ROW)
merged = ARRAYCONCAT(topRows, bottomRows, ROW)

FOR rowIndex = 1 TO 24
    FOR columnIndex = 1 TO 24
        total = total + merged(rowIndex, columnIndex)
    NEXT
NEXT

PRINT ARRAYRANK(merged)
PRINT LBOUND(merged, ROW)
PRINT UBOUND(merged, COLUMN)
PRINT merged(1, 1)
PRINT merged(12, 24)
PRINT merged(24, 24)
PRINT total
