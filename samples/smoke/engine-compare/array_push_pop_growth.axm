' Нагрузка: рост и сокращение одномерного массива через ARRAYPUSH и ARRAYPOP.
DIM values[] AS INTEGER
REDIM values[1 TO 0]
DIM checksum AS LONG = 0

FOR roundIndex = 1 TO 12
    FOR itemIndex = 1 TO 1500
        ARRAYPUSH(values[], (roundIndex * 7 + itemIndex * 3) MOD 101)
    NEXT
    FOR itemIndex = 1 TO 500
        checksum = checksum + ARRAYPOP(values[])
    NEXT
NEXT

FOR itemIndex = 1 TO ARRAYLENGTH(values[])
    checksum = checksum + values[itemIndex]
NEXT

PRINT checksum
