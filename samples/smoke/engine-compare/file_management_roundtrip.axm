' Сравнительный сценарий: управление файлами и каталогами.
' Нагружает MAKEDIR, COPYFILE, MOVEFILE, RENAMEFILE, DELETEFILE,
' COPYDIR, MOVEDIR, RENAMEDIR, DELETEDIRRECURSIVE, CHANGEDIR и CURRENTDIR.

DIM scenarioRoot AS STRING = MAKETEMPDIR("file-management-roundtrip_")
DIM sourceRoot AS STRING = COMBINEPATH(scenarioRoot, "source")
DIM passCopyRoot AS STRING = COMBINEPATH(scenarioRoot, "copy")
DIM passMovedRoot AS STRING = COMBINEPATH(scenarioRoot, "moved")
DIM passRenamedRoot AS STRING = COMBINEPATH(scenarioRoot, "renamed")
DIM originalDir AS STRING = CURRENTDIR()
DIM checksum AS LONG = 0
DIM sourcePayload AS STRING = "managed-source-content"
DIM tempPayload AS STRING = "managed-temp-content"
DIM tempFile AS STRING = COMBINEPATH(sourceRoot, "temp.txt")
DIM copiedFile AS STRING = COMBINEPATH(sourceRoot, "temp_copy.txt")
DIM movedFile AS STRING = COMBINEPATH(sourceRoot, "temp_moved.txt")
DIM renamedFile AS STRING = COMBINEPATH(sourceRoot, "temp_renamed.txt")
DIM renamedFileName AS STRING = "temp_renamed.txt"
DIM renamedDirName AS STRING = "renamed"

MAKEDIR(sourceRoot)

FOR fileIndex = 1 TO 16
    DIM filePath AS STRING = COMBINEPATH(sourceRoot, "part_" + TRIM(STR(fileIndex)) + ".txt")
    IF WRITEFILE(filePath, sourcePayload) THEN
        checksum = checksum + 1
    END IF
NEXT

FOR passIndex = 1 TO 45
    DELETEDIRRECURSIVE(passCopyRoot)
    DELETEDIRRECURSIVE(passMovedRoot)
    DELETEDIRRECURSIVE(passRenamedRoot)

    DELETEFILE(tempFile)
    DELETEFILE(copiedFile)
    DELETEFILE(movedFile)
    DELETEFILE(renamedFile)

    IF WRITEFILE(tempFile, tempPayload) THEN
        checksum = checksum + 1
    END IF

    IF COPYFILE(tempFile, copiedFile) THEN
        checksum = checksum + 1
    END IF

    IF MOVEFILE(copiedFile, movedFile) THEN
        checksum = checksum + 1
    END IF

    IF RENAMEFILE(movedFile, renamedFileName) THEN
        checksum = checksum + 1
    END IF

    IF COPYDIR(sourceRoot, passCopyRoot) THEN
        checksum = checksum + 1
    END IF

    IF MOVEDIR(passCopyRoot, passMovedRoot) THEN
        checksum = checksum + 1
    END IF

    IF RENAMEDIR(passMovedRoot, renamedDirName) THEN
        checksum = checksum + 1
    END IF

    CHANGEDIR(passRenamedRoot)
    IF CURRENTDIR() = passRenamedRoot THEN
        checksum = checksum + 2
    ELSE
        checksum = checksum + 1
    END IF
    CHANGEDIR(originalDir)

    IF DELETEFILE(tempFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEFILE(renamedFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEDIRRECURSIVE(passRenamedRoot) THEN
        checksum = checksum + 1
    END IF
NEXT

DELETEDIRRECURSIVE(scenarioRoot)

PRINT checksum
PRINT DIREXISTS(sourceRoot)
PRINT FILEEXISTS(COMBINEPATH(sourceRoot, "part_1.txt"))
