' Сравнительный сценарий: строковые массивы + FOR/WHILE/DO ... LOOP.
' Программа нагружает изменяющие ARRAY-функции на STRING()-массивах
' и одновременно трогает несколько форм цикла.

DIM source[1 TO 180] AS STRING
DIM schedule[1 TO 24] AS STRING
DIM seeded[] AS STRING
DIM working[] AS STRING
DIM prefix[] AS STRING
DIM suffix[] AS STRING
DIM merged[] AS STRING
DIM removedLine AS STRING
DIM poppedLine AS STRING
DIM checksum AS INTEGER
DIM digest AS STRING
DIM countIndex AS INTEGER
DIM headIndex AS INTEGER
DIM tailIndex AS INTEGER

FOR lineIndex = 1 TO ARRAYLENGTH(source[])
    source[lineIndex] = BuildDraftLine(lineIndex)
NEXT

FOR slotIndex = 1 TO ARRAYLENGTH(schedule[])
    schedule[slotIndex] = BuildScheduleEntry(slotIndex)
NEXT

seeded[] = ARRAYCONCAT(source[], schedule[])
working[] = ARRAYCLONE(seeded[])

DIM normalizeIndex AS INTEGER = 1

WHILE normalizeIndex <= ARRAYLENGTH(working[])
    working[normalizeIndex] = NormalizeDraftLine(working[normalizeIndex], normalizeIndex)
    normalizeIndex = normalizeIndex + 1
END WHILE

ARRAYINSERT(working[], 1, "заголовок раздела: готово, пакет строк")
ARRAYPUSH(working[], "хвост пакета: готово, итоговый маркер")

removedLine = ARRAYREMOVE(working[], 2)
poppedLine = ARRAYPOP(working[])

prefix[] = ARRAYTAKE(working[], 102)
suffix[] = ARRAYSKIP(working[], 102)
merged[] = ARRAYCONCAT(prefix[], suffix[])

checksum = 0
countIndex = 1

DO WHILE countIndex <= ARRAYLENGTH(merged[])
    IF CONTAINS(merged[countIndex], "готово") THEN
        checksum = checksum + 1
    END IF

    countIndex = countIndex + 1
LOOP

digest = ""
headIndex = 1

DO
    digest = digest + LEFT(merged[headIndex], 14)

    IF headIndex = 3 THEN
        EXIT DO
    END IF

    digest = digest + " / "
    headIndex = headIndex + 1
LOOP

tailIndex = ARRAYLENGTH(merged[]) - 2

DO UNTIL tailIndex > ARRAYLENGTH(merged[])
    digest = digest + " // " + RIGHT(merged[tailIndex], 14)
    tailIndex = tailIndex + 1
LOOP

PRINT ARRAYLENGTH(source[])
PRINT ARRAYLENGTH(working[])
PRINT ARRAYLENGTH(merged[])
PRINT LEN(removedLine)
PRINT LEN(poppedLine)
PRINT checksum
PRINT LEFT(digest, 48)
PRINT RIGHT(digest, 48)

FUNCTION BuildDraftLine(lineIndex AS INTEGER) AS STRING
    DIM selector AS INTEGER = lineIndex MOD 5

    IF selector = 0 THEN
        RETURN "черновик  отчёта номер " + STR(lineIndex) + "."
    ELSEIF selector = 1 THEN
        RETURN "черновик  письма: строка " + STR(lineIndex) + "."
    ELSEIF selector = 2 THEN
        RETURN "черновик  заметки: пакет " + STR(lineIndex) + "."
    ELSEIF selector = 3 THEN
        RETURN "черновик  абзаца: модуль " + STR(lineIndex) + "."
    END IF

    RETURN "черновик  сводки: документ " + STR(lineIndex) + "."
END FUNCTION

FUNCTION BuildScheduleEntry(slotIndex AS INTEGER) AS STRING
    DIM dayText AS DATE = DATEADD("d", slotIndex - 1, DATESERIAL(2026, 4, 1))
    DIM timeText AS TIME = DATEADD("n", slotIndex * 7, TIMESERIAL(8, 0, 0))
    DIM timeStr AS STRING = timeText

    RETURN "слот " + STR(slotIndex) + ": " + WEEKDAYNAME(WEEKDAY(dayText)) + ", " + MONTHNAME(MONTH(dayText)) + " " + STR(DAY(dayText)) + " " + LEFT(timeStr, 5)
END FUNCTION

FUNCTION NormalizeDraftLine(inputText AS STRING, lineIndex AS INTEGER) AS STRING
    DIM resultText AS STRING = inputText
    DIM compactText AS STRING

    IF lineIndex MOD 2 = 0 THEN
        resultText = INSERT(resultText, 1, "строка ")
    ELSE
        resultText = INSERT(resultText, 1, "блок ")
    END IF

    resultText = REPLACE(resultText, "черновик", "готово")

    DO
        compactText = REPLACE(resultText, "  ", " ")

        IF compactText = resultText THEN
            EXIT DO
        END IF

        resultText = compactText
    LOOP

    IF RIGHT(resultText, 1) = "." THEN
        resultText = REMOVE(resultText, LEN(resultText), 1)
    END IF

    RETURN TRIM(resultText)
END FUNCTION
