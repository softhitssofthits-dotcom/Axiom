' Сравнительный сценарий: строки + файлы + массивы.
' Программа создаёт большой текстовый файл во временном наборе `.artifacts`,
' чинит типовые mojibake-фрагменты и печатает короткую сводку результата.

DIM artifactsRoot AS STRING = COMBINEPATH(CURRENTDIR(), ".artifacts")
DIM compareRoot AS STRING = COMBINEPATH(artifactsRoot, "manual-checks")
DIM sourcePath AS STRING = COMBINEPATH(compareRoot, "document_batch_repair_source.txt")
DIM workPath AS STRING = COMBINEPATH(compareRoot, "document_batch_repair_work.txt")
DIM sourceLines[] AS STRING
DIM sourceText AS STRING
DIM repairedText AS STRING
DIM repairedLines[] AS STRING
DIM fixedCount AS INTEGER
DIM remainingBrokenCount AS INTEGER

PRINT MAKEDIR(artifactsRoot)
PRINT MAKEDIR(compareRoot)

REDIM sourceLines[1 TO 1200]

FOR lineIndex = 1 TO ARRAYLENGTH(sourceLines[])
    sourceLines[lineIndex] = BuildSourceLine(lineIndex)
NEXT

sourceText = JOIN(sourceLines[], CHR(13) + CHR(10))

PRINT WRITEFILE(sourcePath, sourceText)
PRINT COPYFILE(sourcePath, workPath, TRUE)

sourceText = READFILE(workPath)
repairedText = RepairDocument(sourceText)
fixedCount = CountFixedLines(sourceText, repairedText)
remainingBrokenCount = CountBrokenLines(repairedText)

PRINT fixedCount
PRINT remainingBrokenCount
PRINT WRITEFILE(workPath, repairedText)

repairedLines[] = READALLLINES(workPath)
PRINT ARRAYLENGTH(repairedLines[])
PRINT LEFT(repairedText, 24)
PRINT RIGHT(repairedText, 24)

FUNCTION BuildSourceLine(lineIndex AS INTEGER) AS STRING
    DIM selector AS INTEGER = lineIndex MOD 6

    IF selector = 0 THEN
        RETURN "РџСЂРёРјРµСЂ строки: С‚РµРєСЃС‚, план и обычный хвост."
    ELSEIF selector = 1 THEN
        RETURN "Р СѓСЃСЃРєРёР№ абзац: РґР°РЅРЅС‹Рµ, модуль и проверка."
    ELSEIF selector = 2 THEN
        RETURN "Нормальная строка: данные, модуль, файл, строка."
    ELSEIF selector = 3 THEN
        RETURN "Смешанная строка: РџСЂРёРјРµСЂ и текст без поломки."
    ELSEIF selector = 4 THEN
        RETURN "РџР»Р°РЅ работы: РґРѕРєСѓРјРµРЅС‚, СЃС‚СЂРѕРєР°, функция."
    END IF

    RETURN "Файловый проход: Р СѓСЃСЃРєРёР№ текст и РџСЂРёРјРµСЂ в одном месте."
END FUNCTION

FUNCTION RepairDocument(inputText AS STRING) AS STRING
    DIM lines[] AS STRING

    lines[] = SPLIT(inputText, CHR(10))

    FOR lineIndex = 1 TO ARRAYLENGTH(lines[])
        lines[lineIndex] = RepairLine(RemoveTrailingCr(lines[lineIndex]))
    NEXT

    RETURN JOIN(lines[], CHR(13) + CHR(10))
END FUNCTION

FUNCTION RepairLine(inputText AS STRING) AS STRING
    DIM resultText AS STRING = inputText

    resultText = RepairToken(resultText, "РџСЂРёРјРµСЂ", "Пример")
    resultText = RepairToken(resultText, "С‚РµРєСЃС‚", "текст")
    resultText = RepairToken(resultText, "Р СѓСЃСЃРєРёР№", "Русский")
    resultText = RepairToken(resultText, "РґР°РЅРЅС‹Рµ", "данные")
    resultText = RepairToken(resultText, "РџР»Р°РЅ", "План")
    resultText = RepairToken(resultText, "РґРѕРєСѓРјРµРЅС‚", "документ")
    resultText = RepairToken(resultText, "СЃС‚СЂРѕРєР°", "строка")

    IF CONTAINS(resultText, "  ") THEN
        resultText = REPLACE(resultText, "  ", " ")
    END IF

    RETURN TRIM(resultText)
END FUNCTION

FUNCTION RepairToken(inputText AS STRING, brokenText AS STRING, fixedText AS STRING) AS STRING
    IF CONTAINS(inputText, brokenText) THEN
        RETURN REPLACE(inputText, brokenText, fixedText)
    END IF

    RETURN inputText
END FUNCTION

FUNCTION CountFixedLines(originalDocumentText AS STRING, repairedDocumentText AS STRING) AS INTEGER
    DIM beforeLines[] AS STRING
    DIM afterLines[] AS STRING
    DIM count AS INTEGER = 0

    beforeLines[] = SPLIT(originalDocumentText, CHR(10))
    afterLines[] = SPLIT(repairedDocumentText, CHR(10))

    FOR lineIndex = 1 TO ARRAYLENGTH(beforeLines[])
        IF RepairLine(RemoveTrailingCr(beforeLines[lineIndex])) <> RemoveTrailingCr(beforeLines[lineIndex]) THEN
            count = count + 1
        END IF
    NEXT

    RETURN count
END FUNCTION

FUNCTION CountBrokenLines(inputText AS STRING) AS INTEGER
    DIM lines[] AS STRING
    DIM count AS INTEGER = 0

    lines[] = SPLIT(inputText, CHR(10))

    FOR lineIndex = 1 TO ARRAYLENGTH(lines[])
        IF ContainsBrokenToken(RemoveTrailingCr(lines[lineIndex])) THEN
            count = count + 1
        END IF
    NEXT

    RETURN count
END FUNCTION

FUNCTION ContainsBrokenToken(inputText AS STRING) AS BOOLEAN
    IF CONTAINS(inputText, "РџСЂ") OR CONTAINS(inputText, "С‚РµРє") OR CONTAINS(inputText, "Р СѓСЃ") OR CONTAINS(inputText, "РґР°РЅ") OR CONTAINS(inputText, "РџР»Р°") OR CONTAINS(inputText, "РґРѕРє") OR CONTAINS(inputText, "СЃС‚СЂ") THEN
        RETURN TRUE
    END IF

    RETURN FALSE
END FUNCTION

FUNCTION RemoveTrailingCr(inputText AS STRING) AS STRING
    IF LEN(inputText) = 0 THEN
        RETURN inputText
    END IF

    IF RIGHT(inputText, 1) = CHR(13) THEN
        RETURN LEFT(inputText, LEN(inputText) - 1)
    END IF

    RETURN inputText
END FUNCTION
