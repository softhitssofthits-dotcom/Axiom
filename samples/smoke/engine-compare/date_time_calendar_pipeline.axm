' Проверка встроенных функций даты и времени с воспроизводимыми входными значениями.
' Программа нагружает преобразование серийных значений, извлечение частей даты,
' арифметику, проверку границ и часовые пояса без чтения текущего времени.

DIM stamps(1 TO 96) AS DATETIME
DIM dateChecksum AS LONG = 0
DIM timeChecksum AS LONG = 0
DIM calendarChecksum AS LONG = 0
DIM nameDigest AS STRING = ""

FOR itemIndex = 1 TO ARRAYLENGTH(stamps)
    DIM baseDateTime AS DATETIME = DATESERIAL(2026, 1, 15)
    stamps(itemIndex) = DATEADD("d", itemIndex - 1, baseDateTime)
    stamps(itemIndex) = DATEADD("n", itemIndex * 13, stamps(itemIndex))
NEXT

FOR roundIndex = 1 TO 18
    FOR itemIndex = 1 TO ARRAYLENGTH(stamps)
        DIM shifted AS DATETIME = DATEADD("m", roundIndex MOD 3, stamps(itemIndex))
        shifted = DATEADD("d", itemIndex MOD 7, shifted)
        shifted = DATEADD("h", roundIndex MOD 5, shifted)

        dateChecksum = dateChecksum + YEAR(shifted) + MONTH(shifted) + DAY(shifted)
        dateChecksum = dateChecksum + DATEDIFF("d", stamps(itemIndex), shifted)
        dateChecksum = dateChecksum + DATEPART("y", shifted) + DATEPART("q", shifted)

        timeChecksum = timeChecksum + HOUR(shifted) + MINUTE(shifted) + SECOND(shifted)
        timeChecksum = timeChecksum + DATEPART("w", shifted) + WEEKDAY(shifted)

        calendarChecksum = calendarChecksum + DAY(STARTOFMONTH(shifted))
        calendarChecksum = calendarChecksum + DAY(ENDOFMONTH(shifted))
        calendarChecksum = calendarChecksum + MONTH(STARTOFYEAR(shifted))
        calendarChecksum = calendarChecksum + MONTH(ENDOFYEAR(shifted))
        calendarChecksum = calendarChecksum + DAYSINMONTH(YEAR(shifted), MONTH(shifted))
        calendarChecksum = calendarChecksum + UTCOFFSET(shifted, "UTC")

        IF ISLEAPYEAR(YEAR(shifted)) THEN
            calendarChecksum = calendarChecksum + 2
        ELSE
            calendarChecksum = calendarChecksum + 1
        END IF

        DIM utcValue AS DATETIME = TOUTC(shifted, "UTC")
        DIM localValue AS DATETIME = FROMUTC(utcValue, "UTC")

        calendarChecksum = calendarChecksum + DAY(localValue)
        timeChecksum = timeChecksum + HOUR(localValue)

        DIM localStr AS STRING = localValue
        IF ISDATE(localStr) THEN
            calendarChecksum = calendarChecksum + 1
        END IF

        IF itemIndex MOD 24 = 0 THEN
            nameDigest = nameDigest + LEFT(MONTHNAME(MONTH(shifted)), 1) + LEFT(WEEKDAYNAME(WEEKDAY(shifted)), 1)
        END IF
    NEXT
NEXT

PRINT dateChecksum
PRINT timeChecksum
PRINT calendarChecksum
PRINT LEFT(nameDigest, 24)
PRINT RIGHT(nameDigest, 24)
