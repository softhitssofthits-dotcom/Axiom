' Сценарий проверяет процедуры, функции, значения-функции и замыкания.
' Здесь намеренно мало вызовов прочих встроенных функций, чтобы основная нагрузка
' приходилась на процедуры, значения-функции и замыкания.

DIM plainChecksum AS LONG = 0
DIM dispatchChecksum AS LONG = 0
DIM subChecksum AS LONG = 0
DIM closureChecksum AS LONG = 0
DIM counterChecksum AS LONG = 0

DIM transform AS FUNCTION (INTEGER) AS INTEGER
DIM stepper AS FUNCTION (INTEGER) AS INTEGER
DIM counter AS FUNCTION () AS INTEGER

FOR roundIndex = 1 TO 320
    plainChecksum = plainChecksum + ComputeWave(roundIndex, roundIndex MOD 7)

    IF roundIndex MOD 2 = 0 THEN
        transform = DoubleAndShift
    ELSE
        transform = TripleAndTrim
    END IF

    RunNestedSub(roundIndex)

    stepper = MakeStepper(roundIndex, (roundIndex MOD 5) + 1)
    counter = MakeCounter(roundIndex MOD 4)

    FOR innerIndex = 1 TO 6
        dispatchChecksum = dispatchChecksum + ApplyTwice(transform, (roundIndex + innerIndex) MOD 15)
        closureChecksum = closureChecksum + stepper(innerIndex)
        counterChecksum = counterChecksum + counter()
    NEXT
NEXT

PRINT plainChecksum
PRINT dispatchChecksum
PRINT subChecksum
PRINT closureChecksum
PRINT counterChecksum

FUNCTION ComputeWave(value AS INTEGER, bias AS INTEGER) AS INTEGER
    RETURN value * 3 + bias + (value MOD 4)
END FUNCTION

FUNCTION ApplyTwice(op AS FUNCTION (INTEGER) AS INTEGER, value AS INTEGER) AS INTEGER
    RETURN op(op(value))
END FUNCTION

FUNCTION DoubleAndShift(value AS INTEGER) AS INTEGER
    RETURN value * 2 + 3
END FUNCTION

FUNCTION TripleAndTrim(value AS INTEGER) AS INTEGER
    RETURN value * 3 - 2
END FUNCTION

SUB RunNestedSub(seed AS INTEGER)
    DIM subtotal AS INTEGER = seed

    Bump()
    Bump()
    Bump()

    subChecksum = subChecksum + subtotal

    SUB Bump()
        subtotal = subtotal + (seed MOD 5) + 1
    END SUB
END SUB

FUNCTION MakeStepper(baseValue AS INTEGER, delta AS INTEGER) AS FUNCTION (INTEGER) AS INTEGER
    DIM offset AS INTEGER = delta * 2

    FUNCTION StepValue(value AS INTEGER) AS INTEGER
        offset = offset + 1
        RETURN baseValue + value + offset
    END FUNCTION

    RETURN StepValue
END FUNCTION

FUNCTION MakeCounter(seed AS INTEGER) AS FUNCTION () AS INTEGER
    DIM current AS INTEGER = seed

    FUNCTION NextValue() AS INTEGER
        current = current + 2
        RETURN current
    END FUNCTION

    RETURN NextValue
END FUNCTION
