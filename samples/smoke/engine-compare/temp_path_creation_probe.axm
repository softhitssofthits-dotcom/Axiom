' Сравнительный сценарий: создание временных путей.
' Нагружает MAKETEMPFILE, MAKETEMPDIR, COMBINEPATH и MAKEDIR.

DIM checksum AS LONG = 0

FOR passIndex = 1 TO 80
    DIM tempFile AS STRING = MAKETEMPFILE("temp-path-file_")
    DIM tempDir AS STRING = MAKETEMPDIR("temp-path-dir_")
    DIM nestedDir AS STRING = COMBINEPATH(tempDir, "nested")
    DIM rootFile AS STRING = COMBINEPATH(tempDir, "root.txt")
    DIM nestedFile AS STRING = COMBINEPATH(nestedDir, "nested.txt")

    IF tempFile <> "" THEN
        checksum = checksum + 1
    END IF

    IF rootFile <> "" THEN
        checksum = checksum + 1
    END IF

    IF nestedFile <> "" THEN
        checksum = checksum + 1
    END IF

    IF MAKEDIR(nestedDir) THEN
        checksum = checksum + 1
    END IF

    IF DELETEFILE(tempFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEDIRRECURSIVE(tempDir) THEN
        checksum = checksum + 1
    END IF
NEXT

PRINT checksum
