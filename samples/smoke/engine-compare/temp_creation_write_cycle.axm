' Сравнительный сценарий: создание временных путей и запись.
' Нагружает MAKETEMPFILE, MAKETEMPDIR, COMBINEPATH, MAKEDIR и WRITEFILE.

DIM checksum AS LONG = 0
DIM tempFilePayload AS STRING = "temp-file-content"
DIM rootFilePayload AS STRING = "temp-root-content"
DIM nestedFilePayload AS STRING = "temp-nested-content"

FOR passIndex = 1 TO 60
    DIM tempFile AS STRING = MAKETEMPFILE("temp-create-file_")
    DIM tempDir AS STRING = MAKETEMPDIR("temp-create-dir_")
    DIM nestedDir AS STRING = COMBINEPATH(tempDir, "nested")
    DIM rootFile AS STRING = COMBINEPATH(tempDir, "root.txt")
    DIM nestedFile AS STRING = COMBINEPATH(nestedDir, "nested.txt")

    IF MAKEDIR(nestedDir) THEN
        checksum = checksum + 1
    END IF

    IF WRITEFILE(tempFile, tempFilePayload) THEN
        checksum = checksum + 1
    END IF

    IF WRITEFILE(rootFile, rootFilePayload) THEN
        checksum = checksum + 1
    END IF

    IF WRITEFILE(nestedFile, nestedFilePayload) THEN
        checksum = checksum + 1
    END IF

    IF DELETEFILE(tempFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEDIRRECURSIVE(tempDir) THEN
        checksum = checksum + 1
    END IF
NEXT

PRINT checksum
