' Сравнительный сценарий: файловые path/info built-in.
' Нагружает COMBINEPATH, FULLPATH, FILENAME, DIRNAME, FILEEXISTS, PATHEXISTS,
' FILESIZE, FILEDATE, ISABSOLUTEPATH и GETFILES почти без строкового и regex-слоя.

DIM artifactsRoot AS STRING = COMBINEPATH(CURRENTDIR(), ".artifacts")
DIM compareRoot AS STRING = COMBINEPATH(artifactsRoot, "manual-checks")
DIM sweepRoot AS STRING = COMBINEPATH(compareRoot, "file-path-metadata-sweep")
DIM files() AS STRING
DIM pathChecksum AS LONG = 0
DIM sizeChecksum AS LONG = 0
DIM dateChecksum AS LONG = 0
DIM flagChecksum AS LONG = 0

PRINT MAKEDIR(artifactsRoot)
PRINT MAKEDIR(compareRoot)
PRINT MAKEDIR(sweepRoot)

FOR fileIndex = 1 TO 24
    DIM filePath AS STRING = COMBINEPATH(sweepRoot, "meta_" + TRIM(STR(fileIndex)) + ".txt")
    PRINT WRITEFILE(filePath, BuildPayload(fileIndex))
NEXT

files = GETFILES(sweepRoot, "*.txt")

FOR passIndex = 1 TO 120
    FOR fileIndex = 1 TO ARRAYLENGTH(files)
        DIM pathValue AS STRING = files(fileIndex)
        DIM fullPathValue AS STRING = FULLPATH(pathValue)
        DIM directoryValue AS STRING = DIRNAME(fullPathValue)
        DIM fileNameValue AS STRING = FILENAME(fullPathValue)
        DIM rebuiltPath AS STRING = COMBINEPATH(directoryValue, fileNameValue)

        pathChecksum = pathChecksum + LEN(fullPathValue)
        pathChecksum = pathChecksum + LEN(directoryValue)
        pathChecksum = pathChecksum + LEN(fileNameValue)

        IF FILEEXISTS(rebuiltPath) THEN
            sizeChecksum = sizeChecksum + FILESIZE(rebuiltPath)
            dateChecksum = dateChecksum + LEN(FILEDATE(rebuiltPath))
            flagChecksum = flagChecksum + 2
        END IF

        IF PATHEXISTS(fullPathValue) THEN
            flagChecksum = flagChecksum + 3
        END IF

        IF ISABSOLUTEPATH(fullPathValue) THEN
            flagChecksum = flagChecksum + 5
        END IF
    NEXT
NEXT

PRINT ARRAYLENGTH(files)
PRINT pathChecksum
PRINT sizeChecksum
PRINT dateChecksum
PRINT flagChecksum

FUNCTION BuildPayload(fileIndex AS INTEGER) AS STRING
    RETURN "meta-file-" + TRIM(STR(fileIndex)) + CHR(13) + CHR(10) + "payload-" + TRIM(STR(fileIndex * 17))
END FUNCTION
