' Ожидается TRUE: общие префиксы правил не совпадают целиком с текстом.
DIM oldItems(1 TO 64) AS STRING
DIM newItems(1 TO 64) AS STRING
FOR i = 1 TO 64
    oldItems(i) = REPEAT("a", 20) + STR(i)
    newItems(i) = "x"
NEXT
DIM text AS STRING = REPEAT("a", 20000)
DIM result AS STRING
FOR i = 1 TO 10
    result = REPLACEMANY(text, oldItems, newItems)
NEXT
PRINT result = text
