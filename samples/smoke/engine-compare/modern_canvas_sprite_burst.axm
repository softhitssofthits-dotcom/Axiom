' Детерминированная нагрузка на LOADIMAGE, LOADSPRITE, DRAWIMAGE и DRAWSPRITE без ручного ввода.
' Сценарий нужен для сравнения Interpreter и BytecodeVm на современном CANVAS-пути со спрайтами и изображениями.

DIM WIDTH AS INTEGER = 320
DIM HEIGHT AS INTEGER = 180
DIM FRAMES AS INTEGER = 40
DIM IMAGE_BURST AS INTEGER = 12
DIM SPRITE_BURST AS INTEGER = 18

DIM checksum AS LONG
DIM background AS IMAGE
DIM icon AS IMAGE
DIM walker AS SPRITE

background = LOADIMAGE("samples/graphics/game/art/Background.gif")
icon = LOADIMAGE("src/Axiom.Ide/Assets/axiom.ico")
walker = LOADSPRITE("samples/graphics/sprites/assets/walk_sheet.png", 16, 16)

CANVAS WIDTH, HEIGHT

FOR frameIndex = 0 TO FRAMES - 1
    BEGINFRAME
    ' Очищаем кадр и чуть сдвигаем камеру, чтобы часть спрайтов шла через world-координаты.
    CLS RGB(10 + (frameIndex MOD 5) * 6, 14, 22 + (frameIndex MOD 4) * 8)
    CAMERA (frameIndex MOD 6) * 3, (frameIndex MOD 4) * 2

    FOR imageIndex = 0 TO IMAGE_BURST - 1
        ' Рисуем фоновые картинки разного размера, чтобы нагружать масштабирование DRAWIMAGE.
        DRAWIMAGE background, -20 + imageIndex * 26, 10 + (imageIndex MOD 3) * 28, 48 + (imageIndex MOD 4) * 10, 24 + (imageIndex MOD 5) * 8
        DRAWIMAGE icon, 180 + imageIndex * 9, 16 + (imageIndex MOD 4) * 24, 16 + (imageIndex MOD 3) * 8, 16 + (imageIndex MOD 3) * 8
        checksum = checksum + (imageIndex + 1) * (frameIndex + 3)
    NEXT imageIndex

    FOR spriteIndex = 0 TO SPRITE_BURST - 1
        ' Гоняем все четыре кадра листа и чередуем натуральный и увеличенный вывод.
        DRAWSPRITE walker, (frameIndex + spriteIndex) MOD 4, 12 + spriteIndex * 16, 92 + (spriteIndex MOD 3) * 20
        DRAWSPRITE walker, (frameIndex + spriteIndex + 1) MOD 4, 20 + spriteIndex * 15, 128 + (spriteIndex MOD 2) * 16, 24 + (spriteIndex MOD 3) * 6, 24 + (spriteIndex MOD 3) * 6
        checksum = checksum + (spriteIndex + 5) * ((frameIndex MOD 7) + 1)
    NEXT spriteIndex

    RESETCAMERA
    DRAWTEXT "Кадр " + TRIM(STR(frameIndex)) + " сумма " + TRIM(STR(checksum MOD 100000)), 8, 8, RGB(250, 244, 210)
    PRESENT
NEXT frameIndex

PRINT checksum
