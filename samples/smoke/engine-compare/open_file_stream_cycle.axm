' Сравнительный сценарий: открытые текстовые файлы и потоковые операции.
' Нагружает OPEN/CLOSE, WRITE, WRITELINE, FLUSH, SEEKFILE, REWIND,
' READLINE, READTEXT, READTOEND, FILEMODE, FILEPOS, FILELENGTH, EOF и ISOPEN.

DIM folder AS STRING = MAKETEMPDIR("open-stream-cycle_")
DIM checksum AS LONG = 0

FOR passIndex = 1 TO 55
    DIM path AS STRING = COMBINEPATH(folder, "part_" + TRIM(STR(passIndex)) + ".txt")
    DIM writer AS FILE
    DIM reader AS FILE

    OPEN path FOR OUTPUT AS writer
    checksum = checksum + LEN(FILEMODE(writer))
    checksum = checksum + FILEPOS(writer)
    checksum = checksum + LEN(FILEPATH(writer))
    IF ISOPEN(writer) THEN
        checksum = checksum + 1
    END IF

    IF WRITELINE(writer, "alpha-" + TRIM(STR(passIndex))) THEN
        checksum = checksum + 1
    END IF

    IF WRITE(writer, "beta-") THEN
        checksum = checksum + 1
    END IF

    IF WRITE(writer, TRIM(STR(passIndex * 7))) THEN
        checksum = checksum + 1
    END IF

    IF NEWLINE(writer) THEN
        checksum = checksum + 1
    END IF

    IF WRITE(writer, "gamma-" + TRIM(STR(passIndex + 10))) THEN
        checksum = checksum + 1
    END IF

    IF FLUSH(writer) THEN
        checksum = checksum + 1
    END IF

    checksum = checksum + FILEPOS(writer)
    checksum = checksum + FILELENGTH(writer)
    CLOSE writer

    OPEN path FOR APPEND AS writer
    checksum = checksum + LEN(FILEMODE(writer))
    IF WRITELINE(writer, "-tail") THEN
        checksum = checksum + 1
    END IF
    CLOSE writer

    OPEN path FOR INPUT AS reader
    checksum = checksum + LEN(FILEMODE(reader))
    checksum = checksum + FILELENGTH(reader)
    checksum = checksum + LEN(READLINE(reader))
    checksum = checksum + FILEPOS(reader)
    checksum = checksum + LEN(READTEXT(reader, 3))
    IF SEEKFILE(reader, 0) THEN
        checksum = checksum + 1
    END IF
    IF REWIND(reader) THEN
        checksum = checksum + 1
    END IF
    checksum = checksum + FILEPOS(reader)
    checksum = checksum + LEN(READTOEND(reader))
    IF EOF(reader) THEN
        checksum = checksum + 1
    END IF
    CLOSE reader
NEXT

PRINT checksum
