' Сравнительный сценарий: многократный FILESIZE на временном файле.
' Нагружает прежде всего FILESIZE.

DIM checksum AS LONG = 0
DIM rootFilePayload AS STRING = "temp-root-content"

FOR passIndex = 1 TO 80
    DIM tempDir AS STRING = MAKETEMPDIR("temp-filesize-dir_")
    DIM rootFile AS STRING = COMBINEPATH(tempDir, "root.txt")

    IF WRITEFILE(rootFile, rootFilePayload) THEN
        checksum = checksum + 1
    END IF

    FOR probeIndex = 1 TO 12
        checksum = checksum + FILESIZE(rootFile)
    NEXT

    IF DELETEDIRRECURSIVE(tempDir) THEN
        checksum = checksum + 1
    END IF
NEXT

PRINT checksum
