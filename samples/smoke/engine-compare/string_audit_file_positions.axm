' Ожидается 50015000: номера строк после 10000 последовательных чтений.
IF NOT DIREXISTS(".artifacts") THEN
    DIM created AS BOOLEAN = MAKEDIR(".artifacts")
END IF
DIM path AS STRING = ".artifacts/string_audit_file_positions.txt"
DIM handle AS FILE
OPEN path FOR OUTPUT AS handle
FOR i = 1 TO 10000
    DIM written AS BOOLEAN = WRITELINE(handle, "строка")
NEXT
CLOSE handle
OPEN path FOR INPUT AS handle
DIM checksum AS LONG = 0
WHILE NOT EOF(handle)
    DIM line AS STRING = READLINE(handle)
    checksum = checksum + LINENUMBER(handle)
END WHILE
CLOSE handle
PRINT checksum
DIM deleted AS BOOLEAN = DELETEFILE(path)
