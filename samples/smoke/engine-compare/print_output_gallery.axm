' Сравнительный сценарий: адресная нагрузка на PRINT и PRINT USING.
' Сценарий специально делает вывод основным источником работы:
' обычный PRINT, списки с разделителями `;` и `,`, а также форматные маски.

DIM total AS LONG = 0
DIM amountChecksum AS DOUBLE = 0
DIM countSummary AS LONG = 0

FOR rowIndex = 1 TO 180
    DIM whole AS LONG = rowIndex * 17 + (rowIndex MOD 9)
    DIM amount AS DOUBLE = rowIndex * 12.375 + (rowIndex MOD 5) / 10.0
    DIM code AS STRING

    SELECT CASE rowIndex MOD 4
        CASE 0
            code = "ALPHA"
        CASE 1
            code = "BETA"
        CASE 2
            code = "GAMMA"
        CASE ELSE
            code = "DELTA"
    END SELECT

    total = total + whole
    amountChecksum = amountChecksum + amount
    countSummary = countSummary + rowIndex MOD 7

    PRINT "ROW"; rowIndex; code;
    PRINT "AMOUNT"; amount, whole;

    PRINT USING "###|###.##|+$###.##"; rowIndex; amount; amount - whole
    PRINT USING "!\ \    \ &"; code; code; "TRACE"
NEXT

PRINT total
PRINT INT(amountChecksum)
PRINT countSummary
