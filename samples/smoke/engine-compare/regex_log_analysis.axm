' Сравнительный сценарий: регулярные выражения + строки + массивы.
' Программа строит большой журнал, затем считает совпадения, извлекает группы
' и делит текст обратно на строки.

DIM lines[] AS STRING
DIM logText AS STRING
DIM maskedText AS STRING
DIM errorMatches[] AS STRING
DIM userIds[] AS STRING
DIM parts[] AS STRING

REDIM lines[1 TO 2400]

FOR lineIndex = 1 TO ARRAYLENGTH(lines[])
    lines[lineIndex] = BuildLogLine(lineIndex)
NEXT

logText = JOIN(lines[], CHR(10))
maskedText = REGEXREPLACE(logText, "session=[A-Z]{2}\d{4}", "session=#")
errorMatches[] = REGEXMATCHES(maskedText, "ERR\d{3}")
userIds[] = REGEXEXTRACTALL(maskedText, "user=(\d+)", 1)
parts[] = REGEXSPLIT(maskedText, "\r?\n")

PRINT REGEXCOUNT(maskedText, "WARN\d{3}")
PRINT ARRAYLENGTH(errorMatches[])
PRINT ARRAYLENGTH(userIds[])
PRINT ARRAYLENGTH(parts[])
PRINT errorMatches[1]
PRINT errorMatches[ARRAYLENGTH(errorMatches[])]
PRINT userIds[1]
PRINT userIds[ARRAYLENGTH(userIds[])]

FUNCTION BuildLogLine(lineIndex AS INTEGER) AS STRING
    DIM levelSelector AS INTEGER = lineIndex MOD 3
    DIM userId AS STRING = GetUserId(lineIndex MOD 5)
    DIM sessionId AS STRING = GetSessionId(lineIndex MOD 7)

    IF levelSelector = 0 THEN
        RETURN "level=ERROR code=ERR101 user=" + userId + " session=" + sessionId + " path=/docs/worklog"
    ELSEIF levelSelector = 1 THEN
        RETURN "level=WARN code=WARN205 user=" + userId + " session=" + sessionId + " path=/samples/regex"
    END IF

    RETURN "level=ERROR code=ERR302 user=" + userId + " session=" + sessionId + " path=/runtime/vm"
END FUNCTION

FUNCTION GetUserId(selector AS INTEGER) AS STRING
    IF selector = 0 THEN
        RETURN "1001"
    ELSEIF selector = 1 THEN
        RETURN "2002"
    ELSEIF selector = 2 THEN
        RETURN "3003"
    ELSEIF selector = 3 THEN
        RETURN "4004"
    END IF

    RETURN "5005"
END FUNCTION

FUNCTION GetSessionId(selector AS INTEGER) AS STRING
    IF selector = 0 THEN
        RETURN "AX1000"
    ELSEIF selector = 1 THEN
        RETURN "BX2001"
    ELSEIF selector = 2 THEN
        RETURN "CX3002"
    ELSEIF selector = 3 THEN
        RETURN "DX4003"
    ELSEIF selector = 4 THEN
        RETURN "EX5004"
    ELSEIF selector = 5 THEN
        RETURN "FX6005"
    END IF

    RETURN "GX7006"
END FUNCTION
