' Нагрузка: четыре прохода ARRAYDISTINCT по уникальным моментам UTC.
DIM values(1 TO 8000) AS UTCDATETIME
DIM origin AS DATETIME = "2024-01-01 00:00:00"
FOR index = 1 TO 8000
    values(index) = TOINSTANT(DATEADD("s", index, origin), "UTC")
NEXT
DIM result() AS UTCDATETIME
DIM total AS LONG = 0
FOR roundIndex = 1 TO 4
    result = ARRAYDISTINCT(values)
    total = total + ARRAYLENGTH(result)
NEXT
PRINT total
PRINT result(1)
PRINT result(8000)
