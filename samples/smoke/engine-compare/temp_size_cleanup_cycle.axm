' Сравнительный сценарий: размеры и очистка временного хранилища.
' Нагружает FILESIZE, DIRSIZE, DELETEFILE и DELETEDIRRECURSIVE
' поверх заранее подготовленных временных путей.

DIM rootPaths[] AS STRING
DIM filePaths[] AS STRING
DIM checksums[] AS LONG
DIM checksum AS LONG = 0
DIM rootFilePayload AS STRING = "temp-root-content"
DIM nestedFilePayload AS STRING = "temp-nested-content"

REDIM rootPaths[1 TO 60]
REDIM filePaths[1 TO 60]
REDIM checksums[1 TO 60]

FOR passIndex = 1 TO 60
    DIM tempDir AS STRING = MAKETEMPDIR("temp-size-dir_")
    DIM nestedDir AS STRING = COMBINEPATH(tempDir, "nested")
    DIM rootFile AS STRING = COMBINEPATH(tempDir, "root.txt")
    DIM nestedFile AS STRING = COMBINEPATH(nestedDir, "nested.txt")

    rootPaths[passIndex] = tempDir
    filePaths[passIndex] = rootFile

    IF MAKEDIR(nestedDir) THEN
        checksums[passIndex] = checksums[passIndex] + 1
    END IF

    IF WRITEFILE(rootFile, rootFilePayload) THEN
        checksums[passIndex] = checksums[passIndex] + 1
    END IF

    IF WRITEFILE(nestedFile, nestedFilePayload) THEN
        checksums[passIndex] = checksums[passIndex] + 1
    END IF
NEXT

FOR passIndex = 1 TO 60
    DIM tempDir AS STRING = rootPaths[passIndex]
    DIM rootFile AS STRING = filePaths[passIndex]

    checksum = checksum + checksums[passIndex]
    checksum = checksum + FILESIZE(rootFile)
    checksum = checksum + DIRSIZE(tempDir)

    IF DELETEFILE(rootFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEDIRRECURSIVE(tempDir) THEN
        checksum = checksum + 1
    END IF
NEXT

PRINT checksum
