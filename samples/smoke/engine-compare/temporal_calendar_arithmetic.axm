' Нагрузка на чистую календарную арифметику без работы с текстом и поясами.
' Отделяет стоимость DATEADD, DATEDIFF, DATEPART и границ периода от разбора
' текста и поиска пояса, чтобы эти затраты не смешивались в измерениях.

DIM checksum AS LONG = 0
DIM baseDateTime AS DATETIME = DATESERIAL(2026, 1, 15)

FOR roundIndex = 1 TO 300
    DIM shifted AS DATETIME = DATEADD("d", roundIndex MOD 27, baseDateTime)
    shifted = DATEADD("h", roundIndex MOD 23, shifted)
    shifted = DATEADD("n", roundIndex MOD 59, shifted)

    checksum = checksum + YEAR(shifted) + MONTH(shifted) + DAY(shifted)
    checksum = checksum + HOUR(shifted) + MINUTE(shifted) + SECOND(shifted)

    ' Разности считают пересечённые границы, а не полные интервалы.
    checksum = checksum + DATEDIFF("d", baseDateTime, shifted)
    checksum = checksum + DATEDIFF("h", baseDateTime, shifted)
    checksum = checksum + DATEDIFF("m", baseDateTime, shifted)

    checksum = checksum + DATEPART("y", shifted) + DATEPART("q", shifted)
    checksum = checksum + DATEPART("w", shifted) + WEEKDAY(shifted)

    ' Границы периода и високосность.
    checksum = checksum + DAY(STARTOFMONTH(shifted)) + DAY(ENDOFMONTH(shifted))
    checksum = checksum + MONTH(STARTOFYEAR(shifted)) + MONTH(ENDOFYEAR(shifted))

    IF ISLEAPYEAR(YEAR(shifted)) THEN
        checksum = checksum + 1
    END IF

    ' Арифметика времени суток переходит через полночь по модулю суток.
    DIM clockTime AS TIME = TIMESERIAL(roundIndex MOD 24, roundIndex MOD 60, 0)
    DIM advanced AS TIME = DATEADD("s", 45, clockTime)
    checksum = checksum + HOUR(advanced) + MINUTE(advanced) + SECOND(advanced)
NEXT

PRINT checksum
