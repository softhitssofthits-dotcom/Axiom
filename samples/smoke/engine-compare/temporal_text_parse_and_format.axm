' Нагрузка на разбор и печать временного текста без чтения текущего времени.
' Проверяет именно стоимость преобразования: DATEVALUE, TIMEVALUE, DATETIMEVALUE,
' ISDATE и обратная запись значения в STRING.
' Все входные данные постоянны, поэтому вывод одинаков при каждом запуске.

DIM checksum AS LONG = 0
DIM digest AS STRING = ""
DIM sourceText AS STRING = "2026-04-20 14:05:06"
DIM exchangeText AS STRING = "2026-04-20T14:05:06.125Z"

FOR roundIndex = 1 TO 400
    DIM dayValue AS DATE = DATEVALUE(sourceText)
    DIM clockTime AS TIME = TIMEVALUE(sourceText)
    DIM moment AS DATETIME = DATETIMEVALUE(sourceText)
    DIM instant AS UTCDATETIME = INSTANTVALUE(exchangeText)

    ' Обратная запись в текст: проверяет форматирование, а не только разбор.
    DIM momentText AS STRING = moment
    DIM instantText AS STRING = instant
    DIM dateText AS STRING = dayValue
    DIM timeText AS STRING = clockTime

    checksum = checksum + LEN(momentText) + LEN(instantText) + LEN(dateText) + LEN(timeText)
    checksum = checksum + YEAR(dayValue) + MONTH(dayValue) + DAY(dayValue)
    checksum = checksum + HOUR(clockTime) + MINUTE(clockTime) + SECOND(clockTime)

    IF ISDATE(sourceText) THEN
        checksum = checksum + 1
    END IF

    IF ISDATE(exchangeText) THEN
        checksum = checksum + 1
    END IF

    IF roundIndex <= 2 THEN
        digest = digest + momentText + instantText
    END IF
NEXT

PRINT checksum
PRINT LEN(digest)
