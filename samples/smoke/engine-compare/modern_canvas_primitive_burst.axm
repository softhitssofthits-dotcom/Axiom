' Детеминированная нагрузка на современный графический цикл без ручного ввода.
' Сценарий нужен для сравнения Interpreter и BytecodeVm на частых примитивах CANVAS.

DIM WIDTH AS INTEGER = 320
DIM HEIGHT AS INTEGER = 180
DIM FRAMES AS INTEGER = 48
DIM RECTS AS INTEGER = 24
DIM LINES AS INTEGER = 18
DIM CIRCLES AS INTEGER = 12

DIM frameIndex AS INTEGER
DIM rectIndex AS INTEGER
DIM lineIndex AS INTEGER
DIM circleIndex AS INTEGER
DIM colorBase AS INTEGER
DIM offsetX AS INTEGER
DIM offsetY AS INTEGER
DIM checksum AS LONG

CANVAS WIDTH, HEIGHT

FOR frameIndex = 1 TO FRAMES
    BEGINFRAME
    colorBase = (frameIndex * 9) MOD 255
    CLS RGB((colorBase * 3) MOD 255, (colorBase * 5) MOD 255, (colorBase * 7) MOD 255)

    CAMERA (frameIndex * 2) MOD 17, frameIndex MOD 11

    FOR rectIndex = 0 TO RECTS - 1
        offsetX = (rectIndex * 11 + frameIndex * 3) MOD 240
        offsetY = (rectIndex * 7 + frameIndex * 5) MOD 120
        FILLRECT offsetX, offsetY, 20 + (rectIndex MOD 9), 10 + (rectIndex MOD 7), RGB((colorBase + rectIndex * 13) MOD 255, (40 + rectIndex * 9) MOD 255, (120 + rectIndex * 5) MOD 255)
        DRAWRECT offsetX - 2, offsetY - 2, 24 + (rectIndex MOD 9), 14 + (rectIndex MOD 7), RGB(255, (colorBase + rectIndex * 3) MOD 255, 20)
        checksum = checksum + offsetX + offsetY
    NEXT

    FOR lineIndex = 0 TO LINES - 1
        DRAWLINE (lineIndex * 17 + frameIndex * 4) MOD WIDTH, 0, WIDTH - 1 - ((lineIndex * 9 + frameIndex * 3) MOD WIDTH), HEIGHT - 1, RGB((200 + lineIndex * 5) MOD 255, (80 + frameIndex * 7) MOD 255, (40 + lineIndex * 11) MOD 255)
        checksum = checksum + lineIndex
    NEXT

    FOR circleIndex = 0 TO CIRCLES - 1
        offsetX = 24 + ((circleIndex * 23 + frameIndex * 5) MOD 220)
        offsetY = 20 + ((circleIndex * 13 + frameIndex * 7) MOD 120)
        DRAWCIRCLE offsetX, offsetY, 6 + (circleIndex MOD 7), RGB((20 + circleIndex * 17) MOD 255, (220 + frameIndex * 3) MOD 255, (90 + circleIndex * 7) MOD 255)
        FILLCIRCLE offsetX + 8, offsetY + 5, 3 + (circleIndex MOD 5), RGB((240 + circleIndex * 9) MOD 255, (60 + circleIndex * 15) MOD 255, (30 + frameIndex * 9) MOD 255)
        checksum = checksum + offsetX + offsetY + circleIndex
    NEXT

    RESETCAMERA
    DRAWTEXT "Кадр " + TRIM(STR(frameIndex)) + " контроль " + TRIM(STR(checksum MOD 100000)), 8, 8, RGB(255, 255, 255)
    PRESENT
NEXT
