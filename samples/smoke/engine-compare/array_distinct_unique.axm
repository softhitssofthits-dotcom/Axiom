' Нагрузка: ARRAYDISTINCT на массиве с уникальными значениями.
DIM source[1 TO 6000] AS INTEGER
FOR index = 1 TO 6000
    source[index] = index * 13
NEXT

DIM distinctValues[] AS INTEGER
DIM total AS LONG = 0

FOR roundIndex = 1 TO 4
    distinctValues[] = ARRAYDISTINCT(source[])
    total = total + ARRAYLENGTH(distinctValues[])
    total = total + distinctValues[1] + distinctValues[ARRAYLENGTH(distinctValues[])]
NEXT

PRINT total
