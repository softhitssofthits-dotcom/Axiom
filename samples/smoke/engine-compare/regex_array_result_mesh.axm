' Нагрузка на встроенные функции регулярных выражений, возвращающие массивы, без цепочки замен.
' Программа собирает большой текстовый корпус и отдельно нагружает
' REGEXMATCHES, REGEXEXTRACTALL и REGEXSPLIT с режимом без учёта регистра.

DIM lines[] AS STRING
DIM corpus AS STRING
DIM matches[] AS STRING
DIM users[] AS STRING
DIM parts[] AS STRING

REDIM lines[1 TO 3200]

FOR lineIndex = 1 TO ARRAYLENGTH(lines[])
    lines[lineIndex] = BuildRegexEntry(lineIndex)
NEXT

corpus = JOIN(lines[], CHR(10))
matches[] = REGEXMATCHES(corpus, "code=(ERR\d{3}|WARN\d{3})", "i")
users[] = REGEXEXTRACTALL(corpus, "user=([A-Z]{2}\d{2})", 1, "i")
parts[] = REGEXSPLIT(corpus, "\r?\n", "i")

PRINT ARRAYLENGTH(matches[])
PRINT ARRAYLENGTH(users[])
PRINT ARRAYLENGTH(parts[])
PRINT matches[1]
PRINT matches[ARRAYLENGTH(matches[])]
PRINT users[1]
PRINT users[ARRAYLENGTH(users[])]
PRINT LEFT(parts[1], 15)
PRINT RIGHT(parts[ARRAYLENGTH(parts[])], 15)

FUNCTION BuildRegexEntry(lineIndex AS INTEGER) AS STRING
    DIM codeSelector AS INTEGER = lineIndex MOD 4
    DIM userSelector AS INTEGER = lineIndex MOD 6

    IF codeSelector = 0 THEN
        RETURN "level=INFO code=ERR101 user=" + GetUserId(userSelector) + " node=alpha path=/runtime/core"
    ELSEIF codeSelector = 1 THEN
        RETURN "level=warn code=warn205 user=" + GetUserId(userSelector) + " node=beta path=/docs/manual"
    ELSEIF codeSelector = 2 THEN
        RETURN "level=ERROR code=ERR302 user=" + GetUserId(userSelector) + " node=gamma path=/samples/regex"
    END IF

    RETURN "level=Warn code=WARN777 user=" + GetUserId(userSelector) + " node=delta path=/execution/pipeline"
END FUNCTION

FUNCTION GetUserId(selector AS INTEGER) AS STRING
    IF selector = 0 THEN
        RETURN "AB12"
    ELSEIF selector = 1 THEN
        RETURN "CD34"
    ELSEIF selector = 2 THEN
        RETURN "EF56"
    ELSEIF selector = 3 THEN
        RETURN "GH78"
    ELSEIF selector = 4 THEN
        RETURN "IJ90"
    END IF

    RETURN "KL11"
END FUNCTION
