' Сравнительный сценарий: клавиатурный подслой maze_chase без графики.
' Нагружает KEYPRESS, KEYDOWN и буквенные hotkey-проверки из логики игры
' без CANVAS, спрайтов и ручного участия пользователя.

DIM leftHeldCount AS LONG = 0
DIM keypressHitCount AS LONG = 0
DIM calibrationToggleCount AS LONG = 0
DIM statusChecksum AS LONG = 0
DIM directionChecksum AS LONG = 0

DIM DIR_LEFT AS INTEGER = 1
DIM DIR_RIGHT AS INTEGER = 2
DIM DIR_UP AS INTEGER = 3
DIM DIR_DOWN AS INTEGER = 4

FOR lapIndex = 1 TO 220
    FOR frameIndex = 1 TO 8
        IF CalibrationHotKeyPressed("K") THEN
            calibrationToggleCount = calibrationToggleCount + 1
        END IF

        IF KEYPRESS("SPACE") THEN
            keypressHitCount = keypressHitCount + 3
        END IF

        IF KEYPRESS("ESC") THEN
            keypressHitCount = keypressHitCount + 5
        END IF

        IF KEYDOWN("LEFT") THEN
            leftHeldCount = leftHeldCount + 1
            directionChecksum = directionChecksum + DIR_LEFT
        END IF

        directionChecksum = directionChecksum + ChooseDirectionByState(lapIndex, frameIndex)
        statusChecksum = statusChecksum + LenByHotKeys()
    NEXT
NEXT

PRINT leftHeldCount
PRINT keypressHitCount
PRINT calibrationToggleCount
PRINT statusChecksum + directionChecksum

FUNCTION ChooseDirectionByState(lapIndex AS INTEGER, frameIndex AS INTEGER) AS INTEGER
    IF KEYDOWN("LEFT") THEN
        RETURN DIR_LEFT
    END IF

    IF KEYPRESS("RIGHT") THEN
        RETURN DIR_RIGHT
    END IF

    IF KEYPRESS("UP") THEN
        RETURN DIR_UP
    END IF

    IF KEYPRESS("DOWN") THEN
        RETURN DIR_DOWN
    END IF

    RETURN (lapIndex + frameIndex) MOD 4
END FUNCTION

FUNCTION LenByHotKeys() AS INTEGER
    DIM statusText AS STRING = "Обычный игровой кадр."

    IF CalibrationHotKeyPressed("K") THEN
        statusText = "Калибровка включена."
    END IF

    IF CalibrationHotKeyPressed("A") THEN
        statusText = "Горячая клавиша A сработала."
    END IF

    IF CalibrationHotKeyPressed("B") THEN
        statusText = "Горячая клавиша B сработала."
    END IF

    RETURN LEN(statusText)
END FUNCTION

FUNCTION CalibrationHotKeyPressed(keyName AS STRING) AS BOOLEAN
    DIM altUpper AS STRING
    DIM altLower AS STRING

    IF KEYPRESS(keyName) THEN
        RETURN TRUE
    END IF

    altUpper = CalibrationAlternateUpper(keyName)
    IF altUpper <> "" THEN
        IF KEYPRESS(altUpper) THEN
            RETURN TRUE
        END IF
    END IF

    IF KEYPRESS(LCASE(keyName)) THEN
        RETURN TRUE
    END IF

    altLower = CalibrationAlternateLower(keyName)
    IF altLower <> "" THEN
        IF KEYPRESS(altLower) THEN
            RETURN TRUE
        END IF
    END IF

    RETURN FALSE
END FUNCTION

FUNCTION CalibrationAlternateUpper(keyName AS STRING) AS STRING
    SELECT CASE UCASE(keyName)
        CASE "K"
            RETURN "Л"
        CASE "A"
            RETURN "Ф"
        CASE "B"
            RETURN "И"
        CASE ELSE
            RETURN ""
    END SELECT
END FUNCTION

FUNCTION CalibrationAlternateLower(keyName AS STRING) AS STRING
    SELECT CASE UCASE(keyName)
        CASE "K"
            RETURN "л"
        CASE "A"
            RETURN "ф"
        CASE "B"
            RETURN "и"
        CASE ELSE
            RETURN ""
    END SELECT
END FUNCTION
