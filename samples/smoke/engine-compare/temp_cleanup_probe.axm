' Сравнительный сценарий: очистка временных файлов и каталогов.
' Нагружает прежде всего DELETEFILE и DELETEDIRRECURSIVE.

DIM checksum AS LONG = 0
DIM tempFilePayload AS STRING = "cleanup-file-content"
DIM rootFilePayload AS STRING = "cleanup-root-content"
DIM nestedFilePayload AS STRING = "cleanup-nested-content"

FOR passIndex = 1 TO 80
    DIM tempFile AS STRING = MAKETEMPFILE("temp-clean-file_")
    DIM tempDir AS STRING = MAKETEMPDIR("temp-clean-dir_")
    DIM nestedDir AS STRING = COMBINEPATH(tempDir, "nested")
    DIM rootFile AS STRING = COMBINEPATH(tempDir, "root.txt")
    DIM nestedFile AS STRING = COMBINEPATH(nestedDir, "nested.txt")

    IF MAKEDIR(nestedDir) THEN
        checksum = checksum + 1
    END IF

    IF WRITEFILE(tempFile, tempFilePayload) THEN
        checksum = checksum + 1
    END IF

    IF WRITEFILE(rootFile, rootFilePayload) THEN
        checksum = checksum + 1
    END IF

    IF WRITEFILE(nestedFile, nestedFilePayload) THEN
        checksum = checksum + 1
    END IF

    IF DELETEFILE(tempFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEFILE(rootFile) THEN
        checksum = checksum + 1
    END IF

    IF DELETEDIRRECURSIVE(tempDir) THEN
        checksum = checksum + 1
    END IF
NEXT

PRINT checksum
