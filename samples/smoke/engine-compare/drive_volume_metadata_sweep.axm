' Сравнительный сценарий: сведения о диске и корне пути.
' Нагружает FREESPACE, TOTALFREESPACE, TOTALSPACE,
' DRIVENAME, DRIVEFORMAT, DRIVETYPE и PATHROOT.

DIM driveTarget AS STRING = CURRENTDIR()
DIM checksum AS LONG = 0

FOR passIndex = 1 TO 120
    DIM rootPath AS STRING = PATHROOT(driveTarget)

    IF FREESPACE(driveTarget) > 0 THEN
        checksum = checksum + 1
    END IF

    IF TOTALFREESPACE(driveTarget) > 0 THEN
        checksum = checksum + 1
    END IF

    IF TOTALSPACE(driveTarget) > 0 THEN
        checksum = checksum + 1
    END IF

    checksum = checksum + LEN(rootPath)
    checksum = checksum + LEN(DRIVENAME(driveTarget))
    checksum = checksum + LEN(DRIVEFORMAT(driveTarget))
    checksum = checksum + LEN(DRIVETYPE(driveTarget))
NEXT

PRINT checksum
