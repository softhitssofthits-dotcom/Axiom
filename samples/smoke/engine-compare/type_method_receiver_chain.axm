' нагрузка на методы TYPE с составным получателем:
' поле вложенной записи и элемент массива записей, адресуемый SELF,
' повторные вызовы в цикле

TYPE Cell
    Value AS LONG
    Weight AS LONG

    SUB Accumulate(delta AS LONG)
        SELF.Value = SELF.Value + delta
        SELF.Weight = SELF.Weight + 1
    END SUB
END TYPE

TYPE Board
    Origin AS Cell
    Cells[1 TO 16] AS Cell
END TYPE

DIM board AS Board
DIM total AS LONG = 0

FOR pass = 1 TO 400
    board.Origin.Accumulate(pass)

    FOR i = 1 TO 16
        board.Cells[i].Accumulate(i + (pass MOD 5))
    NEXT

    IF pass MOD 8 = 0 THEN
        total = total + board.Origin.Weight
    END IF
NEXT

PRINT board.Origin.Value
PRINT board.Cells[16].Value
PRINT board.Cells[16].Weight
PRINT total
