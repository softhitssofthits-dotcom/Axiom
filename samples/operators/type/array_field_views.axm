' Подмассивы и диапазонные представления через поле TYPE работают так же,
' как для обычного массива: результат разделяет то же хранилище.
' Ожидаемый вывод:
' 23
' 24
' 2
' 4
' 4
' 99

TYPE Board
    Cells(,) AS INTEGER
END TYPE

DIM board AS Board
DIM lineView() AS INTEGER
DIM window(,) AS INTEGER

REDIM board.Cells(1 TO 3, 1 TO 4)
board.Cells(2, 3) = 23

lineView = board.Cells(2)
PRINT lineView(3)
lineView(4) = 24
PRINT board.Cells(2, 4)

window = board.Cells(2 TO 3, 3 TO 4)
PRINT LBOUND(window, 1)
PRINT UBOUND(window, 2)
PRINT ARRAYLENGTH(window)
window(3, 3) = 99
PRINT board.Cells(3, 3)
