' ON KEY STOP ставит обработчик на паузу, а ON снова включает его.
PRINT "Нажмите LEFT на паузе, затем LEFT после возобновления, затем ESC."

ON KEY("LEFT"), HandleLeft
ON KEY("LEFT"), STOP

DIM firstKey AS STRING = ""

DO WHILE firstKey <> "LEFT"
    firstKey = INKEY()
LOOP

PRINT firstKey

ON KEY("LEFT"), ON

DIM marker AS INTEGER = 0

DO WHILE NOT KEYPRESS("ESC")
    marker = marker + 1
LOOP

ON KEY("LEFT"), OFF
PRINT "готово"

SUB HandleLeft()
    PRINT "обработчик LEFT"
END SUB
