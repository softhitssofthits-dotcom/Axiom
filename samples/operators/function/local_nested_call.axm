' Эта программа показывает, что внутри FUNCTION можно объявить
' вложенную функцию и вызывать её до текстового объявления.

PRINT Outer(10)

FUNCTION Outer(base AS INTEGER) AS INTEGER
    RETURN AddTwo(base)

    FUNCTION AddTwo(value AS INTEGER) AS INTEGER
        RETURN value + 2
    END FUNCTION
END FUNCTION
