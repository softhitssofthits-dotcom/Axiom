' Эта программа показывает, что функцию можно хранить в переменной
' функционального типа и передавать в параметр другой функции.
' Ожидаемый вывод: 12.
DIM action AS FUNCTION (INTEGER) AS INTEGER
action = DoubleValue
PRINT ApplyTwice(action, 3)

FUNCTION ApplyTwice(op AS FUNCTION (INTEGER) AS INTEGER, value AS INTEGER) AS INTEGER
    RETURN op(op(value))
END FUNCTION

FUNCTION DoubleValue(value AS INTEGER) AS INTEGER
    RETURN value * 2
END FUNCTION
