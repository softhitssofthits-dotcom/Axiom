' PUT в CANVAS возвращает буфер в мировую точку через CAMERA и VIEWPORT.
CANVAS 24, 18
CLS RGB(0, 0, 0)

' Экран показывает только кусок мира.
VIEWPORT (10, 6)-(15, 11)
CAMERA 100, 50

DIM buffer(1 TO 2, 5 TO 6) AS INTEGER

' Готовим маленький буфер вручную.
buffer(1, 5) = 6
buffer(2, 5) = 9
buffer(1, 6) = 12
buffer(2, 6) = 15

' Возвращаем буфер в мировую точку.
PUT (100, 50), buffer, PSET

' Проверяем физические пиксели внутри viewport.
PRINT POINT(10, 6)
PRINT POINT(11, 6)
PRINT POINT(10, 7)
PRINT POINT(11, 7)

PRESENT
SLEEP 500
