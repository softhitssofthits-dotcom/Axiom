' Ручная проверка: перемещайте указатель и отпустите левую кнопку мыши в окне SCREEN; для завершения нажмите ESC.
SCREEN 1
PRINT "Двигайте указатель и отпустите левую кнопку в окне SCREEN. Для завершения нажмите ESC."
DIM moveSeen AS BOOLEAN = FALSE
DIM moveX AS LONG = 0
DIM moveY AS LONG = 0
DIM upSeen AS BOOLEAN = FALSE
DIM upButton AS INTEGER = 0
DIM upX AS LONG = 0
DIM upY AS LONG = 0
ON MOUSE("MOVE"), HandleMove
ON MOUSE(1, "UP"), HandleUp
DIM marker AS INTEGER = 0

DO WHILE NOT KEYPRESS("ESC")
    marker = marker + 1
LOOP

SCREEN 0
PRINT moveSeen
PRINT moveX
PRINT moveY
PRINT upSeen
PRINT upButton
PRINT upX
PRINT upY
PRINT "Готово"

SUB HandleMove(button AS INTEGER, x AS LONG, y AS LONG)
    moveSeen = TRUE
    moveX = x
    moveY = y
END SUB

SUB HandleUp(button AS INTEGER, x AS LONG, y AS LONG)
    upSeen = TRUE
    upButton = button
    upX = x
    upY = y
END SUB
