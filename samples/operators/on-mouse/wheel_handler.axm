' Ручная проверка: прокрутите колесо мыши внутри SCREEN, затем нажмите ESC.
SCREEN 1
PRINT "Прокрутите колесо мыши в окне SCREEN. Для завершения нажмите ESC."
DIM wheelSeen AS BOOLEAN = FALSE
DIM wheelDelta AS INTEGER = 0
DIM wheelX AS LONG = 0
DIM wheelY AS LONG = 0
ON MOUSE("WHEEL"), HandleWheel

DO WHILE NOT KEYPRESS("ESC")
    DIM idle AS INTEGER = 1
    SLEEP 1
LOOP

SCREEN 0
PRINT wheelSeen
PRINT wheelDelta
PRINT wheelX
PRINT wheelY
PRINT "Готово"

SUB HandleWheel(delta AS INTEGER, x AS LONG, y AS LONG)
    wheelSeen = TRUE
    wheelDelta = delta
    wheelX = x
    wheelY = y
    LOCATE 3, 1
    PRINT "Колесо="; delta; " x="; x; " y="; y; "                    "
END SUB
