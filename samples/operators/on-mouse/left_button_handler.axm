' Ручная проверка: нажмите левую кнопку мыши внутри окна SCREEN, затем нажмите ESC.
SCREEN 1
PRINT "Нажмите левую кнопку мыши в окне SCREEN. Для завершения нажмите ESC."
DIM seen AS BOOLEAN = FALSE
DIM seenButton AS INTEGER = 0
DIM seenX AS LONG = 0
DIM seenY AS LONG = 0
ON MOUSE(1), HandleMouse
DIM marker AS INTEGER = 0

DO WHILE NOT KEYPRESS("ESC")
    marker = marker + 1
    SLEEP 1
LOOP

SCREEN 0
PRINT seen
PRINT seenButton
PRINT seenX
PRINT seenY
PRINT "Готово"

SUB HandleMouse(button AS INTEGER, x AS LONG, y AS LONG)
    seen = TRUE
    seenButton = button
    seenX = x
    seenY = y
    LOCATE 3, 1
    PRINT "Кнопка="; button; " x="; x; " y="; y; "                    "
END SUB
