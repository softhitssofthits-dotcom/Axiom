' Невидимые фигуры пропускаются, большая диагональ сохраняет пиксели.
SCREEN 1
LINE (1000, 1000)-(1000000000, 1000000000), 12, BF
LINE (-1000000000, -1000000000)-(-1, -1), 12, B
LINE (-1000000000, -1000000000)-(1000000000, 1000000000), 10
PRINT "Диагональ: "; POINT(80, 80) = 10
VIEW SCREEN (20, 40)-(100, 120)
WINDOW SCREEN (0, 0)-(80, 80)
LINE (-1000000, 40)-(1000000, 40), 14
PRINT "Линия с VIEW/WINDOW: "; POINT(40, 40) = 14
SLEEP
