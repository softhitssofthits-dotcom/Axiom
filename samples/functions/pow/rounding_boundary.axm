' POW использует готовую Math.Pow; последний разряд зависит от среды .NET.
DIM minimum AS DOUBLE = VAL("5e-324")

' Степень -1074 даёт минимальное положительное значение DOUBLE.
PRINT "Минимальная положительная степень: "; POW(2, -1074)

' Точное значение находится посередине между нулём и minimum.
DIM halfway AS DOUBLE = POW(2, -1075)
PRINT "Результат на середине в этой среде: "; halfway
PRINT "Результат в проверенном интервале: "; halfway >= 0 AND halfway <= minimum

' Более маленькая степень уходит к нулю без ошибки.
PRINT "Ещё меньшая степень: "; POW(2, -1076)
