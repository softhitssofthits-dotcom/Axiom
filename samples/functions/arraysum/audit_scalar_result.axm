' Проверка исправления LA26-001: результат суммы имеет тип INTEGER.
DIM numbers[1 TO 2] AS INTEGER
numbers[1] = 2
numbers[2] = 3
' Проверяем использование результата в обычном присваивании.
DIM total AS INTEGER
total = ARRAYSUM(numbers[])
PRINT "Сумма должна равняться пяти:", total
' Результаты минимума и максимума также являются отдельными числами.
DIM smallest AS INTEGER = ARRAYMIN(numbers[])
DIM largest = ARRAYMAX(numbers[])
PRINT "Минимум равен двум:", smallest
PRINT "Максимум равен трём:", largest
PRINT "Сумма, увеличенная на единицу:", total + 1
