' Проверка исправления: CINT сначала отбрасывает дробную часть.
' Ожидаются 2147483647 и -2147483648.
TRY
    ' Усечённое положительное значение помещается в INTEGER.
    PRINT CINT(2147483647.9)
CATCH err
    PRINT "Ошибка положительной границы:", err.Code
END TRY
TRY
    ' Усечённое отрицательное значение также помещается в INTEGER.
    PRINT CINT(-2147483648.9)
CATCH err
    PRINT "Ошибка отрицательной границы:", err.Code
END TRY
