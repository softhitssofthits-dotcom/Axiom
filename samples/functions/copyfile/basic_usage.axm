' Создаёт исходный файл и его копию в отдельной временной папке.
DIM folder AS STRING = MAKETEMPDIR("axiom_copy_")
DIM source AS STRING = COMBINEPATH(folder, "source.txt")
DIM target AS STRING = COMBINEPATH(folder, "copy.txt")

' Создаём исходный файл с коротким текстом.
PRINT WRITEFILE(source, "Привет")
' Копируем исходник и разрешаем заменить оставшийся файл от прошлого запуска.
PRINT COPYFILE(source, target, TRUE)
' Читаем копию и убеждаемся, что в ней сохранился текст.
PRINT READFILE(target)
' Удаляем оба временных файла.
DELETEFILE(source)
DELETEFILE(target)
DELETEDIR(folder)
