' ARRAYBINARYSEARCH ищет значение в уже отсортированном массиве
' и возвращает первый логический индекс совпадения.
' Если значения нет, функция возвращает 0.
' Ожидаемый вывод:
' 6
' 9
' 0
DIM values(5 TO 9) AS INTEGER

values(5) = 10
values(6) = 20
values(7) = 20
values(8) = 20
values(9) = 30

PRINT ARRAYBINARYSEARCH(values, 20)
PRINT ARRAYBINARYSEARCH(values, 30)
PRINT ARRAYBINARYSEARCH(values, 15)
