' ARRAYINSERT по COLUMN вставляет новый столбец по логическому индексу.
DIM board[1 TO 2, 10 TO 11] AS INTEGER
DIM insertedColumn[1 TO 2] AS INTEGER

board[1, 10] = 110
board[1, 11] = 111
board[2, 10] = 210
board[2, 11] = 211

insertedColumn[1] = 115
insertedColumn[2] = 215

ARRAYINSERT(board[], 11, insertedColumn[], COLUMN)

PRINT LBOUND(board[], COLUMN)
PRINT UBOUND(board[], COLUMN)
PRINT board[1, 10]
PRINT board[1, 11]
PRINT board[1, 12]
PRINT board[2, 10]
PRINT board[2, 11]
PRINT board[2, 12]
