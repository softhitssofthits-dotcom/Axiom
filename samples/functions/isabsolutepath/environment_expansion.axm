' На Windows переменная TEMP обычно содержит полный путь к временному каталогу.
' Пример ничего не создаёт: функции только разбирают строку пути.
DIM path AS STRING = "%TEMP%\данные.txt"
' COMBINEPATH сохраняет имя переменной буквально.
PRINT "Соединение без раскрытия: "; COMBINEPATH("%TEMP%", "данные.txt")
' FULLPATH раскрывает переменную и возвращает полный путь.
PRINT "Полный путь: "; FULLPATH(path)
' ISABSOLUTEPATH проверяет абсолютность после раскрытия переменной.
PRINT "Абсолютность после раскрытия: "; ISABSOLUTEPATH(path)
