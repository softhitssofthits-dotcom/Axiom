' Создаёт файл и переносит его в текущей рабочей папке.
DIM folder AS STRING = MAKETEMPDIR("axiom_move_")
DIM source AS STRING = COMBINEPATH(folder, "source.txt")
DIM target AS STRING = COMBINEPATH(folder, "target.txt")

' Создаём исходник, затем переносим его по новому пути.
PRINT WRITEFILE(source, "Привет")
PRINT MOVEFILE(source, target, TRUE)
' После переноса старого пути нет, а нового — есть.
PRINT FILEEXISTS(source)
PRINT FILEEXISTS(target)
DELETEFILE(target)
DELETEDIR(folder)
