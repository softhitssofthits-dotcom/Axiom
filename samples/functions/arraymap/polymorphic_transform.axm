' ARRAYMAP acceptance sample for polymorphic INTEGER -> STRING transformation.
' Expected output:
' 1
' 3
' item:10
' item:20
' item:30
DIM values(5 TO 7) AS INTEGER
DIM prefix AS STRING = "item:"
DIM mapped() AS STRING

values(5) = 10
values(6) = 20
values(7) = 30

mapped = ARRAYMAP(values, FormatValue)
PRINT LBOUND(mapped)
PRINT UBOUND(mapped)
PRINT mapped(1)
PRINT mapped(2)
PRINT mapped(3)

FUNCTION FormatValue(value AS INTEGER) AS STRING
    RETURN prefix + STR(value)
END FUNCTION
