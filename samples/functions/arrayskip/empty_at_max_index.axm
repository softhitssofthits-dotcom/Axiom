' Массив содержит один элемент, несмотря на большой индекс.
DIM values(2147483647 TO 2147483647, 7 TO 7) AS INTEGER
DIM part(,) AS INTEGER
' Пропускаем единственный элемент первого измерения.
part = ARRAYSKIP(values, 1, 1)
PRINT "Элементов осталось: "; ARRAYLENGTH(part)
PRINT "Ранг сохранён: "; ARRAYRANK(part)
' За крайней границей INTEGER используется пустой диапазон 1 TO 0.
PRINT "Нижняя пустая граница: "; LBOUND(part, 1)
PRINT "Верхняя пустая граница: "; UBOUND(part, 1)
' Второе измерение сохраняет исходные индексы.
PRINT "Другое измерение сохранено: "; LBOUND(part, 2) = 7 AND UBOUND(part, 2) = 7
