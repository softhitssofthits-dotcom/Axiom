' ARRAYREMOVE по COLUMN удаляет столбец и возвращает его как отдельный массив.
DIM board[1 TO 2, 10 TO 12] AS INTEGER
DIM removedColumn[] AS INTEGER

board[1, 10] = 110
board[1, 11] = 111
board[1, 12] = 112
board[2, 10] = 210
board[2, 11] = 211
board[2, 12] = 212

removedColumn[] = ARRAYREMOVE(board[], 11, COLUMN)

PRINT removedColumn[1]
PRINT removedColumn[2]
PRINT LBOUND(board[], COLUMN)
PRINT UBOUND(board[], COLUMN)
PRINT board[1, 10]
PRINT board[1, 11]
PRINT board[2, 10]
PRINT board[2, 11]
