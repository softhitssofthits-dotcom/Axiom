' ARRAYFLATTEN превращает видимые элементы массива в новый компактный 1D-массив.

DIM board(1 TO 2, 10 TO 12) AS INTEGER
DIM flat() AS INTEGER

board(1, 10) = 3
board(1, 11) = 1
board(1, 12) = 2
board(2, 10) = 6
board(2, 11) = 4
board(2, 12) = 5

flat = ARRAYFLATTEN(board)

PRINT LBOUND(flat)
PRINT UBOUND(flat)
PRINT flat(1)
PRINT flat(2)
PRINT flat(3)
PRINT flat(4)
PRINT flat(5)
PRINT flat(6)
