' ARRAYDISTINCT сохраняет порядок первого вхождения значений.
' Ожидаемый вывод:
' уникальных 5
' 3 1 2 4 5

DIM values(1 TO 8) AS INTEGER
values(1) = 3
values(2) = 1
values(3) = 3
values(4) = 2
values(5) = 1
values(6) = 4
values(7) = 2
values(8) = 5

DIM distinctValues() AS INTEGER
distinctValues = ARRAYDISTINCT(values)

PRINT "уникальных "; ARRAYLENGTH(distinctValues)
FOR index = 1 TO ARRAYLENGTH(distinctValues)
    PRINT distinctValues(index);
NEXT
