' ARRAYREVERSE разворачивает выделенный массив на месте
' и сохраняет его исходные границы.
' Ожидаемый вывод:
' 5
' 8
' 40
' 10
DIM values(5 TO 8) AS INTEGER

values(5) = 10
values(6) = 20
values(7) = 30
values(8) = 40

ARRAYREVERSE(values)

PRINT LBOUND(values)
PRINT UBOUND(values)
PRINT values(5)
PRINT values(8)
