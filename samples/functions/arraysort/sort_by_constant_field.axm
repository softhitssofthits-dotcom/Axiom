' Имя поля сортировки может быть строковой константой,
' известной при проверке программы. Ожидаемый вывод:
' 20 30 40
' апельсин
TYPE Product
    Name AS STRING
    Price AS INTEGER
END TYPE

' Значение константы известно до выполнения, поэтому опечатка
' в имени поля обнаружится ещё при проверке программы.
CONST priceField AS STRING = "Price"
CONST selectedField AS STRING = (priceField)

DIM basket[1 TO 3] AS Product
basket[1] = Product("яблоко", 30)
basket[2] = Product("апельсин", 40)
basket[3] = Product("банан", 20)

' Сортировка по цене через константное имя поля.
ARRAYSORT(basket[], selectedField)
PRINT basket[1].Price; " "; basket[2].Price; " "; basket[3].Price

' Скобки вокруг строкового литерала тоже допустимы.
ARRAYSORT(basket[], ("Name"))
PRINT basket[1].Name
