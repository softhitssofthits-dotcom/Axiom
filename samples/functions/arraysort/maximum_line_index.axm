REM Два столбца заканчиваются последним допустимым индексом INTEGER.
DIM values[7 TO 7, 2147483646 TO 2147483647] AS INTEGER
DIM sorted[,] AS INTEGER
values[7, 2147483646] = 30
values[7, 2147483647] = 10
REM Сортируем копию: исходное первое значение остаётся 30.
sorted[] = ARRAYTOSORTED(values[], 2)
PRINT "Отсортированная копия, ожидается 10 и 30:"
PRINT sorted[7, 2147483646]
PRINT sorted[7, 2147483647]
PRINT "Первое исходное значение осталось 30:"
PRINT values[7, 2147483646]
REM Теперь сортируем исходный массив по столбцам.
ARRAYSORT(values[], 2)
PRINT "Исходный массив после сортировки, ожидается 10 и 30:"
PRINT values[7, 2147483646]
PRINT values[7, 2147483647]
