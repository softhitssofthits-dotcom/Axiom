' ARRAYSORT для ранга 2+ требует dimension и сортирует каждую линию отдельно.

DIM board(1 TO 2, 1 TO 3) AS INTEGER

board(1, 1) = 4
board(1, 2) = 2
board(1, 3) = 6
board(2, 1) = 3
board(2, 2) = 1
board(2, 3) = 5

ARRAYSORT(board, COLUMN)

PRINT board(1, 1)
PRINT board(1, 2)
PRINT board(1, 3)
PRINT board(2, 1)
PRINT board(2, 2)
PRINT board(2, 3)
