' ARRAYSORT сортирует выделенный массив на месте и сохраняет его границы.
' Ожидаемый вывод:
' 5
' 9
' 10
' 30
DIM values[5 TO 9] AS INTEGER

values[5] = 30
values[6] = 10
values[7] = 20
values[8] = 20
values[9] = 10

ARRAYSORT(values[])

PRINT LBOUND(values[])
PRINT UBOUND(values[])
PRINT values[5]
PRINT values[9]
