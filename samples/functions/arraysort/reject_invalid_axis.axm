' У одномерного массива есть только измерение 1.
DIM values[1 TO 3] AS INTEGER
values[1] = 30
values[2] = 10
values[3] = 20
' Ошибка измерения не должна менять порядок элементов.
TRY
    ARRAYSORT(values[], 2)
CATCH err
    PRINT "Неверное измерение: "; err.Code
END TRY
PRINT "Первое значение после отказа: "; values[1]
' Допустимый номер позволяет отсортировать тот же массив.
ARRAYSORT(values[], 1)
PRINT "Первое значение после сортировки: "; values[1]
