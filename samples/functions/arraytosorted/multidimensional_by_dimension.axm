' ARRAYTOSORTED для ранга 2+ создаёт новую копию и сортирует выбранное измерение.

DIM board(1 TO 2, 1 TO 3) AS INTEGER
DIM sortedBoard(,) AS INTEGER

board(1, 1) = 4
board(1, 2) = 2
board(1, 3) = 6
board(2, 1) = 3
board(2, 2) = 1
board(2, 3) = 5

sortedBoard = ARRAYTOSORTED(board, ROW)

PRINT board(1, 1)
PRINT sortedBoard(1, 1)
PRINT sortedBoard(1, 2)
PRINT sortedBoard(2, 2)
