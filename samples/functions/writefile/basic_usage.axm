' WRITEFILE создаёт или перезаписывает текстовый файл.
DIM path AS STRING = MAKETEMPFILE("axiom_write_")

' Первую запись создаёт файл с фразой «Привет, мир!».
PRINT WRITEFILE(path, "Привет, мир!")
PRINT READFILE(path)
' Вторая запись заменяет его содержимое целиком.
PRINT WRITEFILE(path, "Новый текст")
PRINT READFILE(path)
DELETEFILE(path)
