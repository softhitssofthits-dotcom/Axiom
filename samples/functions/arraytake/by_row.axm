' ARRAYTAKE по ROW оставляет верхние строки
' и создаёт новую независимую копию.

DIM grid[1 TO 3, 10 TO 11] AS INTEGER
DIM topRows[,] AS INTEGER

grid[1, 10] = 110
grid[1, 11] = 111
grid[2, 10] = 210
grid[2, 11] = 211
grid[3, 10] = 310
grid[3, 11] = 311

topRows[] = ARRAYTAKE(grid[], 2, ROW)
topRows[1, 10] = 999

PRINT LBOUND(topRows[], ROW)
PRINT UBOUND(topRows[], ROW)
PRINT LBOUND(topRows[], COLUMN)
PRINT UBOUND(topRows[], COLUMN)
PRINT topRows[2, 11]
PRINT grid[1, 10]
