' ARRAYFINDALL для 2D-массива возвращает таблицу координат INTEGER(,).
' Ожидается:
' 1
' 3
' 1
' 2
' 1
' 6
' 2
' 6
' 2
' 7
' 1
' 0
' 1
' 2

DIM board[1 TO 2, 5 TO 7] AS INTEGER
DIM hits[,] AS INTEGER
DIM missing[,] AS INTEGER

board[1, 5] = 10
board[1, 6] = 20
board[2, 6] = 20
board[2, 7] = 20

hits[] = ARRAYFINDALL(board[], 20)
missing[] = ARRAYFINDALL(board[], 99)

PRINT LBOUND(hits[], 1)
PRINT UBOUND(hits[], 1)
PRINT LBOUND(hits[], 2)
PRINT UBOUND(hits[], 2)
PRINT hits[1, 1]
PRINT hits[1, 2]
PRINT hits[2, 1]
PRINT hits[2, 2]
PRINT hits[3, 1]
PRINT hits[3, 2]
PRINT LBOUND(missing[], 1)
PRINT UBOUND(missing[], 1)
PRINT LBOUND(missing[], 2)
PRINT UBOUND(missing[], 2)
