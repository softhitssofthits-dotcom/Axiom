' Пустой результат выборки всегда имеет канонические границы 1 TO 0.
' Ожидаемый вывод:
' длина 0
' границы 1..0
' другие измерения 1..3

DIM grid[1 TO 2, 1 TO 3] AS INTEGER

DIM cut[,] AS INTEGER
cut[] = ARRAYSLICE(grid[], 99, 0, 1)   ' Нулевое количество: начало не важно.

PRINT "длина "; ARRAYLENGTH(cut[])
PRINT "границы "; LBOUND(cut[], 1); ".."; UBOUND(cut[], 1)
PRINT "другие измерения "; LBOUND(cut[], 2); ".."; UBOUND(cut[], 2)
