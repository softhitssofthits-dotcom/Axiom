' Независимая копия множества и отдельные объявления.
' Обычное присваивание копирует множество: изменение копии
' не меняет исходный набор элементов.
' Два отдельных объявления создают два разных пустых множества.
' Ожидаемый вывод:
' через первое имя: 1
' через второе имя: 2
' FALSE
' первое: 1
' второе: 0
' FALSE

DIM found AS HASHSET(STRING)
found.Add("ключ")

' Второй переменной передаётся независимая копия.
DIM alias AS HASHSET(STRING)
alias = found

' Добавление изменяет только копию.
alias.Add("монета")
PRINT "через первое имя: "; found.Count
PRINT "через второе имя: "; alias.Count
PRINT found.Contains("монета")

' Каждое объявление создаёт собственное пустое множество.
DIM first AS HASHSET(STRING)
DIM second AS HASHSET(STRING)
first.Add("ключ")

' Заполнение первого множества не затрагивает второе.
PRINT "первое: "; first.Count
PRINT "второе: "; second.Count
PRINT second.Contains("ключ")
