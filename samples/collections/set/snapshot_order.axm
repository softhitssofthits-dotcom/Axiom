' Независимый снимок и порядок элементов множества.
' ToArray() возвращает отдельный массив с границами 1..Count. Поздние
' изменения множества этот массив не меняют. Порядок задаётся первым
' добавлением, повторный Add место не меняет, а удаление с повторным
' добавлением переносит элемент в конец.
' Ожидаемый вывод:
' снимок: ключ монета
' границы снимка: 1..2
' текущий: монета карта
' снимок после правок: ключ монета
' повтор Add монеты: FALSE
' ключ вернулся в конец: монета карта ключ

DIM found AS HASHSET(STRING)

' Порядок первого добавления: ключ, затем монета.
found.Add("ключ")
found.Add("монета")

' Снимок отделяется от множества уже здесь.
DIM snapshot[] AS STRING = found.ToArray()
PRINT "снимок: "; snapshot[1]; " "; snapshot[2]

' У непустого снимка нижняя граница 1, верхняя равна числу элементов.
PRINT "границы снимка: "; LBOUND(snapshot[]); ".."; UBOUND(snapshot[])

' Удаление освобождает место, новая карта встаёт после оставшейся монеты.
found.Remove("ключ")
found.Add("карта")
DIM current[] AS STRING = found.ToArray()
PRINT "текущий: "; current[1]; " "; current[2]

' Прежний массив сохранил и состав, и порядок на момент получения.
PRINT "снимок после правок: "; snapshot[1]; " "; snapshot[2]

' Повторное добавление уже имеющейся монеты возвращает FALSE и не переставляет её.
PRINT "повтор Add монеты: "; found.Add("монета")

' Ключ добавлен заново после удаления, поэтому теперь он в конце.
found.Add("ключ")
DIM reordered[] AS STRING = found.ToArray()
PRINT "ключ вернулся в конец: "; reordered[1]; " "; reordered[2]; " "; reordered[3]

SLEEP 2000
