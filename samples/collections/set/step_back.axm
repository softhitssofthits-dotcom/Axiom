' Пошаговая отладка операций множества и обратный шаг.
' Поставьте точку останова на строке PRINT "шаг 7, элементов: " и дойдите до неё.
' Затем выполните шаг назад и проверьте состояние перед пересечением:
' bag.Count равно 3, bag.Contains("фонарь") даёт TRUE,
' bag.ToArray() даёт ключ, карта, фонарь.
' После шага вперёд и продолжения запуска вывод совпадает с обычным.
' Ожидаемый вывод:
' шаг 1, элементов: 1
' шаг 2, элементов: 2
' шаг 3, элементов: 3
' удаление монеты: TRUE
' шаг 4, элементов: 2
' шаг 5, элементов: 3
' шаг 6, порядок: ключ карта фонарь
' шаг 7, элементов: 2
' шаг 8, порядок: ключ карта
' фонарь остался: FALSE

DIM bag AS HASHSET(STRING)

' Шаг 1: первое добавление задаёт место элемента.
bag.Add("ключ")
PRINT "шаг 1, элементов: "; bag.Count

' Шаг 2: второй элемент встаёт после первого.
bag.Add("монета")
PRINT "шаг 2, элементов: "; bag.Count

' Шаг 3: третий элемент встаёт в конец.
bag.Add("карта")
PRINT "шаг 3, элементов: "; bag.Count

' Удаление имеющегося элемента уменьшает Count на единицу.
PRINT "удаление монеты: "; bag.Remove("монета")
PRINT "шаг 4, элементов: "; bag.Count

' Объединение добавляет только отсутствующие элементы: фонарь новый, ключ уже был.
DIM extra AS HASHSET(STRING)
extra.Add("фонарь")
extra.Add("ключ")
bag.UnionWith(extra)
PRINT "шаг 5, элементов: "; bag.Count

' Порядок после объединения: прежние элементы, затем новые из второго множества.
DIM afterUnion[] AS STRING = bag.ToArray()
PRINT "шаг 6, порядок: "; afterUnion[1]; " "; afterUnion[2]; " "; afterUnion[3]

' Пересечение оставляет общие элементы в порядке получателя.
DIM keep AS HASHSET(STRING)
keep.Add("ключ")
keep.Add("карта")
bag.IntersectWith(keep)
PRINT "шаг 7, элементов: "; bag.Count

DIM afterIntersect[] AS STRING = bag.ToArray()
PRINT "шаг 8, порядок: "; afterIntersect[1]; " "; afterIntersect[2]

' Фонаря нет во втором множестве, поэтому после пересечения он удалён.
PRINT "фонарь остался: "; bag.Contains("фонарь")

SLEEP 2000
