' Ценник магазина: типизированный словарь связывает название товара с ценой.
' Словарь объявляется с типами ключа и значения и сразу готов к заполнению.
' Ожидаемый вывод:
' 30
' 2
' яблоко: 30 руб.
' груша: 50 руб.
' апельсина нет

DIM prices AS DICTIONARY(STRING, INTEGER)

' Add добавляет новую запись; повторный ключ сообщил бы ошибку.
prices.Add("яблоко", 30)
prices.Add("груша", 45)
prices.Add("апельсин", 40)

' Чтение по ключу возвращает цену товара.
PRINT prices["яблоко"]

' Присваивание по ключу заменяет цену и сохраняет место товара в порядке.
prices["груша"] = 50

' Remove возвращает TRUE при удалении и FALSE при отсутствии ключа.
PRINT prices.Remove("апельсин")
PRINT prices.Count

' Обход идёт по снимку ключей в порядке добавления товаров.
FOR EACH fruit IN prices.Keys()
    PRINT $"{fruit}: {prices[fruit]} руб."
NEXT fruit

' Отсутствие товара отличается от товара с нулевой ценой.
DIM price AS INTEGER
IF prices.TryGetValue("апельсин", price) THEN
    PRINT "апельсин стоит "; price
ELSE
    PRINT "апельсина нет"
END IF

SLEEP 2000
