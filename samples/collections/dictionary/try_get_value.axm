' Поиск без исключения: TryGetValue отличает найденную нулевую цену
' от отсутствующего товара. При отсутствии ключа переменная получает
' значение по умолчанию своего типа, а запись не добавляется.
' Ожидаемый вывод:
' найдено: 0
' нет товара, значение: 0
' записей: 1

DIM prices AS DICTIONARY(STRING, INTEGER)
prices.Add("бесплатный", 0)

DIM price AS INTEGER

' Товар есть, но его цена равна нулю: результат TRUE.
IF prices.TryGetValue("бесплатный", price) THEN
    PRINT "найдено: "; price
ELSE
    PRINT "нет товара"
END IF

' Товара нет: результат FALSE, а переменная содержит ноль.
IF prices.TryGetValue("слива", price) THEN
    PRINT "найдено: "; price
ELSE
    PRINT "нет товара, значение: "; price
END IF

' Отсутствующий ключ не добавлен в словарь.
PRINT "записей: "; prices.Count

SLEEP 2000
