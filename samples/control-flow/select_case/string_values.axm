' Пример показывает SELECT CASE со строковыми значениями.
' При команде «СОХРАНИТЬ» ожидается соответствующее русское сообщение.
DIM command AS STRING = "СОХРАНИТЬ"

SELECT CASE command
    CASE "ОТКРЫТЬ"
        PRINT "Открыть файл"
    CASE "СОХРАНИТЬ"
        PRINT "Сохранить файл"
    CASE ELSE
        PRINT "Неизвестная команда"
END SELECT
