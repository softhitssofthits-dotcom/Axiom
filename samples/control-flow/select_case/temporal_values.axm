' Пример показывает SELECT CASE по временным значениям трёх видов.
' Точное значение, CASE IS и диапазон TO работают внутри одного вида:
' DATE сравнивается с DATE, TIME с TIME, DATETIME с DATETIME.
' Смешивать виды и передавать полный текст даты-времени вместо DATE нельзя.
' Ожидается вывод:
' февраль
' до полудня и в полдень
' не раньше момента

DIM dayValue AS DATE = "2024-02-29"
DIM clockTime AS TIME = "12:34:56"
DIM moment AS DATETIME = "2024-02-29 12:34:56"

' Диапазон TO включает обе границы, поэтому 29 февраля попадает в февраль.
SELECT CASE dayValue
    CASE "2024-03-01" TO "2024-03-31"
        PRINT "март"
    CASE "2024-02-01" TO "2024-02-29"
        PRINT "февраль"
END SELECT

' Проверка отношения через CASE IS использует то же сравнение, что и обычный оператор.
SELECT CASE clockTime
    CASE IS > "18:00:00"
        PRINT "вечер"
    CASE IS <= "12:34:56"
        PRINT "до полудня и в полдень"
END SELECT

SELECT CASE moment
    CASE IS < "2024-02-29 00:00:00"
        PRINT "раньше"
    CASE IS >= "2024-02-29 12:34:56"
        PRINT "не раньше момента"
END SELECT
