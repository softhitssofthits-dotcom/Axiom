' SELECT CASE умеет сравнивать строки и проверять, входит ли буква в диапазон.
DIM command AS STRING = "Nuts"
DIM letter AS STRING = "B"

SELECT CASE command
    CASE IS > "M"
        PRINT "После буквы M"
    CASE ELSE
        PRINT "До буквы M"
END SELECT

SELECT CASE letter
    CASE "A" TO "M"
        PRINT "Первая часть алфавита"
    CASE ELSE
        PRINT "Вторая часть алфавита"
END SELECT
