' SELECT CASE показывает сравнения IS и проверку нескольких числовых диапазонов.
DIM score AS INTEGER = 82

SELECT CASE score
    CASE IS > 90
        PRINT "Отлично"
    CASE IS >= 75
        PRINT "Хорошо"
    CASE IS < 50
        PRINT "Нужно повторить"
    CASE ELSE
        PRINT "Попробуйте ещё раз"
END SELECT
