' Ожидается ошибка MB2064: режим FOR EACH BYREF пока не поддерживается.
' Запись в переменную цикла не изменяет исходный массив,
' поэтому программа отклоняется при проверке, а не выполняется молча.
DIM values[] AS INTEGER = [1, 2]

FOR EACH BYREF item IN values[]
    item = 99
NEXT

PRINT values[1], values[2]
