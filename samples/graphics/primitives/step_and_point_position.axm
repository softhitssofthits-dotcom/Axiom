' Ожидается: PSET STEP и LINE STEP отсчитывают смещение от текущей точки, а POINT(0..3) сообщает её координаты.
SCREEN 1
CLS
COLOR 6, 3

PSET (10, 20)
PRINT "Текущая точка: x="; POINT(0); " y="; POINT(1)

PSET STEP (5, 4)
PRINT "После PSET STEP: x="; POINT(0); " y="; POINT(1)

LINE -(30, 40)
PRINT "После LINE от текущей точки: x="; POINT(0); " y="; POINT(1)

LINE STEP (5, 5)-STEP (10, 15)
PRINT "После LINE STEP: x="; POINT(0); " y="; POINT(1)

PRINT "Цвет пикселя (10, 20): "; POINT(10, 20)
PRINT "Цвет пикселя (15, 24): "; POINT(15, 24)
PRINT "Нажмите ESC, чтобы закрыть окно"

DO WHILE NOT KEYPRESS("ESC")
LOOP

SCREEN 0
PRINT "Проверка STEP и POINT завершена"
