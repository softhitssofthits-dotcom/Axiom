' Ожидается: при начальном угле 0 и конечном угле 2 * PI оператор CIRCLE рисует полный контур.
SCREEN 8
CLS

CIRCLE (160, 100), 40, 14, 0, 2 * PI

PRINT "Справа: "; POINT(200, 100)
PRINT "Слева: "; POINT(120, 100)
PRINT "Сверху: "; POINT(160, 60)
PRINT "Снизу: "; POINT(160, 140)
PRINT "Нажмите ESC, чтобы вернуться к текстовому окну"

DO WHILE NOT KEYPRESS("ESC")
LOOP

SCREEN 0
PRINT "Проверка полного оборота завершена"
