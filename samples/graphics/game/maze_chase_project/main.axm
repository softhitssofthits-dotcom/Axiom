' main — точка входа: порядок запуска, часы, пауза и завершение.
' Запускайте этот файл: он соединяет зависимости и владеет единственным игровым циклом.
' PUBLIC обозначает договор с соседними модулями; PRIVATE сохраняет внутреннее состояние.

IMPORT maze_config
IMPORT maze_world
IMPORT maze_calibration
IMPORT maze_player
IMPORT maze_game
IMPORT maze_render

' #region Состояние игрового цикла

PRIVATE DIM exitRequested AS BOOLEAN = FALSE                                                            ' Флаг ручного выхода из программы по ESC.
PRIVATE DIM paused AS BOOLEAN = FALSE                                                                   ' Флаг паузы: TRUE означает, что игра временно остановлена.
PRIVATE DIM previousFrameTime AS DOUBLE = 0                                                             ' Предыдущее показание часов для ограниченного шага симуляции.
PRIVATE DIM frameDeltaSeconds AS DOUBLE = 0                                                            ' Время между показами кадра после проверки скачков часов.
PRIVATE DIM simulationAccumulator AS DOUBLE = 0                                                        ' Накопленное время для независимых от отрисовки шагов игры.
PRIVATE DIM currentFrameTime AS DOUBLE = 0                                                             ' Текущее показание TIMER для расчёта прошедшего времени.

' #endregion

' #region Инициализация и игровой цикл

LoadResources()                                                                                 ' Загружаем фон лабиринта и спрайты персонажей.
InitPelletAlignment()                                                                           ' Настраиваем реальные центры проходов, чтобы точки легли в тоннели картинки.
InitCalibrationFile()                                                                           ' Готовим путь к файлу рядом с игрой, куда будем складывать ручные значения калибровки.
LoadPelletAlignment()                                                                           ' При наличии полного снимка используем его вместо встроенных значений.
InitMaze()                                                                                      ' Загружаем текстовую схему карты и считаем стартовые точки.
IF MazeError() = "" THEN                                                                  ' Стартовые координаты безопасны только после проверки карты.
    InitGame()                                                                               ' Ставим героя и призрака в их начальные позиции.
ELSE                                                                                            ' При неверной карте пропускаем игровой цикл.
    exitRequested = TRUE                                                                        ' Не запускаем перемещение по некорректной схеме.
END IF                                                                                          ' Завершаем обработку результата проверки карты.

previousFrameTime = TIMER()                                                                     ' Запоминаем начало измерения игрового времени.
simulationAccumulator = FIXED_STEP_SECONDS                                                     ' Первый шаг симуляции доступен сразу.

SMOOTH ON

CANVAS VIEW_WIDTH, VIEW_HEIGHT                                                                  ' Открываем холст, в который теперь помещается весь лабиринт целиком.

DO WHILE NOT exitRequested                                                                      ' Главный игровой цикл продолжается, пока игрок не попросит выход.
    BEGINFRAME                                                                                  ' Начинаем новый кадр современного графического холста.
    ClearGameFrame()                                                                        ' Очищаем фон кадра перед рисованием.

    currentFrameTime = TIMER()                                                                  ' Берём показание часов один раз на кадр.
    frameDeltaSeconds = currentFrameTime - previousFrameTime                                    ' Считаем время, прошедшее с предыдущего кадра.
    previousFrameTime = currentFrameTime                                                        ' Сохраняем показание для следующего кадра.
    IF frameDeltaSeconds < 0 THEN
        frameDeltaSeconds = 0                                                                  ' TIMER сбрасывается в полночь, поэтому отрицательное время игнорируем.
    END IF
    IF frameDeltaSeconds > MAX_FRAME_DELTA_SECONDS THEN
        frameDeltaSeconds = MAX_FRAME_DELTA_SECONDS                                             ' Ограничиваем скачки часов и возврат после блокировки окна.
    END IF

    ' Переключение калибровки не раскрывает её таблицы и внутренние сообщения.
    IF CalibrationHotKeyPressed("K") THEN
        ToggleCalibration()
        IF IsCalibrationActive() THEN paused = FALSE
    END IF

    IF IsCalibrationActive() THEN                                                                     ' Если включена ручная калибровка...
        HandleCalibrationInput()                                                                ' ...читаем клавиши калибровки и двигаем выбранные точки.
    END IF                                                                                      ' Завершаем обработку режима калибровки.

    IF KEYPRESS("SPACE") AND NOT GameFinished() AND NOT IsCalibrationActive() THEN                          ' Если нажали пробел и мы не в режиме калибровки...
        paused = NOT paused                                                                     ' ...переключаем паузу туда или обратно.
    END IF                                                                                      ' Завершаем обработку клавиши паузы.

    IF NOT GameFinished() AND NOT paused AND NOT IsCalibrationActive() THEN                                 ' Пока игра активна, накапливаем время независимой симуляции.
        simulationAccumulator = simulationAccumulator + frameDeltaSeconds                      ' Время отрисовки не меняет скорость персонажей.
        FOR catchUpSteps = 1 TO MAX_CATCH_UP_STEPS                                               ' Проверяем не больше шести возможных шагов.
            IF simulationAccumulator >= FIXED_STEP_SECONDS THEN                                 ' Работаем только если накопилось полное время.
                IF NOT GameFinished() THEN                                                            ' После победы или поражения мир замораживается.
                    UpdateGameStep()                                                            ' Выполняем один полный шаг игровой логики.
                    simulationAccumulator = simulationAccumulator - FIXED_STEP_SECONDS          ' Списываем обработанный интервал.
                END IF                                                                          ' Завершаем проверку состояния партии.
            END IF                                                                              ' Завершаем проверку накопленного времени.
        NEXT                                                                                    ' Переходим к следующей попытке догнать симуляцию.
        IF simulationAccumulator >= FIXED_STEP_SECONDS THEN
            simulationAccumulator = 0                                                           ' Сбрасываем лишнее время после достижения лимита.
        END IF
    ELSE                                                                                        ' Если партия завершена или стоит на паузе...
        simulationAccumulator = 0                                                               ' После паузы не пытаемся ускоренно догонять игровое время.
        ResetPlayerAnimation()                                                                ' ...останавливаем анимацию героя, чтобы он не жевал в паузе.
    END IF                                                                                      ' Завершаем обновление логики кадра.

    DrawMazeWorld()                                                                             ' Рисуем лабиринт, точки и персонажей в мировых координатах.
    IF IsCalibrationActive() THEN                                                                     ' Если сейчас идёт ручная калибровка...
        DrawCalibrationOverlay()                                                                ' ...рисуем направляющую линию поверх выбранной строки или столбца.
    END IF                                                                                      ' Завершаем рисование калибровочного слоя.
    DrawHud(paused)                                                                                   ' Рисуем верхнюю информационную панель в экранных координатах.
    PRESENT                                                                                     ' Показываем собранный кадр на экране.
    SLEEP 1                                                                                     ' Отдаём процессор ОС; скорость игры задаёт фиксированный шаг выше.

    IF KEYPRESS("ESC") THEN                                                                     ' Если в этом кадре нажали ESC...
        exitRequested = TRUE                                                                    ' ...запрашиваем выход из главного цикла.
    END IF                                                                                      ' Завершаем проверку клавиши ESC.
LOOP                                                                                            ' Возвращаемся к следующему кадру.

SCREEN 0                                                                                        ' Возвращаем обычный текстовый экран после выхода из игры.
IF MazeError() <> "" THEN
    PRINT "Ошибка карты Maze Chase: " + MazeError()                                         ' Показываем проверочную ошибку после закрытия графического режима.
END IF

' #endregion
