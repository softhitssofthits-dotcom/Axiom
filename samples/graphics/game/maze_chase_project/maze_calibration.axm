    pelletRowOffset(6) = -23                                                                   ' Значение строки 6 полностью перенесено из файла калибровки.
    pelletRowOffset(7) = -19                                                                   ' Значение строки 7 полностью перенесено из файла калибровки.
    pelletRowOffset(8) = -16                                                                   ' Значение строки 8 полностью перенесено из файла калибровки.
    pelletRowOffset(9) = -15                                                                   ' Значение строки 9 полностью перенесено из файла калибровки.
    pelletRowOffset(10) = -8                                                                   ' Значение строки 10 полностью перенесено из файла калибровки.
    pelletRowOffset(11) = -3                                                                   ' Значение строки 11 полностью перенесено из файла калибровки.
    pelletRowOffset(12) = 1                                                                   ' Значение строки 12 полностью перенесено из файла калибровки.
    pelletRowOffset(13) = 2                                                                   ' Значение строки 13 полностью перенесено из файла калибровки.
    pelletRowOffset(14) = 1                                                                   ' Значение строки 14 полностью перенесено из файла калибровки.
    pelletRowOffset(15) = 2                                                                   ' Значение строки 15 полностью перенесено из файла калибровки.
    pelletRowOffset(16) = 7                                                                   ' Значение строки 16 полностью перенесено из файла калибровки.
    pelletRowOffset(17) = 10                                                                   ' Значение строки 17 полностью перенесено из файла калибровки.
    pelletRowOffset(18) = 15                                                                   ' Значение строки 18 полностью перенесено из файла калибровки.
    pelletRowOffset(19) = 14                                                                   ' Значение строки 19 полностью перенесено из файла калибровки.
    pelletRowOffset(20) = 14                                                                   ' Значение строки 20 полностью перенесено из файла калибровки.
    pelletRowOffset(21) = 13                                                                   ' Значение строки 21 полностью перенесено из файла калибровки.
    pelletRowOffset(22) = 20                                                                   ' Значение строки 22 полностью перенесено из файла калибровки.
    pelletRowOffset(23) = 21                                                                   ' Значение строки 23 полностью перенесено из файла калибровки.
    pelletRowOffset(24) = 26                                                                   ' Значение строки 24 полностью перенесено из файла калибровки.
    pelletRowOffset(25) = 26                                                                   ' Значение строки 25 полностью перенесено из файла калибровки.
    pelletRowOffset(26) = 24                                                                   ' Значение строки 26 полностью перенесено из файла калибровки.
    pelletRowOffset(27) = 27                                                                   ' Значение строки 27 полностью перенесено из файла калибровки.
    pelletRowOffset(28) = 33                                                                   ' Значение строки 28 полностью перенесено из файла калибровки.
    pelletRowOffset(29) = 40                                                                   ' Значение строки 29 полностью перенесено из файла калибровки.
    pelletRowOffset(30) = 42                                                                   ' Значение строки 30 полностью перенесено из файла калибровки.
    pelletRowOffset(31) = 42                                                                   ' Значение строки 31 полностью перенесено из файла калибровки.
    pelletRowOffset(32) = 40                                                                   ' Значение строки 32 полностью перенесено из файла калибровки.
    pelletRowOffset(33) = 38                                                                   ' Значение строки 33 полностью перенесено из файла калибровки.
