' maze_calibration — проверяемая таблица поправок, клавиши и панель настройки.
' Единую программу запускает main.axm; этот файл не запускает игровой цикл при импорте.
' PUBLIC обозначает договор с соседними модулями; PRIVATE сохраняет внутреннее состояние.

IMPORT maze_config
IMPORT maze_world

' #region Закрытое состояние калибровки

PRIVATE DIM HUD_BACKGROUND_COLOR AS INTEGER = RGB(4, 8, 18)                                            ' Фон информационной панели сверху.
PRIVATE DIM HUD_STATUS_COLOR AS INTEGER = RGB(210, 228, 255)                                           ' Цвет строки статуса с подсказками игроку.
PRIVATE DIM CALIBRATION_LINE_COLOR AS INTEGER = RGB(255, 80, 80)                                      ' Цвет яркой направляющей линии в режиме ручной калибровки.
PRIVATE DIM CALIBRATION_TEXT_COLOR AS INTEGER = RGB(255, 230, 130)                                     ' Цвет текста калибровки, чтобы он отличался от обычного HUD.
PRIVATE DIM CALIBRATION_GRID_COLOR AS INTEGER = RGB(10, 34, 52)                                        ' Цвет тонкой сетки сделан более приглушённым, чтобы она меньше спорила с лабиринтом.
PRIVATE DIM CALIBRATION_PANEL_X AS INTEGER = 8                                                         ' Левая координата боковой панели калибровки.
PRIVATE DIM CALIBRATION_PANEL_Y AS INTEGER = 88                                                        ' Верхняя координата боковой панели, чтобы она не закрывала верх поля.
PRIVATE DIM CALIBRATION_PANEL_WIDTH AS INTEGER = 264                                                    ' Ширина боковой панели с подсказками.
PRIVATE DIM CALIBRATION_PANEL_HEIGHT AS INTEGER = 172                                                   ' Высота боковой панели увеличена, чтобы длинный статус помещался в две строки.
PRIVATE DIM pelletRowOffset(1 TO MAZE_ROWS) AS INTEGER                                                  ' Вертикальная поправка к началу клетки для выравнивания с картинкой.
PRIVATE DIM pelletColOffset(1 TO MAZE_COLUMNS) AS INTEGER                                               ' Горизонтальная поправка к началу клетки для выравнивания с картинкой.
PRIVATE DIM parsedRowValues(1 TO MAZE_ROWS) AS INTEGER                                                 ' Проверенные значения смещения строк из внешнего файла.
PRIVATE DIM parsedColValues(1 TO MAZE_COLUMNS) AS INTEGER                                              ' Проверенные значения смещения столбцов из внешнего файла.
PRIVATE DIM parsedRowSeen(1 TO MAZE_ROWS) AS INTEGER                                                   ' Флаги найденных строк таблицы калибровки.
PRIVATE DIM parsedColSeen(1 TO MAZE_COLUMNS) AS INTEGER                                                ' Флаги найденных столбцов таблицы калибровки.
PRIVATE DIM calibrationText AS STRING = ""                                                            ' Текст внешнего снимка калибровки.
PRIVATE DIM calibrationLines() AS STRING                                                               ' Строки внешнего снимка калибровки.
PRIVATE DIM calibrationParseError AS STRING = ""                                                      ' Ошибка разбора внешней таблицы калибровки.
PRIVATE DIM calibrationMode AS BOOLEAN = FALSE                                                         ' Флаг ручной калибровки: TRUE означает, что стрелки двигают точки, а не героя.
PRIVATE DIM calibrationTarget AS INTEGER = CALIBRATION_ROW_MODE                                        ' Что сейчас калибруем: строку точек или столбец точек.
PRIVATE DIM calibrationRow AS INTEGER = 5                                                              ' Номер выбранной строки точек; по умолчанию берём первый видимый верхний ряд.
PRIVATE DIM calibrationCol AS INTEGER = 1                                                              ' Номер выбранного столбца точек; его можно переключить клавишами W и S.
PRIVATE DIM calibrationFilePath AS STRING = ""                                                         ' Путь к файлу рядом с игрой, куда по R записываются готовые строки настройки.
PRIVATE DIM calibrationStatusText AS STRING = "Готово к калибровке."                                   ' Первая строка текущего статуса режима калибровки.
PRIVATE DIM calibrationStatusTextLine2 AS STRING = "r линия. t вся таблица."                           ' Вторая строка статуса нужна для длинных сообщений без наползания на поле.

' #endregion

' #region Открытые сведения и режим

' CalibrationError возвращает причину отказа загрузки без частичного применения таблицы.
PUBLIC FUNCTION CalibrationError() AS STRING
    RETURN calibrationParseError
END FUNCTION

' IsCalibrationActive позволяет циклу приостановить симуляцию на время настройки.
PUBLIC FUNCTION IsCalibrationActive() AS BOOLEAN
    RETURN calibrationMode
END FUNCTION

' ToggleCalibration меняет только режим и его подсказки; паузой игры управляет main.
PUBLIC SUB ToggleCalibration()
    calibrationMode = NOT calibrationMode
    IF calibrationMode THEN
        SetCalibrationStatusText("Калибровка включена.", "t запишет всю таблицу.")
    ELSE
        SetCalibrationStatusText("Калибровка выключена.", "K включает её снова.")
    END IF
END SUB

' #endregion

' #region Встроенные значения

' InitPelletAlignment — Процедура задаёт реальные центры тоннелей на фоне лабиринта.
PUBLIC SUB InitPelletAlignment()                                                                       ' Процедура задаёт реальные центры тоннелей на фоне лабиринта.
    ' Здесь мы задаём высоту точек по строкам карты.                                            ' Больше число = точка ниже. Меньше число = точка выше.
    ' Эти числа удобно крутить вручную и сразу смотреть результат в IDE.                        ' Так проще попасть в центр тоннеля по картинке.
    pelletRowOffset(1) = -37                                                                   ' Значение строки 1 полностью перенесено из файла калибровки.
    pelletRowOffset(2) = -37                                                                   ' Значение строки 2 полностью перенесено из файла калибровки.
    pelletRowOffset(3) = -37                                                                   ' Значение строки 3 полностью перенесено из файла калибровки.
    pelletRowOffset(4) = -34                                                                   ' Значение строки 4 полностью перенесено из файла калибровки.
