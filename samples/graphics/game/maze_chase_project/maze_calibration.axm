' #endregion

' #region Чтение и проверка калибровки

' InitCalibrationFile — Процедура готовит путь для файла ручной калибровки рядом с игрой.
Public Sub InitCalibrationFile()                                                                       ' Процедура готовит путь для файла ручной калибровки рядом с игрой.
    calibrationFilePath = Combinepath(Currentdir(), "maze_chase_pellet_calibration.txt")       ' Запоминаем файл рядом с main.axm, куда R дописывает значения.
End Sub                                                                                         ' Завершаем подготовку файла калибровки.

' LoadPelletAlignment — Процедура загружает только полный и проверенный снимок калибровки.
Public Sub LoadPelletAlignment()                                                                       ' Процедура загружает только полный и проверенный снимок калибровки.
    If Not Fileexists(calibrationFilePath) Then
        Return                                                                                  ' При отсутствии файла остаются встроенные значения.
    End If

    calibrationText = Readfile(calibrationFilePath)                                             ' Читаем внешний файл, не изменяя исходник игры.
    ParseCalibrationText(calibrationText)                                                        ' Проверяем структуру, диапазоны и полноту таблиц.
    If calibrationParseError <> "" Then
        Return                                                                                  ' Частичная или повреждённая таблица не применяется.
    End If

    For rowIndex = 1 To MAZE_ROWS                                                               ' Применяем только прошедшие полную проверку смещения.
        pelletRowOffset(rowIndex) = parsedRowValues(rowIndex)
    Next
    For colIndex = 1 To MAZE_COLUMNS
        pelletColOffset(colIndex) = parsedColValues(colIndex)
    Next
End Sub                                                                                         ' Завершаем чтение внешней калибровки.

' ResetParsedCalibration — Процедура очищает таблицы перед новым разбором файла.
Private Sub ResetParsedCalibration()                                                                    ' Процедура очищает таблицы перед новым разбором файла.
    calibrationParseError = ""                                                                  ' Сбрасываем прежнюю ошибку.
    For rowIndex = 1 To MAZE_ROWS                                                               ' Очищаем значения и признаки строк.
        parsedRowValues(rowIndex) = 0
        parsedRowSeen(rowIndex) = 0
    Next
    For colIndex = 1 To MAZE_COLUMNS                                                            ' Очищаем значения и признаки столбцов.
        parsedColValues(colIndex) = 0
        parsedColSeen(colIndex) = 0
    Next
End Sub                                                                                         ' Завершаем очистку служебных таблиц.

' ParseCalibrationText — Процедура разбирает снимок построчно и отвергает неизвестные записи.
Private Sub ParseCalibrationText(sourceText As String)                                                  ' Процедура разбирает снимок построчно и отвергает неизвестные записи.
    Dim currentCalibrationLine As String = ""
    calibrationLines = Split(sourceText, Chr(10))                                               ' Поддерживаем обычные файлы с переводом строк LF или CRLF.
    ResetParsedCalibration()                                                                    ' Каждое чтение начинает проверку с чистого состояния.

    For lineIndex = 1 To Arraylength(calibrationLines)                                          ' Идём по всем строкам файла.
        currentCalibrationLine = Trim(TrimTrailingCr(calibrationLines(lineIndex)))             ' Убираем пробелы и CR в конце CRLF.
        If currentCalibrationLine <> "" And Left(currentCalibrationLine, 1) <> "'" Then       ' Пропускаем пустые строки и комментарии.
            If Startswith(currentCalibrationLine, "pelletRowOffset(") Then                    ' Разбираем смещение каждой строки карты.
                ApplyCalibrationLine(currentCalibrationLine, MAZE_ROWS, True)
            Elseif Startswith(currentCalibrationLine, "pelletColOffset(") Then                ' Разбираем смещение каждого столбца карты.
                ApplyCalibrationLine(currentCalibrationLine, MAZE_COLUMNS, False)
            Else                                                                                ' Любая другая запись может скрывать опечатку.
                calibrationParseError = "неизвестная строка: " + currentCalibrationLine
            End If
        End If
        If calibrationParseError <> "" Then
            Return                                                                              ' После первой ошибки дальнейший разбор не нужен.
        End If
    Next

    For rowIndex = 1 To MAZE_ROWS                                                               ' Полный файл обязан содержать каждую строку ровно один раз.
        If parsedRowSeen(rowIndex) = 0 Then
            calibrationParseError = "нет pelletRowOffset(" + Trim(Str(rowIndex)) + ")."
            Return
        End If
    Next
    For colIndex = 1 To MAZE_COLUMNS                                                            ' Полный файл обязан содержать каждый столбец ровно один раз.
        If parsedColSeen(colIndex) = 0 Then
            calibrationParseError = "нет pelletColOffset(" + Trim(Str(colIndex)) + ")."
            Return
        End If
    Next
End Sub                                                                                         ' Завершаем строгий разбор файла.

' ApplyCalibrationLine — Служебная операция модуля.
Private Sub ApplyCalibrationLine(lineText As String, maxIndex As Integer, isRowLine As Boolean)
    Dim openPos As Integer = Instr(lineText, "(")
    Dim closePos As Integer = Instr(lineText, ")")
    Dim equalPos As Integer = Instr(lineText, "=")
    Dim indexText As String = ""
    Dim valueText As String = ""
    Dim indexNumber As Double = 0
    Dim valueNumber As Double = 0
    Dim parsedIndex As Integer = 0

    If openPos = 0 Or closePos <= openPos Or equalPos <= closePos Then
        calibrationParseError = "повреждённая строка: " + lineText
        Return
    End If
    indexText = Trim(Mid(lineText, openPos + 1, closePos - openPos - 1))
    valueText = Trim(Mid(lineText, equalPos + 1, Len(lineText) - equalPos))
    If Not Isnumeric(indexText) Or Not Isnumeric(valueText) Then
        calibrationParseError = "ожидались целые числа: " + lineText
        Return
    End If

    indexNumber = Val(indexText)
    valueNumber = Val(valueText)
    If indexNumber < 1 Or indexNumber > maxIndex Then
        calibrationParseError = "индекс вне диапазона: " + lineText
        Return
    End If
    If valueNumber < -2147483647 Or valueNumber > 2147483647 Then
        calibrationParseError = "смещение слишком велико: " + lineText
        Return
    End If
    If indexNumber <> Int(indexNumber) Or valueNumber <> Int(valueNumber) Then
        calibrationParseError = "ожидались целые числа: " + lineText
        Return
    End If

    parsedIndex = Int(indexNumber)
    If isRowLine Then
        If parsedRowSeen(parsedIndex) <> 0 Then
            calibrationParseError = "повтор pelletRowOffset(" + Trim(Str(parsedIndex)) + ")."
            Return
        End If
        parsedRowSeen(parsedIndex) = 1
        parsedRowValues(parsedIndex) = Int(valueNumber)
    Else
        If parsedColSeen(parsedIndex) <> 0 Then
            calibrationParseError = "повтор pelletColOffset(" + Trim(Str(parsedIndex)) + ")."
            Return
        End If
        parsedColSeen(parsedIndex) = 1
        parsedColValues(parsedIndex) = Int(valueNumber)
    End If
End Sub                                                                                         ' Завершаем проверку одной строки.

' TrimTrailingCr — Функция убирает CR после разбиения CRLF по LF.
Private Function TrimTrailingCr(inputText As String) As String                                         ' Функция убирает CR после разбиения CRLF по LF.
    If Len(inputText) > 0 Then
        If Asc(Right(inputText, 1)) = 13 Then
            Return Left(inputText, Len(inputText) - 1)
        End If
    End If
    Return inputText
End Function                                                                                    ' Завершаем удаление хвостового CR.

' #endregion

' #region Управление калибровкой

' HandleCalibrationInput — Процедура читает клавиши ручной калибровки точек.
Public Sub HandleCalibrationInput()                                                                    ' Процедура читает клавиши ручной калибровки точек.
    If CalibrationHotKeyPressed("C") Then                                                       ' Если нажали C или c...
        If calibrationTarget = CALIBRATION_ROW_MODE Then                                        ' Если сейчас выбрана строка...
            calibrationTarget = CALIBRATION_COL_MODE                                            ' ...переключаемся на столбец.
            SetCalibrationStatusText("Выбран столбец.", "LEFT/RIGHT двигают.")                  ' Обновляем подсказку прямо в калибровочном режиме и не растягиваем строку.
        Else                                                                                    ' Иначе сейчас выбран столбец.
            calibrationTarget = CALIBRATION_ROW_MODE                                            ' ...переключаемся обратно на строку.
            SetCalibrationStatusText("Выбрана строка.", "UP/DOWN двигают.")                    ' Обновляем подсказку для строк и держим её короткой.
        End If                                                                                  ' Завершаем переключение строки и столбца.
    End If                                                                                      ' Завершаем обработку клавиши C.

    If CalibrationHotKeyPressed("W") Then                                                       ' Если нажали W или w...
        If calibrationTarget = CALIBRATION_ROW_MODE Then                                        ' Если калибруем строки...
            calibrationRow = ClampInt(calibrationRow - 1, 1, MAZE_ROWS)                          ' ...выбираем строку выше.
        Else                                                                                    ' Иначе калибруем столбцы.
            calibrationCol = ClampInt(calibrationCol - 1, 1, MazeColumns())                          ' ...выбираем столбец левее по номеру.
        End If                                                                                  ' Завершаем выбор предыдущего номера.
        SetCalibrationStatusText("Выбран другой номер.", CalibrationSelectionText())            ' Показываем, что именно теперь выбрано, но разбиваем статус на две строки.
    End If                                                                                      ' Завершаем обработку клавиши W.

    If CalibrationHotKeyPressed("S") Then                                                       ' Если нажали S или s...
        If calibrationTarget = CALIBRATION_ROW_MODE Then                                        ' Если калибруем строки...
            calibrationRow = ClampInt(calibrationRow + 1, 1, MAZE_ROWS)                          ' ...выбираем строку ниже.
        Else                                                                                    ' Иначе калибруем столбцы.
            calibrationCol = ClampInt(calibrationCol + 1, 1, MazeColumns())                          ' ...выбираем столбец правее по номеру.
        End If                                                                                  ' Завершаем выбор следующего номера.
        SetCalibrationStatusText("Выбран другой номер.", CalibrationSelectionText())            ' Показываем текущий выбор, но не даём строке наползать на поле.
    End If                                                                                      ' Завершаем обработку клавиши S.

    If calibrationTarget = CALIBRATION_ROW_MODE Then                                            ' Если сейчас двигаем строку точек...
        If Keypress("UP") Then                                                                  ' Если нажали стрелку вверх...
            pelletRowOffset(calibrationRow) = pelletRowOffset(calibrationRow) - 1              ' ...поднимаем выбранную строку на один пиксель.
            SetCalibrationStatusText("Строка поднята.", CalibrationAssignmentText())            ' Показываем новое значение в две строки.
        End If                                                                                  ' Завершаем обработку стрелки вверх.

        If Keypress("DOWN") Then                                                                ' Если нажали стрелку вниз...
            pelletRowOffset(calibrationRow) = pelletRowOffset(calibrationRow) + 1              ' ...опускаем выбранную строку на один пиксель.
            SetCalibrationStatusText("Строка опущена.", CalibrationAssignmentText())            ' Показываем новое значение в две строки.
        End If                                                                                  ' Завершаем обработку стрелки вниз.
    Else                                                                                        ' Иначе сейчас двигаем столбец точек.
        If Keypress("LEFT") Then                                                                ' Если нажали стрелку влево...
            pelletColOffset(calibrationCol) = pelletColOffset(calibrationCol) - 1              ' ...сдвигаем выбранный столбец на один пиксель влево.
            SetCalibrationStatusText("Столбец влево.", CalibrationAssignmentText())             ' Показываем новое значение и сохраняем короткий статус.
        End If                                                                                  ' Завершаем обработку стрелки влево.

        If Keypress("RIGHT") Then                                                               ' Если нажали стрелку вправо...
            pelletColOffset(calibrationCol) = pelletColOffset(calibrationCol) + 1              ' ...сдвигаем выбранный столбец на один пиксель вправо.
            SetCalibrationStatusText("Столбец вправо.", CalibrationAssignmentText())            ' Показываем новое значение и сохраняем короткий статус.
        End If                                                                                  ' Завершаем обработку стрелки вправо.
    End If                                                                                      ' Завершаем обработку сдвига выбранной линии.

    If CalibrationLowerHotKeyPressed("T") Then                                                   ' Если нажали обычную t или русскую е...
        SaveAllCalibrationValues()                                                              ' ...перезаписываем файл рядом с игрой полной таблицей центров.
    End If                                                                                      ' Завершаем обработку полной записи таблицы.

    If CalibrationLowerHotKeyPressed("R") Then                                                   ' Если нажали обычную r или русскую к...
        SaveCalibrationValue()                                                                  ' ...дописываем текущее присваивание в файл рядом с игрой.
    End If                                                                                      ' Завершаем обработку одиночной записи.
End Sub                                                                                         ' Завершаем обработку калибровочных клавиш.

' SetCalibrationStatusText — Процедура разбивает статус калибровки на две короткие строки.
Private Sub SetCalibrationStatusText(line1 As String, line2 As String)                                 ' Процедура разбивает статус калибровки на две короткие строки.
    calibrationStatusText = line1                                                               ' Сохраняем первую строку статуса.
    calibrationStatusTextLine2 = line2                                                          ' Сохраняем вторую строку статуса.
End Sub                                                                                         ' Завершаем обновление двухстрочного статуса.

' CalibrationSelectionText — Функция возвращает человекочитаемое описание текущего выбора.
Private Function CalibrationSelectionText() As String                                                   ' Функция возвращает человекочитаемое описание текущего выбора.
    If calibrationTarget = CALIBRATION_ROW_MODE Then                                            ' Если выбрана строка...
        Return "строка " + Trim(Str(calibrationRow)) + ", значение " + Trim(Str(pelletRowOffset(calibrationRow))) ' Возвращаем номер строки и её Y-сдвиг.
    End If                                                                                      ' Завершаем строковый режим.

    Return "столбец " + Trim(Str(calibrationCol)) + ", значение " + Trim(Str(pelletColOffset(calibrationCol))) ' Возвращаем номер столбца и его X-сдвиг.
End Function                                                                                    ' Завершаем описание текущего выбора.

' CalibrationAssignmentText — Функция собирает точную строку присваивания для файла калибровки.
Private Function CalibrationAssignmentText() As String                                                  ' Функция собирает точную строку присваивания для файла калибровки.
    If calibrationTarget = CALIBRATION_ROW_MODE Then                                            ' Если сейчас выбрана строка...
        Return CalibrationRowAssignmentText(calibrationRow)                                     ' Возвращаем готовую строку для таблицы строк.
    End If                                                                                      ' Завершаем ветку строки.

    Return CalibrationColAssignmentText(calibrationCol)                                         ' Возвращаем готовую строку для таблицы столбцов.
End Function                                                                                    ' Завершаем сборку строки присваивания.

' CalibrationHotKeyPressed — Функция проверяет буквенную клавишу калибровки в обоих регистрах.
Public Function CalibrationHotKeyPressed(keyName As String) As Boolean                                 ' Функция проверяет буквенную клавишу калибровки в обоих регистрах.
    If CalibrationUpperHotKeyPressed(keyName) Then                                               ' Если в очередь пришла заглавная латинская или русская буква...
        Return True                                                                             ' ...сразу считаем горячую клавишу нажатой.
    End If                                                                                      ' Завершаем проверку заглавной буквы.

    If CalibrationLowerHotKeyPressed(keyName) Then                                               ' Если Windows прислал маленькую латинскую или русскую букву...
        Return True                                                                             ' ...тоже принимаем её как ту же команду калибровки.
    End If                                                                                      ' Завершаем проверку маленькой буквы.

    Return False                                                                                ' Если ни один вариант не найден, клавиша не нажата.
End Function                                                                                    ' Завершаем проверку буквенной горячей клавиши.

' CalibrationUpperHotKeyPressed — Функция проверяет именно заглавную букву команды.
Private Function CalibrationUpperHotKeyPressed(keyName As String) As Boolean                            ' Функция проверяет именно заглавную букву команды.
    If Keypress(keyName) Then                                                                   ' Если пришла заглавная латинская буква...
        Return True                                                                             ' ...возвращаем TRUE и расходуем это событие.
    End If                                                                                      ' Завершаем проверку латинской заглавной буквы.

    Dim altUpper As String = CalibrationRussianHotKeyUpper(keyName)                             ' Для русской раскладки получаем букву на той же физической клавише.
    If altUpper <> "" Then                                                                      ' Если для этой команды есть русская пара...
        If Keypress(altUpper) Then                                                              ' ...и в очередь пришла заглавная русская буква...
            Return True                                                                         ' ...тоже считаем горячую клавишу нажатой.
        End If                                                                                  ' Завершаем проверку заглавной русской буквы.
    End If                                                                                      ' Завершаем обработку русской пары в верхнем регистре.

    Return False                                                                                ' Если заглавная буква не найдена, возвращаем FALSE.
End Function                                                                                    ' Завершаем проверку заглавной горячей клавиши.

' CalibrationLowerHotKeyPressed — Функция проверяет именно маленькую букву команды.
Private Function CalibrationLowerHotKeyPressed(keyName As String) As Boolean                            ' Функция проверяет именно маленькую букву команды.
    If Keypress(Lcase(keyName)) Then                                                            ' Если пришла маленькая латинская буква...
        Return True                                                                             ' ...возвращаем TRUE и расходуем это событие.
    End If                                                                                      ' Завершаем проверку латинской маленькой буквы.

    Dim altLower As String = CalibrationRussianHotKeyLower(keyName)                             ' Получаем маленькую русскую букву с той же клавиши.
    If altLower <> "" Then                                                                      ' Если русская маленькая пара существует...
        If Keypress(altLower) Then                                                              ' ...и в очередь пришла маленькая русская буква...
            Return True                                                                         ' ...принимаем её как ту же команду калибровки.
        End If                                                                                  ' Завершаем проверку маленькой русской буквы.
    End If                                                                                      ' Завершаем обработку русской пары в нижнем регистре.

    Return False                                                                                ' Если маленькая буква не найдена, возвращаем FALSE.
End Function                                                                                    ' Завершаем проверку маленькой горячей клавиши.

' CalibrationRussianHotKeyUpper — Функция возвращает русскую заглавную букву с той же физической клавиши.
Private Function CalibrationRussianHotKeyUpper(keyName As String) As String                             ' Функция возвращает русскую заглавную букву с той же физической клавиши.
    If keyName = "K" Then                                                                       ' Если нужна команда калибровки по клавише K...
        Return "Л"                                                                              ' ...в русской раскладке на этой клавише стоит буква Л.
    End If                                                                                      ' Завершаем проверку команды K.

    If keyName = "C" Then                                                                       ' Если нужна команда по клавише C...
        Return "С"                                                                              ' ...в русской раскладке это буква С.
    End If                                                                                      ' Завершаем проверку команды C.

    If keyName = "W" Then                                                                       ' Если нужна команда по клавише W...
        Return "Ц"                                                                              ' ...в русской раскладке это буква Ц.
    End If                                                                                      ' Завершаем проверку команды W.

    If keyName = "S" Then                                                                       ' Если нужна команда по клавише S...
        Return "Ы"                                                                              ' ...в русской раскладке это буква Ы.
    End If                                                                                      ' Завершаем проверку команды S.

    If keyName = "R" Then                                                                       ' Если нужна команда записи по клавише R...
        Return "К"                                                                              ' ...в русской раскладке это буква К.
    End If                                                                                      ' Завершаем проверку команды R.

    If keyName = "T" Then                                                                       ' Если нужна команда полной записи по клавише T...
        Return "Е"                                                                              ' ...в русской раскладке это буква Е.
    End If                                                                                      ' Завершаем проверку команды T.

    Return ""                                                                                   ' Для остальных клавиш русскую пару не задаём.
End Function                                                                                    ' Завершаем выбор русской заглавной пары.

' CalibrationRussianHotKeyLower — Функция возвращает русскую маленькую букву с той же физической клавиши.
Private Function CalibrationRussianHotKeyLower(keyName As String) As String                             ' Функция возвращает русскую маленькую букву с той же физической клавиши.
    If keyName = "K" Then                                                                       ' Если нужна команда калибровки по клавише K...
        Return "л"                                                                              ' ...в русской раскладке на этой клавише стоит буква л.
    End If                                                                                      ' Завершаем проверку команды K.

    If keyName = "C" Then                                                                       ' Если нужна команда по клавише C...
        Return "с"                                                                              ' ...в русской раскладке это буква с.
    End If                                                                                      ' Завершаем проверку команды C.

    If keyName = "W" Then                                                                       ' Если нужна команда по клавише W...
        Return "ц"                                                                              ' ...в русской раскладке это буква ц.
    End If                                                                                      ' Завершаем проверку команды W.

    If keyName = "S" Then                                                                       ' Если нужна команда по клавише S...
        Return "ы"                                                                              ' ...в русской раскладке это буква ы.
    End If                                                                                      ' Завершаем проверку команды S.

    If keyName = "R" Then                                                                       ' Если нужна команда записи по клавише R...
        Return "к"                                                                              ' ...в русской раскладке это буква к.
    End If                                                                                      ' Завершаем проверку команды R.

    If keyName = "T" Then                                                                       ' Если нужна команда полной записи по клавише T...
        Return "е"                                                                              ' ...в русской раскладке это буква е.
    End If                                                                                      ' Завершаем проверку команды T.

    Return ""                                                                                   ' Для остальных клавиш маленькую русскую пару не задаём.
End Function                                                                                    ' Завершаем выбор русской маленькой пары.

' #endregion

' #region Сохранение калибровки

' SaveCalibrationValue — Процедура дописывает текущее значение калибровки в файл рядом с игрой.
Private Sub SaveCalibrationValue()                                                                      ' Процедура дописывает текущее значение калибровки в файл рядом с игрой.
    Dim lineText As String = CalibrationAssignmentText()                                        ' Собираем строку присваивания, которую потом можно вставить в InitPelletAlignment.
    Dim ok As Boolean = Appendfile(calibrationFilePath, lineText + Chr(13) + Chr(10))           ' Дописываем строку в файл с переводом строки Windows.

    If ok Then                                                                                  ' Если запись прошла успешно...
        SetCalibrationStatusText("Записано в файл.", lineText)                                  ' ...показываем, какая строка ушла в файл, но не растягиваем её в одну длинную ленту.
    Else                                                                                        ' Иначе файловая функция вернула FALSE.
        SetCalibrationStatusText("Ошибка записи.", "Файл калибровки.")                          ' Сообщаем о проблеме записи короткими строками.
    End If                                                                                      ' Завершаем обработку результата записи.
End Sub                                                                                         ' Завершаем запись значения калибровки.

' SaveAllCalibrationValues — Процедура перезаписывает файл свежим полным снимком всех координат точек.
Private Sub SaveAllCalibrationValues()                                                                  ' Процедура перезаписывает файл свежим полным снимком всех координат точек.
    Dim ok As Boolean = True                                                                    ' Общий флаг успеха полной записи.
    Dim snapshotText As String = "' Полный снимок текущей калибровки maze_chase" + Chr(13) + Chr(10) ' Начинаем текст файла с понятного заголовка снимка.

    For rowIndex = 1 To MAZE_ROWS                                                                ' Проходим все строки таблицы центров.
        snapshotText = snapshotText + CalibrationRowAssignmentText(rowIndex) + Chr(13) + Chr(10) ' Добавляем в снимок одну строку `pelletRowOffset`.
    Next                                                                                        ' Переходим к следующей строке.

    For colIndex = 1 To MazeColumns()                                                                ' Проходим все столбцы таблицы центров.
        snapshotText = snapshotText + CalibrationColAssignmentText(colIndex) + Chr(13) + Chr(10) ' Добавляем в снимок одну строку `pelletColOffset`.
    Next                                                                                        ' Переходим к следующему столбцу.

    ok = Writefile(calibrationFilePath, snapshotText)                                            ' Полностью заменяем старый журнал новым чистым снимком таблицы.

    If ok Then                                                                                  ' Если все строки записались...
        SetCalibrationStatusText("Записана вся таблица.", "Строки и столбцы.")                  ' ...сообщаем об успешной страховочной записи двумя строками.
    Else                                                                                        ' Иначе хотя бы одна запись вернула FALSE.
        SetCalibrationStatusText("Не удалось записать.", "Всю таблицу.")                        ' Сообщаем о частичной ошибке записи короткими строками.
    End If                                                                                      ' Завершаем обработку результата полной записи.
End Sub                                                                                         ' Завершаем полную запись координат.

' CalibrationRowAssignmentText — Функция собирает строку присваивания для одной строки точек.
Private Function CalibrationRowAssignmentText(rowIndex As Integer) As String                            ' Функция собирает строку присваивания для одной строки точек.
    Return "pelletRowOffset(" + Trim(Str(rowIndex)) + ") = " + Trim(Str(pelletRowOffset(rowIndex))) ' Возвращаем готовую строку `pelletRowOffset`.
End Function                                                                                    ' Завершаем сборку строки для вертикального центра.

' CalibrationColAssignmentText — Функция собирает строку присваивания для одного столбца точек.
Private Function CalibrationColAssignmentText(colIndex As Integer) As String                            ' Функция собирает строку присваивания для одного столбца точек.
    Return "pelletColOffset(" + Trim(Str(colIndex)) + ") = " + Trim(Str(pelletColOffset(colIndex))) ' Возвращаем готовую строку `pelletColOffset`.
End Function                                                                                    ' Завершаем сборку строки для горизонтального центра.

' #endregion

' #region Координаты и наложение

' PelletPixelX — Функция возвращает реальную X-координату точки внутри клетки.
Public Function PelletPixelX(tileCol As Integer) As Integer                                            ' Функция возвращает реальную X-координату точки внутри клетки.
    Return (tileCol - 1) * TILE + pelletColOffset(tileCol)                                    ' Добавляем к клетке не математический центр, а измеренный центр тоннеля.
End Function                                                                                    ' Завершаем вычисление X точки.

' PelletPixelY — Функция возвращает реальную Y-координату точки внутри клетки.
Public Function PelletPixelY(tileRow As Integer) As Integer                                            ' Функция возвращает реальную Y-координату точки внутри клетки.
    Return (tileRow - 1) * TILE + pelletRowOffset(tileRow)                                    ' Берём верх мира и добавляем к строке измеренный центр прохода.
End Function                                                                                    ' Завершаем вычисление Y точки.

' WorldViewportLeft — Функция вычисляет левую экранную границу viewport мира.
Public Function WorldViewportLeft() As Integer                                                         ' Функция вычисляет левую экранную границу viewport мира.
    Return MaxInt(0, (VIEW_WIDTH - WorldWidthPixels()) \ 2)                                       ' Центрируем лабиринт по ширине окна, если свободное место есть.
End Function                                                                                    ' Завершаем вычисление левой границы viewport.

' WorldViewportTop — Функция вычисляет верхнюю экранную границу viewport мира.
Public Function WorldViewportTop() As Integer                                                          ' Функция вычисляет верхнюю экранную границу viewport мира.
    Return HUD_HEIGHT                                                                           ' Мир начинается сразу под HUD без дополнительного ручного сдвига.
End Function                                                                                    ' Завершаем вычисление верхней границы viewport.

' WorldViewportRight — Функция вычисляет правую исключающую границу viewport мира.
Public Function WorldViewportRight() As Integer                                                        ' Функция вычисляет правую исключающую границу viewport мира.
    Return WorldViewportLeft() + WorldWidthPixels()                                               ' Правая граница равна левой плюс полная ширина мира.
End Function                                                                                    ' Завершаем вычисление правой границы viewport.

' WorldViewportBottom — Функция вычисляет нижнюю исключающую границу viewport мира.
Public Function WorldViewportBottom() As Integer                                                       ' Функция вычисляет нижнюю исключающую границу viewport мира.
    Return WorldViewportTop() + WorldHeightPixels()                                               ' Нижняя граница равна верху плюс полная высота мира.
End Function                                                                                    ' Завершаем вычисление нижней границы viewport.

' DrawCalibrationOverlay — Процедура рисует подсказки и направляющую линию калибровки.
Public Sub DrawCalibrationOverlay()                                                                    ' Процедура рисует подсказки и направляющую линию калибровки.
    Resetcamera                                                                                 ' Рисуем оверлей в экранных координатах, чтобы он не зависел от камеры.
    Viewport (WorldViewportLeft(), WorldViewportTop()) - (WorldViewportRight(), WorldViewportBottom()) ' Ограничиваем сетку и направляющие только областью игрового поля.
    DrawCalibrationGrid()                                                                       ' Сначала рисуем тонкую сетку поверх поля для точной ручной подгонки.

    If calibrationTarget = CALIBRATION_ROW_MODE Then                                            ' Если выбрана строка...
        Dim selectedY As Integer = PelletPixelY(calibrationRow)                                  ' Считаем фактическую Y-координату выбранного ряда точек.
        Drawline 0, selectedY, WorldWidthPixels() - 1, selectedY, CALIBRATION_LINE_COLOR         ' Проводим горизонтальную линию через выбранный ряд внутри viewport.
    Else                                                                                        ' Иначе выбран столбец.
        Dim selectedX As Integer = PelletPixelX(calibrationCol)                                  ' Считаем фактическую X-координату выбранного столбца точек.
        Drawline selectedX, 0, selectedX, WorldHeightPixels() - 1, CALIBRATION_LINE_COLOR        ' Проводим вертикальную линию через выбранный столбец по тем же границам, что и сетка.
    End If                                                                                      ' Завершаем рисование направляющей.

    Viewport                                                                                     ' Возвращаем полный холст, чтобы боковая панель не обрезалась viewport-ом мира.
    Fillrect CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y, CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT, HUD_BACKGROUND_COLOR ' Рисуем боковую плашку в пустом поле слева от лабиринта.
    Drawrect CALIBRATION_PANEL_X, CALIBRATION_PANEL_Y, CALIBRATION_PANEL_WIDTH, CALIBRATION_PANEL_HEIGHT, CALIBRATION_LINE_COLOR ' Обводим боковую плашку, чтобы она читалась как отдельный режим.
    Drawtext "КАЛИБРОВКА", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 8, CALIBRATION_TEXT_COLOR ' Заголовок режима калибровки.
    Drawtext "K/k: вкл/выкл", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 24, HUD_STATUS_COLOR ' Подсказка по входу и выходу из режима.
    Drawtext "C/c: строка/столбец", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 40, HUD_STATUS_COLOR ' Подсказка по переключению типа линии.
    Drawtext "W/S: выбрать номер", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 56, HUD_STATUS_COLOR ' Подсказка по выбору строки или столбца.
    Drawtext "Стрелки: двигать", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 72, HUD_STATUS_COLOR ' Подсказка по сдвигу выбранной линии.
    Drawtext "r: записать линию", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 88, HUD_STATUS_COLOR ' Подсказка по записи текущей линии.
    Drawtext "t: записать всё", CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 104, HUD_STATUS_COLOR ' Подсказка по полной страховочной записи таблицы.
    Drawtext CalibrationSelectionText(), CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 120, CALIBRATION_TEXT_COLOR ' Показываем текущий выбор и числовое значение.
    Drawtext calibrationStatusText, CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 136, HUD_STATUS_COLOR ' Показываем первую строку последнего действия.
    Drawtext calibrationStatusTextLine2, CALIBRATION_PANEL_X + 8, CALIBRATION_PANEL_Y + 152, HUD_STATUS_COLOR ' Показываем вторую строку статуса, чтобы длинные сообщения не наползали на поле.
End Sub                                                                                         ' Завершаем рисование калибровочного оверлея.

' DrawCalibrationGrid — Процедура рисует мелкую сетку поверх игрового поля.
Private Sub DrawCalibrationGrid()                                                                       ' Процедура рисует мелкую сетку поверх игрового поля.
    Dim gridX As Integer = 0                                                                    ' Текущая X-координата вертикальной линии сетки в мировых координатах viewport.
    Dim gridY As Integer = 0                                                                    ' Текущая Y-координата горизонтальной линии сетки стартует от верха мира.
    Dim gridRight As Integer = WorldWidthPixels() - 1                                             ' Правая граница сетки по ширине лабиринта.
    Dim gridBottom As Integer = WorldHeightPixels() - 1                                           ' Нижняя граница сетки по высоте мира.

    Do While gridX <= gridRight                                                                 ' Идём по всем вертикальным линиям сетки.
        Drawline gridX, 0, gridX, gridBottom, CALIBRATION_GRID_COLOR                            ' Рисуем одну тонкую вертикальную линию по точным границам игрового поля.
        gridX = gridX + CALIBRATION_GRID_STEP                                                   ' Переходим к следующей вертикальной линии с постоянным шагом.
    Loop                                                                                        ' Завершаем вертикальные линии сетки.

    Do While gridY <= gridBottom                                                                ' Идём по всем горизонтальным линиям сетки.
        Drawline 0, gridY, gridRight, gridY, CALIBRATION_GRID_COLOR                             ' Рисуем одну тонкую горизонтальную линию.
        gridY = gridY + CALIBRATION_GRID_STEP                                                   ' Переходим к следующей горизонтальной линии с постоянным шагом.
    Loop                                                                                        ' Завершаем горизонтальные линии сетки.
End Sub                                                                                         ' Завершаем рисование мелкой сетки.

' #endregion
