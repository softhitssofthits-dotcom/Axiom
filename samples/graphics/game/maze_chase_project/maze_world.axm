' maze_world — карта, стартовые клетки и однократный сбор точек.
' Единую программу запускает main.axm; этот файл не запускает игровой цикл при импорте.
' PUBLIC обозначает договор с соседними модулями; PRIVATE сохраняет внутреннее состояние.

Import maze_config

' #region Закрытое состояние карты

Private Dim maze(1 To MAZE_ROWS) As String                                                              ' Массив строк, в котором хранится логическая карта лабиринта.
Private Dim mazeCols As Integer = 0                                                                     ' Количество столбцов логической карты, вычисляется после загрузки.
Private Dim playerStartCol As Integer                                                                   ' Стартовый столбец героя на логической сетке.
Private Dim playerStartRowValue As Integer                                                                   ' Стартовая строка героя на логической сетке.
Private Dim ghostStartCol As Integer                                                                    ' Стартовый столбец призрака на логической сетке.
Private Dim ghostStartRowValue As Integer                                                                    ' Стартовая строка призрака на логической сетке.
Private Dim pelletsLeft As Integer                                                                      ' Сколько точек осталось на карте.
Private Dim mazeErrorMessage As String = ""                                                            ' Ошибка структуры карты не допускает запуск игровой логики.

' #endregion

' #region Создание и проверка карты

' InitMaze — Процедура загружает текстовую карту и стартовые метки.
Public Sub InitMaze()                                                                                  ' Процедура загружает текстовую карту и стартовые метки.
    maze(1) = "############################"                                                    ' Верхняя рамка лабиринта.
    maze(2) = "############################"                                                    ' Вторая верхняя строка рамки.
    maze(3) = "############################"                                                    ' Третья верхняя строка рамки.
    maze(4) = "############################"                                                    ' Четвёртая верхняя строка рамки.
    maze(5) = "#o...........##...........o#"                                                    ' Верхний длинный коридор с крупными точками по краям.
    maze(6) = "#.####.#####.##.#####.####.#"                                                    ' Верхний блок коридоров и стен.
    maze(7) = "#.####.#####.##.#####.####.#"                                                    ' Следующая строка той же геометрии.
    maze(8) = "#.####.#####.##.#####.####.#"                                                    ' Ещё одна строка верхней геометрии.
    maze(9) = "#..........................#"                                                    ' Длинный свободный верхний горизонтальный проход.
    maze(10) = "#.####.##.########.##.####.#"                                                   ' Коридоры вокруг верхнего центрального блока.
    maze(11) = "#.####.##.########.##.####.#"                                                   ' Повтор геометрии предыдущей строки.
    maze(12) = "#......##....##....##......#"                                                   ' Несколько разветвлений перед домиком.
    maze(13) = "######.#####.##.#####.######"                                                   ' Верхняя рамка вокруг центральной зоны.
    maze(14) = "######.#####.##.#####.######"                                                   ' Ещё одна строка рамки центральной зоны.
    maze(15) = "######.##..........##.######"                                                   ' Коридор над центральным домиком.
    maze(16) = "######.##.########.##.######"                                                   ' Верхняя стенка домика призраков.
    maze(17) = "######.##.########.##.######"                                                   ' Нижняя стенка домика призраков.
    maze(18) = "..........########.........."                                                   ' Горизонтальный туннель сквозь середину карты.
    maze(19) = "######.##.########.##.######"                                                   ' Симметричная нижняя часть после туннеля.
    maze(20) = "######.##.########.##.######"                                                   ' Повтор геометрии над стартовой зоной призрака.
    maze(21) = "######.##.....G....##.######"                                                   ' Строка со стартом призрака.
    maze(22) = "######.##.########.##.######"                                                   ' Нижняя часть центральной зоны.
    maze(23) = "######.##.########.##.######"                                                   ' Повтор этой геометрии.
    maze(24) = "#............##............#"                                                   ' Длинный средний горизонтальный коридор.
    maze(25) = "#.####.#####.##.#####.####.#"                                                   ' Нижний блок развилок.
    maze(26) = "#.####.#####.##.#####.####.#"                                                   ' Повтор нижнего блока развилок.
    maze(27) = "#o..##.......P........##..o#"                                                   ' Строка старта героя и крупных нижних точек.
    maze(28) = "###.##.##.########.##.##.###"                                                   ' Нижние узкие коридоры и центральный блок.
    maze(29) = "###.##.##.########.##.##.###"                                                   ' Повтор предыдущей строки.
    maze(30) = "#......##....##....##......#"                                                   ' Нижние разветвления перед последним коридором.
    maze(31) = "#.##########.##.##########.#"                                                   ' Предпоследняя рамка нижней части.
    maze(32) = "#.##########.##.##########.#"                                                   ' Повтор предпоследней рамки.
    maze(33) = "#..........................#"                                                   ' Нижний длинный коридор с точками.
    maze(34) = "############################"                                                   ' Нижняя рамка лабиринта.
    maze(35) = "############################"                                                   ' Предпоследняя строка нижней рамки.
    maze(36) = "############################"                                                   ' Последняя строка нижней рамки.

    If Not ValidateMaze() Then                                                                  ' Проверяем строки до подсчёта точек и чтения маркеров.
        Return                                                                                  ' Не индексируем карту, если проверка завершилась ошибкой.
    End If                                                                                      ' Продолжаем только с корректной схемой.
    pelletsLeft = 0                                                                             ' Перед пересчётом начинаем с нуля точек.

    Dim tileText As String                                                                      ' Символ текущей клетки карты.

    For rowIndex = 1 To MAZE_ROWS                                                               ' Проходим все строки карты.
        For columnIndex = 1 To MAZE_COLUMNS                                                     ' Проходим все столбцы в текущей строке.
            tileText = Mid(maze(rowIndex), columnIndex, 1)                                      ' Берём один символ из текущей клетки карты.

            If tileText = "." Or tileText = "o" Then                                            ' Если клетка содержит обычную или крупную точку...
                pelletsLeft = pelletsLeft + 1                                                   ' ...увеличиваем общий счётчик точек.
            End If                                                                              ' Завершаем подсчёт точки.

            If tileText = "P" Then                                                              ' Если нашли старт героя...
                playerStartCol = columnIndex                                                    ' ...запоминаем его столбец.
                playerStartRowValue = rowIndex                                                       ' ...запоминаем его строку.
                maze(rowIndex) = ReplaceCell(maze(rowIndex), columnIndex, " ")                  ' ...и очищаем клетку, чтобы герой не считался стеной или точкой.
            End If                                                                              ' Завершаем обработку старта героя.

            If tileText = "G" Then                                                              ' Если нашли старт призрака...
                ghostStartCol = columnIndex                                                     ' ...запоминаем его столбец.
                ghostStartRowValue = rowIndex                                                        ' ...запоминаем его строку.
                maze(rowIndex) = ReplaceCell(maze(rowIndex), columnIndex, " ")                  ' ...и очищаем логическую клетку карты.
            End If                                                                              ' Завершаем обработку старта призрака.
        Next                                                                                    ' Переходим к следующему столбцу.
    Next                                                                                        ' Переходим к следующей строке.
End Sub                                                                                         ' Завершаем инициализацию карты.
' ValidateMaze — Функция проверяет размеры, символы и стартовые метки карты.
Private Function ValidateMaze() As Boolean                                                             ' Функция проверяет размеры, символы и стартовые метки карты.
    Dim rowLength As Integer                                                                    ' Фактическая ширина текущей строки.
    Dim playerCount As Integer = 0                                                              ' Число меток старта героя.
    Dim ghostCount As Integer = 0                                                               ' Число меток старта призрака.
    Dim tileText As String                                                                      ' Символ текущей клетки.

    mazeErrorMessage = ""                                                                      ' Перед проверкой убираем возможную старую ошибку.
    mazeCols = Len(maze(1))                                                                     ' Фиксируем ширину первой строки.
    If mazeCols <> MAZE_COLUMNS Then                                                            ' Константа размеров должна совпадать с картой.
        mazeErrorMessage = "ожидалось " + Str(MAZE_COLUMNS) + " столбцов, найдено " + Str(mazeCols) + "."
        Return False                                                                            ' Не запускаем логику на карте неверной ширины.
    End If                                                                                      ' Завершаем проверку ширины первой строки.

    For rowIndex = 1 To MAZE_ROWS                                                               ' Проверяем все строки до обхода клеток.
        rowLength = Len(maze(rowIndex))                                                         ' Получаем фактическую длину строки.
        If rowLength <> MAZE_COLUMNS Then                                                       ' Все строки должны иметь одну ширину.
            mazeErrorMessage = "строка " + Str(rowIndex) + " имеет ширину " + Str(rowLength) + "."
            Return False                                                                        ' Возвращаем ошибку до индексирования клетки.
        End If                                                                                  ' Завершаем проверку длины строки.

        For columnIndex = 1 To MAZE_COLUMNS                                                     ' Проверяем каждый символ строки.
            tileText = Mid(maze(rowIndex), columnIndex, 1)                                      ' Читаем одну клетку карты.
            If tileText = "P" Then
                playerCount = playerCount + 1                                                   ' Считаем старт героя.
            End If
            If tileText = "G" Then
                ghostCount = ghostCount + 1                                                     ' Считаем старт призрака.
            End If
            If tileText <> "#" And tileText <> "." And tileText <> "o" And tileText <> "P" And tileText <> "G" And tileText <> " " Then
                mazeErrorMessage = "неизвестный символ в строке " + Str(rowIndex) + ", столбце " + Str(columnIndex) + "."
                Return False                                                                    ' Неизвестные знаки нельзя считать проходимыми клетками.
            End If                                                                              ' Завершаем проверку допустимого символа.
        Next                                                                                    ' Переходим к следующему столбцу.
    Next                                                                                        ' Переходим к следующей строке.

    If playerCount <> 1 Then                                                                    ' Для запуска нужна ровно одна метка игрока.
        mazeErrorMessage = "карта должна содержать ровно одну метку P; найдено " + Str(playerCount) + "."
        Return False                                                                            ' Не выбираем произвольную стартовую клетку.
    End If                                                                                      ' Завершаем проверку старта героя.
    If ghostCount <> 1 Then                                                                     ' Для запуска нужна ровно одна метка призрака.
        mazeErrorMessage = "карта должна содержать ровно одну метку G; найдено " + Str(ghostCount) + "."
        Return False                                                                            ' Не выбираем произвольную стартовую клетку.
    End If                                                                                      ' Завершаем проверку старта призрака.

    Return True                                                                                 ' Карта имеет ожидаемую форму и символы.
End Function                                                                                    ' Завершаем проверку карты.

' #endregion

' #region Чтение и изменение клеток

' MazeColumns возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function MazeColumns() As Integer
    Return mazeCols
End Function

' MazeError возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function MazeError() As String
    Return mazeErrorMessage
End Function

' PlayerStartColumn возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function PlayerStartColumn() As Integer
    Return playerStartCol
End Function

' PlayerStartRow возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function PlayerStartRow() As Integer
    Return playerStartRowValue
End Function

' GhostStartColumn возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function GhostStartColumn() As Integer
    Return ghostStartCol
End Function

' GhostStartRow возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function GhostStartRow() As Integer
    Return ghostStartRowValue
End Function

' PelletsRemaining возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function PelletsRemaining() As Integer
    Return pelletsLeft
End Function

' WorldWidthPixels возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function WorldWidthPixels() As Integer
    Return mazeCols * TILE
End Function

' WorldHeightPixels возвращает значение для чтения; состояние карты остаётся закрытым.
Public Function WorldHeightPixels() As Integer
    Return MAZE_ROWS * TILE
End Function


' TakePellet принимает строку и столбец клетки. Только этот модуль изменяет карту.
' Возвращает 10/50 очков за снятую точку, либо 0; повторный сбор не уменьшает остаток.
Public Function TakePellet(rowIndex As Integer, columnIndex As Integer) As Integer
    Dim cell As String = CellAt(rowIndex, columnIndex)
    Dim points As Integer = 0
    If cell = "." Then points = 10
    If cell = "o" Then points = 50
    If points <> 0 Then
        maze(rowIndex) = ReplaceCell(maze(rowIndex), columnIndex, " ")
        pelletsLeft = pelletsLeft - 1
    End If
    Return points
End Function
' CellAt — Функция безопасно читает символ клетки карты.
Public Function CellAt(rowIndex As Integer, columnIndex As Integer) As String                          ' Функция безопасно читает символ клетки карты.
    If rowIndex < 1 Or rowIndex > MAZE_ROWS Then                                                 ' Если строка вышла за карту...
        Return "#"                                                                              ' ...возвращаем стену как безопасный барьер.
    End If                                                                                      ' Завершаем проверку строки.

    If columnIndex < 1 Or columnIndex > mazeCols Then                                           ' Если столбец вышел за карту...
        Return "#"                                                                              ' ...тоже возвращаем стену.
    End If                                                                                      ' Завершаем проверку столбца.

    Return Mid(maze(rowIndex), columnIndex, 1)                                                  ' Возвращаем один символ из нужной клетки карты.
End Function                                                                                    ' Завершаем чтение клетки.
' ReplaceCell — Функция заменяет один символ в строке карты.
Private Function ReplaceCell(lineText As String, position As Integer, replacement As String) As String  ' Функция заменяет один символ в строке карты.
    Dim leftPart As String = ""                                                                 ' Левая часть строки до изменяемой позиции.
    Dim rightPart As String = ""                                                                ' Правая часть строки после изменяемой позиции.

    If position > 1 Then                                                                        ' Если слева что-то есть...
        leftPart = Left(lineText, position - 1)                                                 ' ...берём левую часть строки.
    End If                                                                                      ' Завершаем выделение левой части.

    If position < Len(lineText) Then                                                            ' Если справа что-то есть...
        rightPart = Mid(lineText, position + 1, Len(lineText) - position)                       ' ...берём правую часть строки.
    End If                                                                                      ' Завершаем выделение правой части.

    Return leftPart + replacement + rightPart                                                   ' Склеиваем обновлённую строку обратно.
End Function                                                                                    ' Завершаем замену символа.

' #endregion

' #region Проходы и туннели

' CanMove — Функция проверяет, можно ли сделать шаг из клетки в данном направлении.
Public Function CanMove(tileCol As Integer, tileRow As Integer, dir As Integer) As Boolean            ' Функция проверяет, можно ли сделать шаг из клетки в данном направлении.
    Dim nextCol As Integer = tileCol + DirX(dir)                                                ' Вычисляем столбец следующей клетки.
    Dim nextRow As Integer = tileRow + DirY(dir)                                                ' Вычисляем строку следующей клетки.

    If dir = DIR_LEFT And tileCol = 1 And IsTunnelPassageRow(tileRow) Then                      ' Если идём влево из левого края туннеля...
        Return CellAt(tileRow, mazeCols) <> "#"                                                 ' ...смотрим на правый край той же туннельной строки.
    End If                                                                                      ' Завершаем специальную проверку левого телепорта.

    If dir = DIR_RIGHT And tileCol = mazeCols And IsTunnelPassageRow(tileRow) Then              ' Если идём вправо из правого края туннеля...
        Return CellAt(tileRow, 1) <> "#"                                                        ' ...смотрим на левый край той же строки.
    End If                                                                                      ' Завершаем специальную проверку правого телепорта.

    Return CellAt(nextRow, nextCol) <> "#"                                                      ' В обычном случае достаточно проверить, что впереди не стена.
End Function                                                                                    ' Завершаем проверку возможности движения.

' IsTunnelPassageRow — Функция проверяет, является ли строка сквозным туннелем.
Public Function IsTunnelPassageRow(rowIndex As Integer) As Boolean                                     ' Функция проверяет, является ли строка сквозным туннелем.
    If rowIndex < 1 Or rowIndex > MAZE_ROWS Then                                                 ' Если строка вне карты...
        Return False                                                                            ' ...туннелем она быть не может.
    End If                                                                                      ' Завершаем проверку диапазона строки.

    Return CellAt(rowIndex, 1) <> "#" And CellAt(rowIndex, mazeCols) <> "#"                    ' Туннельная строка открыта и слева, и справа.
End Function                                                                                    ' Завершаем проверку туннельной строки.

' WrapTunnelColumn — Функция переносит актёра через боковой туннель.
Public Function WrapTunnelColumn(tileCol As Integer, tileRow As Integer) As Integer                    ' Функция переносит актёра через боковой туннель.
    If Not IsTunnelPassageRow(tileRow) Then                                                     ' Если строка не является туннелем...
        Return tileCol                                                                          ' ...ничего не переносим и оставляем столбец как есть.
    End If                                                                                      ' Завершаем проверку туннеля.

    If tileCol < 1 Then                                                                         ' Если актёр вышел левее карты...
        Return mazeCols                                                                         ' ...переносим его на правый край.
    End If                                                                                      ' Завершаем обработку выхода слева.

    If tileCol > mazeCols Then                                                                  ' Если актёр вышел правее карты...
        Return 1                                                                                ' ...переносим его на левый край.
    End If                                                                                      ' Завершаем обработку выхода справа.

    Return tileCol                                                                              ' Если столбец в норме, возвращаем его без изменений.
End Function                                                                                    ' Завершаем перенос через туннель.

' #endregion
