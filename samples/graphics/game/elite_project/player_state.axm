' player_state — состояние пилота и его корабля: кредиты, грузовой трюм
' и живучесть (щиты, корпус, энергия). Все изменения проходят через
' процедуры с проверками: трюм не переполняется, кредиты не уходят в минус,
' урон каскадом «щиты → корпус» не уходит в отрицательные значения.
' Рынок (economy), док и бой (combat) работают только через эти функции,
' поэтому деньги, груз и живучесть согласованы между экранами.

Import game_config

' #region Закрытое состояние пилота

Private Dim credits As Long = START_CREDITS                                                             ' Кредиты на счету пилота.
Private Dim cargoQty[1 To GOODS_TOTAL] As Integer                                                       ' Груз: тонн по каждому товару (1..GOODS_TOTAL).
Private Dim cargoTonsUsed As Integer = 0                                                                ' Суммарная загрузка трюма, тонн.

' #endregion

' #region Закрытое состояние живучести (этап 4)

Private Dim shieldAmount As Double = PLAYER_SHIELD_MAX                                                  ' Щиты: поглощают урон до корпуса.
Private Dim hullAmount As Double = PLAYER_HULL_MAX                                                      ' Корпус: запас прочности после щитов.
Private Dim energyAmount As Double = PLAYER_ENERGY_MAX                                                  ' Энергия: питает подзарядку щитов.

' #endregion

' #region Кредиты

' GetCredits — Текущий счёт пилота.
Public Function GetCredits() As Long
    Return credits
End Function

' AddCredits — Изменяет счёт на дельту (покупка — минус, продажа — плюс).
' Списание больше остатка отклоняется: долг не предусмотрен.
Public Function AddCredits(delta As Long) As Boolean
    If delta < 0 And credits + delta < 0 Then
        Return False                                                                                    ' Недостаточно кредитов.
    End If

    credits = credits + delta
    Return True
End Function

' #endregion

' #region Грузовой трюм

' GetCargoQty — Тонн выбранного товара в трюме.
Public Function GetCargoQty(goodIndex As Integer) As Integer
    Return cargoQty[goodIndex]
End Function

' CargoUsed — Суммарная загрузка трюма, тонн.
Public Function CargoUsed() As Integer
    Return cargoTonsUsed
End Function

' CargoFree — Свободный остаток трюма, тонн.
Public Function CargoFree() As Integer
    Return CARGO_MAX_TONS - cargoTonsUsed
End Function

' ChangeCargo — Меняет количество товара на дельту с проверкой ёмкости
' и неотрицательности. Возвращает FALSE, если операция невозможна.
Public Function ChangeCargo(goodIndex As Integer, delta As Integer) As Boolean
    Dim newQty As Integer = cargoQty[goodIndex] + delta                                                 ' Пробное количество товара.

    If newQty < 0 Then
        Return False                                                                                    ' Продать больше, чем есть, нельзя.
    End If
    If cargoTonsUsed + delta > CARGO_MAX_TONS Then
        Return False                                                                                    ' Трюм переполнен.
    End If

    cargoQty[goodIndex] = newQty                                                                        ' Применяем изменение товара.
    cargoTonsUsed = cargoTonsUsed + delta                                                                       ' И суммарной загрузки.
    Return True
End Function

' #endregion

' #region Живучесть корабля (этап 4)

' ShipShieldRatio / ShipHullRatio / ShipEnergyRatio — Заполненность щитов,
' корпуса и энергии в долях единицы: приборная панель рисует полосы
' умножением ширины на эти значения.
Public Function ShipShieldRatio() As Double
    Return shieldAmount / PLAYER_SHIELD_MAX
End Function

Public Function ShipHullRatio() As Double
    Return hullAmount / PLAYER_HULL_MAX
End Function

Public Function ShipEnergyRatio() As Double
    Return energyAmount / PLAYER_ENERGY_MAX
End Function

' ApplyShipDamage — Наносит урон каскадом, как в классике: сначала расходуются
' щиты, остаток уходит в корпус. Значения не опускаются ниже нуля.
' Возвращает TRUE, если после удара корпус уничтожен: вызывающий код боя
' решает, что делать с погибшим пилотом.
Public Function ApplyShipDamage(damageAmount As Double) As Boolean
    Dim absorbedByShield As Double = Min(damageAmount, shieldAmount)                                    ' Сколько урона возьмут на себя щиты.

    shieldAmount = shieldAmount - absorbedByShield                                                      ' Щиты тратятся первыми...
    Dim toHull As Double = damageAmount - absorbedByShield                                              ' ...остаток проходит в корпус.
    If toHull > 0.0 Then
        hullAmount = hullAmount - toHull                                                                ' Корпус пробит: прочность убывает.
    End If

    If shieldAmount < 0.0 Then
        shieldAmount = 0.0                                                                              ' Щиты не бывают отрицательными.
    End If
    If hullAmount < 0.0 Then
        hullAmount = 0.0                                                                                ' Корпус тоже: ноль означает гибель.
    End If

    Return hullAmount <= 0.0                                                                            ' TRUE — корабль уничтожен.
End Function

' RechargeShipSystems — Шаг восстановления: энергию корабль вырабатывает сам,
' а щиты заряжаются от энергии один к одному, пока она есть (принцип
' «щиты питаются энергией» из классики). Вызывается раз за шаг симуляции.
Public Sub RechargeShipSystems(dtSeconds As Double)
    energyAmount = energyAmount + PLAYER_ENERGY_REGEN * dtSeconds                                       ' Банки энергии восстанавливаются постоянно.
    If energyAmount > PLAYER_ENERGY_MAX Then
        energyAmount = PLAYER_ENERGY_MAX                                                                ' Выше ёмкости не запасём.
    End If

    If shieldAmount < PLAYER_SHIELD_MAX And energyAmount > 0.0 Then                                     ' Щиты просят заряд, пока энергия есть.
        Dim needed As Double = PLAYER_SHIELD_MAX - shieldAmount                                         ' Сколько щитам осталось до полного.
        Dim charge As Double = Min(PLAYER_SHIELD_REGEN * dtSeconds, energyAmount)                       ' Заряд ограничен скоростью и энергией.
        charge = Min(charge, needed)                                                                    ' И остатком ёмкости щитов.

        shieldAmount = shieldAmount + charge                                                            ' Щиты заряжаются...
        energyAmount = energyAmount - charge                                                            ' ...а энергия расходуется один к одному.
    End If
End Sub

' RestoreShipFully — Полное восстановление щитов, корпуса и энергии:
' авария пилота (спасательная капсула) возвращает корабль в строй.

Public Sub RestoreShipFully()
    shieldAmount = PLAYER_SHIELD_MAX
    hullAmount = PLAYER_HULL_MAX
    energyAmount = PLAYER_ENERGY_MAX
End Sub

' #endregion
