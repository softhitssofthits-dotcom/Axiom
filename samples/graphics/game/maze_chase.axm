' maze_chase — живой пример современного графического слоя Axiom.                              ' Пример показывает карту, актёров, поиск пути и игровой цикл.
' CANVAS выводит фон и спрайты, а симуляция работает с клеточной картой.                        ' Калибровка точек хранится в отдельном текстовом файле.
' Управление: стрелки ведут героя, SPACE ставит паузу, ESC завершает пример.                  ' Подсказка сразу объясняет, как запускать и проверять программу.

Const TILE As Integer = 16                                                                      ' Размер одной логической клетки лабиринта в пикселях.
Const VIEW_WIDTH As Integer = 1024                                                              ' Широкий холст даёт нормальное окно без ощущения вытянутого поля.
Const VIEW_HEIGHT As Integer = 660                                                              ' Высота холста вмещает весь лабиринт и HUD без ручного сдвига подложки.
Const HUD_HEIGHT As Integer = 30                                                                ' Высота верхней панели со счётом и подсказкой.

Const PLAYER_SPEED As Integer = 4                                                               ' Скорость героя в пикселях за фиксированный шаг симуляции.
Const GHOST_SPEED As Integer = 3                                                                ' Скорость призрака в пикселях за фиксированный шаг симуляции.
Const FIXED_STEP_SECONDS As Double = 0.0166666667                                               ' Частота симуляции близка к 60 шагам в секунду.
Const MAX_FRAME_DELTA_SECONDS As Double = 0.1                                                   ' Ограничиваем догоняющие шаги после долгой паузы окна.
Const MAX_CATCH_UP_STEPS As Integer = 6                                                         ' Не выполняем больше шести шагов за один показ кадра.

Const DIR_LEFT As Integer = 1                                                                   ' Код направления влево.
Const DIR_RIGHT As Integer = 2                                                                  ' Код направления вправо.
Const DIR_UP As Integer = 3                                                                     ' Код направления вверх.
Const DIR_DOWN As Integer = 4                                                                   ' Код направления вниз.

Dim WALL_FILL_COLOR As Integer = Rgb(12, 40, 118)                                              ' Цвет заливки стен, оставлен как часть палитры примера.
Dim WALL_LIGHT_COLOR As Integer = Rgb(90, 214, 255)                                            ' Светлая голубая линия для HUD и декоративных контуров.
Dim WALL_SHADOW_COLOR As Integer = Rgb(7, 18, 62)                                              ' Тёмный оттенок палитры стен, оставлен для возможных доработок.
Dim BACKGROUND_COLOR As Integer = Rgb(1, 4, 14)                                                ' Почти чёрный фон за пределами картинки лабиринта.
Dim POWER_PELLET_COLOR As Integer = Rgb(255, 240, 176)                                         ' Цвет обычных и крупных точек.
Dim HUD_BACKGROUND_COLOR As Integer = Rgb(4, 8, 18)                                            ' Фон информационной панели сверху.
Dim HUD_TEXT_COLOR As Integer = Rgb(255, 244, 180)                                             ' Цвет строки со счётом и числом жизней.
Dim HUD_STATUS_COLOR As Integer = Rgb(210, 228, 255)                                           ' Цвет строки статуса с подсказками игроку.
Dim CALIBRATION_LINE_COLOR As Integer = Rgb(255, 80, 80)                                      ' Цвет яркой направляющей линии в режиме ручной калибровки.
Dim CALIBRATION_TEXT_COLOR As Integer = Rgb(255, 230, 130)                                     ' Цвет текста калибровки, чтобы он отличался от обычного HUD.
Dim CALIBRATION_GRID_COLOR As Integer = Rgb(10, 34, 52)                                        ' Цвет тонкой сетки сделан более приглушённым, чтобы она меньше спорила с лабиринтом.
Dim CALIBRATION_PANEL_X As Integer = 8                                                         ' Левая координата боковой панели калибровки.
Dim CALIBRATION_PANEL_Y As Integer = 88                                                        ' Верхняя координата боковой панели, чтобы она не закрывала верх поля.
Dim CALIBRATION_PANEL_WIDTH As Integer = 264                                                    ' Ширина боковой панели с подсказками.
Dim CALIBRATION_PANEL_HEIGHT As Integer = 172                                                   ' Высота боковой панели увеличена, чтобы длинный статус помещался в две строки.
Const CALIBRATION_GRID_STEP As Integer = 8                                                      ' Шаг мелкой сетки в пикселях, как в тетрадке по математике.

Const CALIBRATION_ROW_MODE As Integer = 1                                                      ' Код режима, в котором двигаем вертикальное положение выбранной строки.
Const CALIBRATION_COL_MODE As Integer = 2                                                      ' Код режима, в котором двигаем горизонтальное положение выбранного столбца.

Const MAZE_ROWS As Integer = 36                                                                 ' Число строк логической карты.
Const MAZE_COLUMNS As Integer = 28                                                              ' Число столбцов логической карты.
Dim maze(1 To MAZE_ROWS) As String                                                              ' Массив строк, в котором хранится логическая карта лабиринта.
Dim mazeCols As Integer = 0                                                                     ' Количество столбцов логической карты, вычисляется после загрузки.

Dim mazeBackground As Image                                                                     ' Фоновая картинка лабиринта, которую мы рисуем как эталонный контур.
Dim playerFrames(1 To 12) As Sprite                                                            ' Набор кадров героя: 4 направления по 3 кадра.
Dim ghostSprite As Sprite                                                                       ' Спрайт призрака, который гонится за героем.

Dim pelletRowOffset(1 To MAZE_ROWS) As Integer                                                  ' Вертикальная поправка к началу клетки для выравнивания с картинкой.
Dim pelletColOffset(1 To MAZE_COLUMNS) As Integer                                               ' Горизонтальная поправка к началу клетки для выравнивания с картинкой.

Dim playerStartCol As Integer                                                                   ' Стартовый столбец героя на логической сетке.
Dim playerStartRow As Integer                                                                   ' Стартовая строка героя на логической сетке.
Dim ghostStartCol As Integer                                                                    ' Стартовый столбец призрака на логической сетке.
Dim ghostStartRow As Integer                                                                    ' Стартовая строка призрака на логической сетке.

Type Walker                                                                                     ' Общие клеточные координаты и направление любого движущегося персонажа.
    tileCol As Integer
    tileRow As Integer
    dir As Integer
    wantedDir As Integer
    facing As Integer
    travel As Integer
    animationStep As Integer
End Type
Dim player As Walker                                                                            ' Состояние героя меняется общей процедурой движения.
Dim ghost As Walker                                                                             ' Состояние призрака использует ту же модель перемещения.

Dim pelletsLeft As Integer                                                                      ' Сколько точек осталось на карте.
Dim score As Integer                                                                            ' Сколько очков уже набрал игрок.
Dim lives As Integer = 3                                                                        ' Сколько жизней осталось у игрока.
Dim worldWidthPixels As Integer                                                                 ' Полная ширина мира в пикселях.
Dim worldHeightPixels As Integer                                                                ' Полная высота мира в пикселях.
Dim exitRequested As Boolean = False                                                            ' Флаг ручного выхода из программы по ESC.
Dim finished As Boolean = False                                                                 ' Флаг завершения партии по победе или проигрышу.
Dim paused As Boolean = False                                                                   ' Флаг паузы: TRUE означает, что игра временно остановлена.
Dim mazeErrorMessage As String = ""                                                            ' Ошибка структуры карты не допускает запуск игровой логики.
Dim calibrationErrorMessage As String = ""                                                     ' Ошибка калибровки оставляет встроенные значения по умолчанию.
Dim previousFrameTime As Double = 0                                                             ' Предыдущее показание часов для ограниченного шага симуляции.
Dim frameDeltaSeconds As Double = 0                                                            ' Время между показами кадра после проверки скачков часов.
Dim simulationAccumulator As Double = 0                                                        ' Накопленное время для независимых от отрисовки шагов игры.
Dim currentFrameTime As Double = 0                                                             ' Текущее показание TIMER для расчёта прошедшего времени.
Dim parsedRowValues(1 TO MAZE_ROWS) As Integer                                                 ' Проверенные значения смещения строк из внешнего файла.
Dim parsedColValues(1 TO MAZE_COLUMNS) As Integer                                              ' Проверенные значения смещения столбцов из внешнего файла.
Dim parsedRowSeen(1 TO MAZE_ROWS) As Integer                                                   ' Флаги найденных строк таблицы калибровки.
Dim parsedColSeen(1 TO MAZE_COLUMNS) As Integer                                                ' Флаги найденных столбцов таблицы калибровки.
Dim calibrationText As String = ""                                                            ' Текст внешнего снимка калибровки.
Dim calibrationLines() As String                                                               ' Строки внешнего снимка калибровки.
Dim calibrationParseError As String = ""                                                      ' Ошибка разбора внешней таблицы калибровки.
Dim statusText As String = "Стрелки ведут героя. SPACE пауза. ESC выход."                      ' Текст подсказки и игровых сообщений в HUD.
Dim calibrationMode As Boolean = False                                                         ' Флаг ручной калибровки: TRUE означает, что стрелки двигают точки, а не героя.
Dim calibrationTarget As Integer = CALIBRATION_ROW_MODE                                        ' Что сейчас калибруем: строку точек или столбец точек.
Dim calibrationRow As Integer = 5                                                              ' Номер выбранной строки точек; по умолчанию берём первый видимый верхний ряд.
Dim calibrationCol As Integer = 1                                                              ' Номер выбранного столбца точек; его можно переключить клавишами W и S.
Dim calibrationFilePath As String = ""                                                         ' Путь к файлу рядом с игрой, куда по R записываются готовые строки настройки.
Dim calibrationStatusText As String = "Готово к калибровке."                                   ' Первая строка текущего статуса режима калибровки.
Dim calibrationStatusTextLine2 As String = "r линия. t вся таблица."                           ' Вторая строка статуса нужна для длинных сообщений без наползания на поле.

LoadResources()                                                                                 ' Загружаем фон лабиринта и спрайты персонажей.
InitPelletAlignment()                                                                           ' Настраиваем реальные центры проходов, чтобы точки легли в тоннели картинки.
InitCalibrationFile()                                                                           ' Готовим путь к файлу рядом с игрой, куда будем складывать ручные значения калибровки.
LoadPelletAlignment()                                                                           ' При наличии полного снимка используем его вместо встроенных значений.
InitMaze()                                                                                      ' Загружаем текстовую схему карты и считаем стартовые точки.
If mazeErrorMessage = "" Then                                                                  ' Стартовые координаты безопасны только после проверки карты.
    ResetActors()                                                                               ' Ставим героя и призрака в их начальные позиции.
Else                                                                                            ' При неверной карте пропускаем игровой цикл.
    exitRequested = True                                                                        ' Не запускаем перемещение по некорректной схеме.
End If                                                                                          ' Завершаем обработку результата проверки карты.
If calibrationParseError <> "" Then
    statusText = "Калибровка не загружена: " + calibrationParseError ' Ошибка файла оставляет встроенные значения по умолчанию.
End If

worldWidthPixels = mazeCols * TILE                                                              ' Переводим ширину карты из клеток в пиксели.
worldHeightPixels = MAZE_ROWS * TILE                                                             ' Переводим высоту карты из клеток в пиксели.
previousFrameTime = TIMER()                                                                     ' Запоминаем начало измерения игрового времени.
simulationAccumulator = FIXED_STEP_SECONDS                                                     ' Первый шаг симуляции доступен сразу.

Smooth On

Canvas VIEW_WIDTH, VIEW_HEIGHT                                                                  ' Открываем холст, в который теперь помещается весь лабиринт целиком.

Do While Not exitRequested                                                                      ' Главный игровой цикл продолжается, пока игрок не попросит выход.
    Beginframe                                                                                  ' Начинаем новый кадр современного графического холста.
    Cls BACKGROUND_COLOR                                                                        ' Очищаем фон кадра перед рисованием.

    currentFrameTime = TIMER()                                                                  ' Берём показание часов один раз на кадр.
    frameDeltaSeconds = currentFrameTime - previousFrameTime                                    ' Считаем время, прошедшее с предыдущего кадра.
    previousFrameTime = currentFrameTime                                                        ' Сохраняем показание для следующего кадра.
    If frameDeltaSeconds < 0 Then
        frameDeltaSeconds = 0                                                                  ' TIMER сбрасывается в полночь, поэтому отрицательное время игнорируем.
    End If
    If frameDeltaSeconds > MAX_FRAME_DELTA_SECONDS Then
        frameDeltaSeconds = MAX_FRAME_DELTA_SECONDS                                             ' Ограничиваем скачки часов и возврат после блокировки окна.
    End If

    If CalibrationHotKeyPressed("K") Then                                                       ' Если нажали K или k...
        calibrationMode = Not calibrationMode                                                   ' ...включаем или выключаем режим ручной калибровки точек.
        If calibrationMode Then                                                                 ' Если режим калибровки теперь включён...
            paused = False                                                                      ' ...снимаем обычную паузу, потому что калибровка сама замораживает механику.
            SetCalibrationStatusText("Калибровка включена.", "t запишет всю таблицу.")         ' Показываем понятное подтверждение включения режима в две короткие строки.
        Else                                                                                    ' Если калибровку выключили...
            SetCalibrationStatusText("Калибровка выключена.", "K включает её снова.")          ' Сообщаем, что режим больше не активен, и тоже не растягиваем строку.
        End If                                                                                  ' Завершаем переключение калибровки.
    End If                                                                                      ' Завершаем обработку клавиши K.

    If calibrationMode Then                                                                     ' Если включена ручная калибровка...
        HandleCalibrationInput()                                                                ' ...читаем клавиши калибровки и двигаем выбранные точки.
    End If                                                                                      ' Завершаем обработку режима калибровки.

    If Keypress("SPACE") And Not finished And Not calibrationMode Then                          ' Если нажали пробел и мы не в режиме калибровки...
        paused = Not paused                                                                     ' ...переключаем паузу туда или обратно.
    End If                                                                                      ' Завершаем обработку клавиши паузы.

    If Not finished And Not paused And Not calibrationMode Then                                 ' Пока игра активна, накапливаем время независимой симуляции.
        simulationAccumulator = simulationAccumulator + frameDeltaSeconds                      ' Время отрисовки не меняет скорость персонажей.
        For catchUpSteps = 1 To MAX_CATCH_UP_STEPS                                               ' Проверяем не больше шести возможных шагов.
            If simulationAccumulator >= FIXED_STEP_SECONDS Then                                 ' Работаем только если накопилось полное время.
                If Not finished Then                                                            ' После победы или поражения мир замораживается.
                    UpdateGameStep()                                                            ' Выполняем один полный шаг игровой логики.
                    simulationAccumulator = simulationAccumulator - FIXED_STEP_SECONDS          ' Списываем обработанный интервал.
                End If                                                                          ' Завершаем проверку состояния партии.
            End If                                                                              ' Завершаем проверку накопленного времени.
        Next                                                                                    ' Переходим к следующей попытке догнать симуляцию.
        If simulationAccumulator >= FIXED_STEP_SECONDS Then
            simulationAccumulator = 0                                                           ' Сбрасываем лишнее время после достижения лимита.
        End If
    Else                                                                                        ' Если партия завершена или стоит на паузе...
        simulationAccumulator = 0                                                               ' После паузы не пытаемся ускоренно догонять игровое время.
        player.animationStep = 0                                                                ' ...останавливаем анимацию героя, чтобы он не жевал в паузе.
    End If                                                                                      ' Завершаем обновление логики кадра.

    DrawMazeWorld()                                                                             ' Рисуем лабиринт, точки и персонажей в мировых координатах.
    If calibrationMode Then                                                                     ' Если сейчас идёт ручная калибровка...
        DrawCalibrationOverlay()                                                                ' ...рисуем направляющую линию поверх выбранной строки или столбца.
    End If                                                                                      ' Завершаем рисование калибровочного слоя.
    DrawHud()                                                                                   ' Рисуем верхнюю информационную панель в экранных координатах.
    Present                                                                                     ' Показываем собранный кадр на экране.
    Sleep 1                                                                                     ' Отдаём процессор ОС; скорость игры задаёт фиксированный шаг выше.

    If Keypress("ESC") Then                                                                     ' Если в этом кадре нажали ESC...
        exitRequested = True                                                                    ' ...запрашиваем выход из главного цикла.
    End If                                                                                      ' Завершаем проверку клавиши ESC.
Loop                                                                                            ' Возвращаемся к следующему кадру.

Screen 0                                                                                        ' Возвращаем обычный текстовый экран после выхода из игры.
If mazeErrorMessage <> "" Then
    PRINT "Ошибка карты Maze Chase: " + mazeErrorMessage                                         ' Показываем проверочную ошибку после закрытия графического режима.
End If

Sub UpdateGameStep()                                                                            ' Процедура выполняет один фиксированный шаг игровой логики.
    UpdatePlayerInput()                                                                         ' Считываем клавиши и записываем желаемое направление героя.
    StepWalker(player, PLAYER_SPEED, False)                                                     ' Двигаем героя по сетке с учётом стен и пиксельного остатка.

    If player.dir <> 0 Then                                                                     ' Если герой реально движется...
        player.facing = player.dir                                                              ' ...поворачиваем его спрайт в это направление.
    End If                                                                                      ' Завершаем обновление направления взгляда.

    UpdatePlayerAnimation()                                                                     ' Обновляем фазу анимации рта героя.
    EatPelletIfNeeded()                                                                         ' Проверяем, стоит ли герой на точке, и съедаем её.
    StepWalker(ghost, GHOST_SPEED, True)                                                        ' Двигаем призрака и выбираем путь в каждом центре клетки.

    If EntitiesOverlap() Then                                                                   ' Если герой и призрак подошли слишком близко...
        lives = lives - 1                                                                       ' ...уменьшаем число жизней.
        If lives <= 0 Then                                                                      ' Если жизней больше не осталось...
            finished = True                                                                     ' ...завершаем партию поражением.
            statusText = "Жизни закончились. Нажмите ESC."                                     ' Показываем сообщение о проигрыше.
        Else                                                                                    ' Иначе у игрока ещё есть шанс продолжить.
            statusText = "Призрак догнал героя. Позиции сброшены."                             ' Сообщаем о столкновении и новом старте.
            ResetActors()                                                                       ' Возвращаем обоих персонажей на стартовые позиции.
        End If                                                                                  ' Завершаем обработку потери жизни.
    End If                                                                                      ' Завершаем проверку столкновения.

    If pelletsLeft = 0 Then                                                                     ' Если на карте не осталось точек...
        finished = True                                                                         ' ...завершаем партию победой.
        statusText = "Все точки собраны. Нажмите ESC."                                         ' Показываем сообщение о победе.
    End If                                                                                      ' Завершаем проверку победы.
End Sub                                                                                         ' Завершаем один шаг симуляции.

Sub LoadResources()                                                                             ' Процедура загружает все графические ресурсы игры.
    mazeBackground = Loadimage("art/Background.gif")                                            ' Загружаем эталонный фон лабиринта из GIF-файла.

    playerFrames(SpriteSlot(DIR_RIGHT, 1)) = Loadsprite("art/pacman-right/1.png", 16, 16)     ' Загружаем первый кадр героя, смотрящего вправо.
    playerFrames(SpriteSlot(DIR_RIGHT, 2)) = Loadsprite("art/pacman-right/2.png", 16, 16)     ' Загружаем второй кадр героя, смотрящего вправо.
    playerFrames(SpriteSlot(DIR_RIGHT, 3)) = Loadsprite("art/pacman-right/3.png", 16, 16)     ' Загружаем третий кадр героя, смотрящего вправо.

    playerFrames(SpriteSlot(DIR_LEFT, 1)) = Loadsprite("art/pacman-left/1.png", 16, 16)       ' Загружаем первый кадр героя, смотрящего влево.
    playerFrames(SpriteSlot(DIR_LEFT, 2)) = Loadsprite("art/pacman-left/2.png", 16, 16)       ' Загружаем второй кадр героя, смотрящего влево.
    playerFrames(SpriteSlot(DIR_LEFT, 3)) = Loadsprite("art/pacman-left/3.png", 16, 16)       ' Загружаем третий кадр героя, смотрящего влево.

    playerFrames(SpriteSlot(DIR_UP, 1)) = Loadsprite("art/pacman-up/1.png", 16, 16)           ' Загружаем первый кадр героя, смотрящего вверх.
    playerFrames(SpriteSlot(DIR_UP, 2)) = Loadsprite("art/pacman-up/2.png", 16, 16)           ' Загружаем второй кадр героя, смотрящего вверх.
    playerFrames(SpriteSlot(DIR_UP, 3)) = Loadsprite("art/pacman-up/3.png", 16, 16)           ' Загружаем третий кадр героя, смотрящего вверх.

    playerFrames(SpriteSlot(DIR_DOWN, 1)) = Loadsprite("art/pacman-down/1.png", 16, 16)       ' Загружаем первый кадр героя, смотрящего вниз.
    playerFrames(SpriteSlot(DIR_DOWN, 2)) = Loadsprite("art/pacman-down/2.png", 16, 16)       ' Загружаем второй кадр героя, смотрящего вниз.
    playerFrames(SpriteSlot(DIR_DOWN, 3)) = Loadsprite("art/pacman-down/3.png", 16, 16)       ' Загружаем третий кадр героя, смотрящего вниз.

    ghostSprite = Loadsprite("art/ghosts/blinky.png", 16, 16)                                  ' Загружаем спрайт красного призрака.
End Sub                                                                                         ' Завершаем загрузку ресурсов.

Sub InitCalibrationFile()                                                                       ' Процедура готовит путь для файла ручной калибровки рядом с игрой.
    calibrationFilePath = Combinepath(Currentdir(), "maze_chase_pellet_calibration.txt")       ' Запоминаем файл рядом с `maze_chase.axm`, куда R дописывает значения.
End Sub                                                                                         ' Завершаем подготовку файла калибровки.

Sub LoadPelletAlignment()                                                                       ' Процедура загружает только полный и проверенный снимок калибровки.
    If Not FileExists(calibrationFilePath) Then
        Return                                                                                  ' При отсутствии файла остаются встроенные значения.
    End If

    calibrationText = ReadFile(calibrationFilePath)                                             ' Читаем внешний файл, не изменяя исходник игры.
    ParseCalibrationText(calibrationText)                                                        ' Проверяем структуру, диапазоны и полноту таблиц.
    If calibrationParseError <> "" Then
        Return                                                                                  ' Частичная или повреждённая таблица не применяется.
    End If

    For rowIndex = 1 To MAZE_ROWS                                                               ' Применяем только прошедшие полную проверку смещения.
        pelletRowOffset(rowIndex) = parsedRowValues(rowIndex)
    Next
    For colIndex = 1 To MAZE_COLUMNS
        pelletColOffset(colIndex) = parsedColValues(colIndex)
    Next
End Sub                                                                                         ' Завершаем чтение внешней калибровки.

Sub ResetParsedCalibration()                                                                    ' Процедура очищает таблицы перед новым разбором файла.
    calibrationParseError = ""                                                                  ' Сбрасываем прежнюю ошибку.
    For rowIndex = 1 To MAZE_ROWS                                                               ' Очищаем значения и признаки строк.
        parsedRowValues(rowIndex) = 0
        parsedRowSeen(rowIndex) = 0
    Next
    For colIndex = 1 To MAZE_COLUMNS                                                            ' Очищаем значения и признаки столбцов.
        parsedColValues(colIndex) = 0
        parsedColSeen(colIndex) = 0
    Next
End Sub                                                                                         ' Завершаем очистку служебных таблиц.

Sub ParseCalibrationText(sourceText As String)                                                  ' Процедура разбирает снимок построчно и отвергает неизвестные записи.
    Dim currentCalibrationLine As String = ""
    calibrationLines = Split(sourceText, Chr(10))                                               ' Поддерживаем обычные файлы с переводом строк LF или CRLF.
    ResetParsedCalibration()                                                                    ' Каждое чтение начинает проверку с чистого состояния.

    For lineIndex = 1 To ArrayLength(calibrationLines)                                          ' Идём по всем строкам файла.
        currentCalibrationLine = Trim(TrimTrailingCr(calibrationLines(lineIndex)))             ' Убираем пробелы и CR в конце CRLF.
        If currentCalibrationLine <> "" And Left(currentCalibrationLine, 1) <> "'" Then       ' Пропускаем пустые строки и комментарии.
            If StartsWith(currentCalibrationLine, "pelletRowOffset(") Then                    ' Разбираем смещение каждой строки карты.
                ApplyCalibrationLine(currentCalibrationLine, MAZE_ROWS, True)
            ElseIf StartsWith(currentCalibrationLine, "pelletColOffset(") Then                ' Разбираем смещение каждого столбца карты.
                ApplyCalibrationLine(currentCalibrationLine, MAZE_COLUMNS, False)
            Else                                                                                ' Любая другая запись может скрывать опечатку.
                calibrationParseError = "неизвестная строка: " + currentCalibrationLine
            End If
        End If
        If calibrationParseError <> "" Then
            Return                                                                              ' После первой ошибки дальнейший разбор не нужен.
        End If
    Next

    For rowIndex = 1 To MAZE_ROWS                                                               ' Полный файл обязан содержать каждую строку ровно один раз.
        If parsedRowSeen(rowIndex) = 0 Then
            calibrationParseError = "нет pelletRowOffset(" + Trim(Str(rowIndex)) + ")."
            Return
        End If
    Next
    For colIndex = 1 To MAZE_COLUMNS                                                            ' Полный файл обязан содержать каждый столбец ровно один раз.
        If parsedColSeen(colIndex) = 0 Then
            calibrationParseError = "нет pelletColOffset(" + Trim(Str(colIndex)) + ")."
            Return
        End If
    Next
End Sub                                                                                         ' Завершаем строгий разбор файла.

Sub ApplyCalibrationLine(lineText As String, maxIndex As Integer, isRowLine As Boolean)
    Dim openPos As Integer = InStr(lineText, "(")
    Dim closePos As Integer = InStr(lineText, ")")
    Dim equalPos As Integer = InStr(lineText, "=")
    Dim indexText As String = ""
    Dim valueText As String = ""
    Dim indexNumber As Double = 0
    Dim valueNumber As Double = 0
    Dim parsedIndex As Integer = 0

    If openPos = 0 Or closePos <= openPos Or equalPos <= closePos Then
        calibrationParseError = "повреждённая строка: " + lineText
        Return
    End If
    indexText = Trim(Mid(lineText, openPos + 1, closePos - openPos - 1))
    valueText = Trim(Mid(lineText, equalPos + 1, Len(lineText) - equalPos))
    If Not IsNumeric(indexText) Or Not IsNumeric(valueText) Then
        calibrationParseError = "ожидались целые числа: " + lineText
        Return
    End If

    indexNumber = Val(indexText)
    valueNumber = Val(valueText)
    If indexNumber < 1 Or indexNumber > maxIndex Then
        calibrationParseError = "индекс вне диапазона: " + lineText
        Return
    End If
    If valueNumber < -2147483647 Or valueNumber > 2147483647 Then
        calibrationParseError = "смещение слишком велико: " + lineText
        Return
    End If
    If indexNumber <> Int(indexNumber) Or valueNumber <> Int(valueNumber) Then
        calibrationParseError = "ожидались целые числа: " + lineText
        Return
    End If

    parsedIndex = Int(indexNumber)
    If isRowLine Then
        If parsedRowSeen(parsedIndex) <> 0 Then
            calibrationParseError = "повтор pelletRowOffset(" + Trim(Str(parsedIndex)) + ")."
            Return
        End If
        parsedRowSeen(parsedIndex) = 1
        parsedRowValues(parsedIndex) = Int(valueNumber)
    Else
        If parsedColSeen(parsedIndex) <> 0 Then
            calibrationParseError = "повтор pelletColOffset(" + Trim(Str(parsedIndex)) + ")."
            Return
        End If
        parsedColSeen(parsedIndex) = 1
        parsedColValues(parsedIndex) = Int(valueNumber)
    End If
End Sub                                                                                         ' Завершаем проверку одной строки.

Function TrimTrailingCr(inputText As String) As String                                         ' Функция убирает CR после разбиения CRLF по LF.
    If Len(inputText) > 0 Then
        If Asc(Right(inputText, 1)) = 13 Then
            Return Left(inputText, Len(inputText) - 1)
        End If
    End If
    Return inputText
End Function                                                                                    ' Завершаем удаление хвостового CR.

Sub InitPelletAlignment()                                                                       ' Процедура задаёт реальные центры тоннелей на фоне лабиринта.
