' maze_chase — живой пример современного графического слоя Axiom.                              ' Этот пример показывает камеру, спрайты, HUD и игровой цикл.
' В одном файле собраны CANVAS, кадровый цикл, камера, спрайты, примитивы и HUD.              ' Так удобнее видеть всю игровую механику целиком.
' Управление: стрелки ведут героя, SPACE ставит паузу, ESC завершает пример.                  ' Подсказка сразу объясняет, как запускать и проверять программу.

DIM TILE AS INTEGER = 16                                                                        ' Размер одной логической клетки лабиринта в пикселях.
DIM VIEW_WIDTH AS INTEGER = 1024                                                                ' Широкий холст даёт нормальное окно без ощущения вытянутого поля.
DIM VIEW_HEIGHT AS INTEGER = 660                                                                ' Высота холста вмещает весь лабиринт и HUD без ручного сдвига подложки.
DIM HUD_HEIGHT AS INTEGER = 30 ' Высота верхней панели со счётом и подсказкой.

DIM PLAYER_SPEED AS INTEGER = 4                                                                 ' Скорость героя в пикселях за кадр.
DIM GHOST_SPEED AS INTEGER = 3                                                                  ' Скорость призрака в пикселях за кадр.

DIM DIR_LEFT AS INTEGER = 1                                                                     ' Код направления влево.
DIM DIR_RIGHT AS INTEGER = 2                                                                    ' Код направления вправо.
DIM DIR_UP AS INTEGER = 3                                                                       ' Код направления вверх.
DIM DIR_DOWN AS INTEGER = 4                                                                     ' Код направления вниз.

DIM WALL_FILL_COLOR AS INTEGER = RGB(12, 40, 118)                                              ' Цвет заливки стен, оставлен как часть палитры примера.
DIM WALL_LIGHT_COLOR AS INTEGER = RGB(90, 214, 255)                                            ' Светлая голубая линия для HUD и декоративных контуров.
DIM WALL_SHADOW_COLOR AS INTEGER = RGB(7, 18, 62)                                              ' Тёмный оттенок палитры стен, оставлен для возможных доработок.
DIM BACKGROUND_COLOR AS INTEGER = RGB(1, 4, 14)                                                ' Почти чёрный фон за пределами картинки лабиринта.
DIM POWER_PELLET_COLOR AS INTEGER = RGB(255, 240, 176)                                         ' Цвет обычных и крупных точек.
DIM HUD_BACKGROUND_COLOR AS INTEGER = RGB(4, 8, 18)                                            ' Фон информационной панели сверху.
DIM HUD_TEXT_COLOR AS INTEGER = RGB(255, 244, 180)                                             ' Цвет строки со счётом и числом жизней.
DIM HUD_STATUS_COLOR AS INTEGER = RGB(210, 228, 255)                                           ' Цвет строки статуса с подсказками игроку.
DIM CALIBRATION_LINE_COLOR AS INTEGER = RGB(255, 80, 80)                                      ' Цвет яркой направляющей линии в режиме ручной калибровки.
DIM CALIBRATION_TEXT_COLOR AS INTEGER = RGB(255, 230, 130)                                     ' Цвет текста калибровки, чтобы он отличался от обычного HUD.
DIM CALIBRATION_GRID_COLOR AS INTEGER = RGB(10, 34, 52)                                        ' Цвет тонкой сетки сделан более приглушённым, чтобы она меньше спорила с лабиринтом.
DIM CALIBRATION_PANEL_X AS INTEGER = 8                                                         ' Левая координата боковой панели калибровки.
DIM CALIBRATION_PANEL_Y AS INTEGER = 88                                                        ' Верхняя координата боковой панели, чтобы она не закрывала верх поля.
DIM CALIBRATION_PANEL_WIDTH AS INTEGER = 264                                                    ' Ширина боковой панели с подсказками.
DIM CALIBRATION_PANEL_HEIGHT AS INTEGER = 172                                                   ' Высота боковой панели увеличена, чтобы длинный статус помещался в две строки.
DIM CALIBRATION_GRID_STEP AS INTEGER = 8                                                        ' Шаг мелкой сетки в пикселях, как в тетрадке по математике.

DIM CALIBRATION_ROW_MODE AS INTEGER = 1                                                        ' Код режима, в котором двигаем вертикальное положение выбранной строки.
DIM CALIBRATION_COL_MODE AS INTEGER = 2                                                        ' Код режима, в котором двигаем горизонтальное положение выбранного столбца.

DIM maze(1 TO 36) AS STRING                                                                     ' Массив строк, в котором хранится логическая карта лабиринта.
DIM mazeRows AS INTEGER = 36                                                                    ' Количество строк логической карты.
DIM mazeCols AS INTEGER = 0                                                                     ' Количество столбцов логической карты, вычисляется после загрузки.

DIM mazeBackground AS IMAGE                                                                     ' Фоновая картинка лабиринта, которую мы рисуем как эталонный контур.
DIM playerFrames(1 TO 12) AS SPRITE                                                            ' Набор кадров героя: 4 направления по 3 кадра.
DIM ghostSprite AS SPRITE                                                                       ' Спрайт призрака, который гонится за героем.

DIM pelletCenterRows(1 TO 36) AS INTEGER                                                        ' Таблица вертикальных центров проходов по строкам лабиринта.
DIM pelletCenterCols(1 TO 28) AS INTEGER                                                        ' Таблица горизонтальных центров проходов по столбцам лабиринта.

DIM playerStartCol AS INTEGER                                                                   ' Стартовый столбец героя на логической сетке.
DIM playerStartRow AS INTEGER                                                                   ' Стартовая строка героя на логической сетке.
DIM ghostStartCol AS INTEGER                                                                    ' Стартовый столбец призрака на логической сетке.
DIM ghostStartRow AS INTEGER                                                                    ' Стартовая строка призрака на логической сетке.

DIM playerCol AS INTEGER                                                                        ' Текущий столбец героя.
DIM playerRow AS INTEGER                                                                        ' Текущая строка героя.
DIM playerDir AS INTEGER                                                                        ' Текущее фактическое направление героя.
DIM playerWantDir AS INTEGER                                                                    ' Желаемое направление героя, выбранное клавишами.
DIM playerFacing AS INTEGER                                                                     ' Направление, куда герой смотрит спрайтом.
DIM playerTravel AS INTEGER                                                                     ' Сколько пикселей герой уже прошёл внутри текущей клетки.
DIM playerAnimStep AS INTEGER                                                                   ' Текущий шаг анимации рта героя.

DIM ghostCol AS INTEGER                                                                         ' Текущий столбец призрака.
DIM ghostRow AS INTEGER                                                                         ' Текущая строка призрака.
DIM ghostDir AS INTEGER                                                                         ' Текущее фактическое направление призрака.
DIM ghostWantDir AS INTEGER                                                                     ' Желаемое направление призрака, которое выбирает простая логика погони.
DIM ghostTravel AS INTEGER                                                                      ' Сколько пикселей призрак уже прошёл внутри текущей клетки.

DIM pelletsLeft AS INTEGER                                                                      ' Сколько точек осталось на карте.
DIM score AS INTEGER                                                                            ' Сколько очков уже набрал игрок.
DIM lives AS INTEGER = 3                                                                        ' Сколько жизней осталось у игрока.
DIM worldWidthPixels AS INTEGER                                                                 ' Полная ширина мира в пикселях.
DIM worldHeightPixels AS INTEGER                                                                ' Полная высота мира в пикселях.
DIM exitRequested AS BOOLEAN = FALSE                                                            ' Флаг ручного выхода из программы по ESC.
DIM finished AS BOOLEAN = FALSE                                                                 ' Флаг завершения партии по победе или проигрышу.
DIM paused AS BOOLEAN = FALSE                                                                   ' Флаг паузы: TRUE означает, что игра временно остановлена.
DIM statusText AS STRING = "Стрелки ведут героя. SPACE пауза. ESC выход."                      ' Текст подсказки и игровых сообщений в HUD.
DIM calibrationMode AS BOOLEAN = FALSE                                                         ' Флаг ручной калибровки: TRUE означает, что стрелки двигают точки, а не героя.
DIM calibrationTarget AS INTEGER = CALIBRATION_ROW_MODE                                        ' Что сейчас калибруем: строку точек или столбец точек.
DIM calibrationRow AS INTEGER = 5                                                              ' Номер выбранной строки точек; по умолчанию берём первый видимый верхний ряд.
DIM calibrationCol AS INTEGER = 1                                                              ' Номер выбранного столбца точек; его можно переключить клавишами W и S.
DIM calibrationFilePath AS STRING = ""                                                         ' Путь к файлу рядом с игрой, куда по R записываются готовые строки настройки.
DIM calibrationStatusText AS STRING = "Готово к калибровке."                                   ' Первая строка текущего статуса режима калибровки.
DIM calibrationStatusTextLine2 AS STRING = "r линия. t вся таблица."                           ' Вторая строка статуса нужна для длинных сообщений без наползания на поле.

LoadResources()                                                                                 ' Загружаем фон лабиринта и спрайты персонажей.
InitPelletAlignment()                                                                           ' Настраиваем реальные центры проходов, чтобы точки легли в тоннели картинки.
InitCalibrationFile()                                                                           ' Готовим путь к файлу рядом с игрой, куда будем складывать ручные значения калибровки.
InitMaze()                                                                                      ' Загружаем текстовую схему карты и считаем стартовые точки.
ResetActors()                                                                                   ' Ставим героя и призрака в их начальные позиции.

worldWidthPixels = mazeCols * TILE                                                              ' Переводим ширину карты из клеток в пиксели.
worldHeightPixels = mazeRows * TILE                                                             ' Переводим высоту карты из клеток в пиксели.

CANVAS VIEW_WIDTH, VIEW_HEIGHT                                                                  ' Открываем холст, в который теперь помещается весь лабиринт целиком.

DO WHILE NOT exitRequested                                                                      ' Главный игровой цикл продолжается, пока игрок не попросит выход.
    BEGINFRAME                                                                                  ' Начинаем новый кадр современного графического холста.
    CLS BACKGROUND_COLOR                                                                        ' Очищаем фон кадра перед рисованием.

    IF CalibrationHotKeyPressed("K") THEN                                                       ' Если нажали K или k...
        calibrationMode = NOT calibrationMode                                                   ' ...включаем или выключаем режим ручной калибровки точек.
        IF calibrationMode THEN                                                                 ' Если режим калибровки теперь включён...
            paused = FALSE                                                                      ' ...снимаем обычную паузу, потому что калибровка сама замораживает механику.
            SetCalibrationStatusText("Калибровка включена.", "t запишет всю таблицу.")         ' Показываем понятное подтверждение включения режима в две короткие строки.
        ELSE                                                                                    ' Если калибровку выключили...
            SetCalibrationStatusText("Калибровка выключена.", "K включает её снова.")          ' Сообщаем, что режим больше не активен, и тоже не растягиваем строку.
        END IF                                                                                  ' Завершаем переключение калибровки.
    END IF                                                                                      ' Завершаем обработку клавиши K.

    IF calibrationMode THEN                                                                     ' Если включена ручная калибровка...
        HandleCalibrationInput()                                                                ' ...читаем клавиши калибровки и двигаем выбранные точки.
    END IF                                                                                      ' Завершаем обработку режима калибровки.

    IF KEYPRESS("SPACE") AND NOT finished AND NOT calibrationMode THEN                          ' Если нажали пробел и мы не в режиме калибровки...
        paused = NOT paused                                                                     ' ...переключаем паузу туда или обратно.
    END IF                                                                                      ' Завершаем обработку клавиши паузы.

    IF NOT finished AND NOT paused AND NOT calibrationMode THEN                                  ' Пока игра не закончилась, не стоит на паузе и не калибруется, обновляем механику.
        UpdatePlayerInput()                                                                     ' Считываем клавиши и записываем желаемое направление героя.
        StepWalker(playerCol, playerRow, playerDir, playerWantDir, playerTravel, PLAYER_SPEED) ' Двигаем героя по сетке с учётом стены и пиксельного остатка.

        IF playerDir <> 0 THEN                                                                  ' Если герой реально движется...
            playerFacing = playerDir                                                            ' ...поворачиваем его спрайт в это направление.
        END IF                                                                                  ' Завершаем обновление направления взгляда.

        UpdatePlayerAnimation()                                                                 ' Обновляем фазу анимации рта героя.
        EatPelletIfNeeded()                                                                     ' Проверяем, стоит ли герой на точке, и съедаем её.

        UpdateGhostDecision()                                                                   ' В узлах карты выбираем новое направление для призрака.
        StepWalker(ghostCol, ghostRow, ghostDir, ghostWantDir, ghostTravel, GHOST_SPEED)       ' Двигаем призрака той же общей процедурой.

        IF EntitiesOverlap() THEN                                                               ' Если герой и призрак подошли слишком близко...
            lives = lives - 1                                                                   ' ...уменьшаем число жизней.
            IF lives <= 0 THEN                                                                  ' Если жизней больше не осталось...
                finished = TRUE                                                                 ' ...завершаем партию поражением.
                statusText = "Жизни закончились. Нажмите ESC."                                 ' Показываем сообщение о проигрыше.
            ELSE                                                                                ' Иначе у игрока ещё есть шанс продолжить.
                statusText = "Призрак догнал героя. Позиции сброшены."                         ' Сообщаем о столкновении и новом старте.
                ResetActors()                                                                   ' Возвращаем обоих персонажей на стартовые позиции.
            END IF                                                                              ' Завершаем обработку потери жизни.
        END IF                                                                                  ' Завершаем проверку столкновения.

        IF pelletsLeft = 0 THEN                                                                 ' Если на карте не осталось точек...
            finished = TRUE                                                                     ' ...завершаем партию победой.
            statusText = "Все точки собраны. Нажмите ESC."                                     ' Показываем сообщение о победе.
        END IF                                                                                  ' Завершаем проверку победы.
    ELSE                                                                                        ' Если партия завершена или стоит на паузе...
        playerAnimStep = 0                                                                      ' ...останавливаем анимацию героя, чтобы он не жевал в паузе.
    END IF                                                                                      ' Завершаем обновление логики кадра.

    DrawMazeWorld()                                                                             ' Рисуем лабиринт, точки и персонажей в мировых координатах.
    IF calibrationMode THEN                                                                     ' Если сейчас идёт ручная калибровка...
        DrawCalibrationOverlay()                                                                ' ...рисуем направляющую линию поверх выбранной строки или столбца.
    END IF                                                                                      ' Завершаем рисование калибровочного слоя.
    DrawHud()                                                                                   ' Рисуем верхнюю информационную панель в экранных координатах.
    PRESENT                                                                                     ' Показываем собранный кадр на экране.
    SLEEP 16                                                                                    ' Делаем короткую паузу, чтобы цикл шёл спокойно и предсказуемо.

    IF KEYPRESS("ESC") THEN                                                                     ' Если в этом кадре нажали ESC...
        exitRequested = TRUE                                                                    ' ...запрашиваем выход из главного цикла.
    END IF                                                                                      ' Завершаем проверку клавиши ESC.
LOOP                                                                                            ' Возвращаемся к следующему кадру.

SCREEN 0                                                                                        ' Возвращаем обычный текстовый экран после выхода из игры.

SUB LoadResources()                                                                             ' Процедура загружает все графические ресурсы игры.
    mazeBackground = LOADIMAGE("art/Background.gif")                                            ' Загружаем эталонный фон лабиринта из GIF-файла.

    playerFrames(SpriteSlot(DIR_RIGHT, 1)) = LOADSPRITE("art/pacman-right/1.png", 16, 16)     ' Загружаем первый кадр героя, смотрящего вправо.
    playerFrames(SpriteSlot(DIR_RIGHT, 2)) = LOADSPRITE("art/pacman-right/2.png", 16, 16)     ' Загружаем второй кадр героя, смотрящего вправо.
    playerFrames(SpriteSlot(DIR_RIGHT, 3)) = LOADSPRITE("art/pacman-right/3.png", 16, 16)     ' Загружаем третий кадр героя, смотрящего вправо.

    playerFrames(SpriteSlot(DIR_LEFT, 1)) = LOADSPRITE("art/pacman-left/1.png", 16, 16)       ' Загружаем первый кадр героя, смотрящего влево.
    playerFrames(SpriteSlot(DIR_LEFT, 2)) = LOADSPRITE("art/pacman-left/2.png", 16, 16)       ' Загружаем второй кадр героя, смотрящего влево.
    playerFrames(SpriteSlot(DIR_LEFT, 3)) = LOADSPRITE("art/pacman-left/3.png", 16, 16)       ' Загружаем третий кадр героя, смотрящего влево.

    playerFrames(SpriteSlot(DIR_UP, 1)) = LOADSPRITE("art/pacman-up/1.png", 16, 16)           ' Загружаем первый кадр героя, смотрящего вверх.
    playerFrames(SpriteSlot(DIR_UP, 2)) = LOADSPRITE("art/pacman-up/2.png", 16, 16)           ' Загружаем второй кадр героя, смотрящего вверх.
    playerFrames(SpriteSlot(DIR_UP, 3)) = LOADSPRITE("art/pacman-up/3.png", 16, 16)           ' Загружаем третий кадр героя, смотрящего вверх.

    playerFrames(SpriteSlot(DIR_DOWN, 1)) = LOADSPRITE("art/pacman-down/1.png", 16, 16)       ' Загружаем первый кадр героя, смотрящего вниз.
    playerFrames(SpriteSlot(DIR_DOWN, 2)) = LOADSPRITE("art/pacman-down/2.png", 16, 16)       ' Загружаем второй кадр героя, смотрящего вниз.
    playerFrames(SpriteSlot(DIR_DOWN, 3)) = LOADSPRITE("art/pacman-down/3.png", 16, 16)       ' Загружаем третий кадр героя, смотрящего вниз.

    ghostSprite = LOADSPRITE("art/ghosts/blinky.png", 16, 16)                                  ' Загружаем спрайт красного призрака.
END SUB                                                                                         ' Завершаем загрузку ресурсов.

SUB InitCalibrationFile()                                                                       ' Процедура готовит путь для файла ручной калибровки рядом с игрой.
    calibrationFilePath = COMBINEPATH(CURRENTDIR(), "maze_chase_pellet_calibration.txt")       ' Запоминаем файл рядом с `maze_chase.axm`, куда R дописывает значения.
END SUB                                                                                         ' Завершаем подготовку файла калибровки.

SUB InitPelletAlignment()                                                                       ' Процедура задаёт реальные центры тоннелей на фоне лабиринта.
    ' Здесь мы задаём высоту точек по строкам карты.                                            ' Больше число = точка ниже. Меньше число = точка выше.
    ' Эти числа удобно крутить вручную и сразу смотреть результат в IDE.                        ' Так проще попасть в центр тоннеля по картинке.
    pelletCenterRows(1) = -37                                                                   ' Значение строки 1 полностью перенесено из файла калибровки.
    pelletCenterRows(2) = -37                                                                   ' Значение строки 2 полностью перенесено из файла калибровки.
    pelletCenterRows(3) = -37                                                                   ' Значение строки 3 полностью перенесено из файла калибровки.
    pelletCenterRows(4) = -34                                                                   ' Значение строки 4 полностью перенесено из файла калибровки.
    pelletCenterRows(5) = -33                                                                   ' Значение строки 5 полностью перенесено из файла калибровки.
    pelletCenterRows(6) = -23                                                                   ' Значение строки 6 полностью перенесено из файла калибровки.
    pelletCenterRows(7) = -19                                                                   ' Значение строки 7 полностью перенесено из файла калибровки.
    pelletCenterRows(8) = -16                                                                   ' Значение строки 8 полностью перенесено из файла калибровки.
    pelletCenterRows(9) = -15                                                                   ' Значение строки 9 полностью перенесено из файла калибровки.
    pelletCenterRows(10) = -8                                                                   ' Значение строки 10 полностью перенесено из файла калибровки.
    pelletCenterRows(11) = -3                                                                   ' Значение строки 11 полностью перенесено из файла калибровки.
    pelletCenterRows(12) = 1                                                                   ' Значение строки 12 полностью перенесено из файла калибровки.
    pelletCenterRows(13) = 2                                                                   ' Значение строки 13 полностью перенесено из файла калибровки.
    pelletCenterRows(14) = 1                                                                   ' Значение строки 14 полностью перенесено из файла калибровки.
    pelletCenterRows(15) = 2                                                                   ' Значение строки 15 полностью перенесено из файла калибровки.
    pelletCenterRows(16) = 7                                                                   ' Значение строки 16 полностью перенесено из файла калибровки.
    pelletCenterRows(17) = 10                                                                   ' Значение строки 17 полностью перенесено из файла калибровки.
    pelletCenterRows(18) = 15                                                                   ' Значение строки 18 полностью перенесено из файла калибровки.
    pelletCenterRows(19) = 14                                                                   ' Значение строки 19 полностью перенесено из файла калибровки.
    pelletCenterRows(20) = 14                                                                   ' Значение строки 20 полностью перенесено из файла калибровки.
    pelletCenterRows(21) = 13                                                                   ' Значение строки 21 полностью перенесено из файла калибровки.
    pelletCenterRows(22) = 20                                                                   ' Значение строки 22 полностью перенесено из файла калибровки.
    pelletCenterRows(23) = 21                                                                   ' Значение строки 23 полностью перенесено из файла калибровки.
    pelletCenterRows(24) = 26                                                                   ' Значение строки 24 полностью перенесено из файла калибровки.
    pelletCenterRows(25) = 26                                                                   ' Значение строки 25 полностью перенесено из файла калибровки.
    pelletCenterRows(26) = 24                                                                   ' Значение строки 26 полностью перенесено из файла калибровки.
    pelletCenterRows(27) = 27                                                                   ' Значение строки 27 полностью перенесено из файла калибровки.
    pelletCenterRows(28) = 33                                                                   ' Значение строки 28 полностью перенесено из файла калибровки.
    pelletCenterRows(29) = 40                                                                   ' Значение строки 29 полностью перенесено из файла калибровки.
    pelletCenterRows(30) = 42                                                                   ' Значение строки 30 полностью перенесено из файла калибровки.
    pelletCenterRows(31) = 42                                                                   ' Значение строки 31 полностью перенесено из файла калибровки.
    pelletCenterRows(32) = 40                                                                   ' Значение строки 32 полностью перенесено из файла калибровки.
    pelletCenterRows(33) = 38                                                                   ' Значение строки 33 полностью перенесено из файла калибровки.
    pelletCenterRows(34) = -37                                                                   ' Значение строки 34 полностью перенесено из файла калибровки.
    pelletCenterRows(35) = -37                                                                   ' Значение строки 35 полностью перенесено из файла калибровки.
    pelletCenterRows(36) = -37                                                                   ' Значение строки 36 полностью перенесено из файла калибровки.

    ' Здесь мы задаём положение точек по столбцам карты.                                        ' Больше число = точка правее. Меньше число = точка левее.
    pelletCenterCols(1) = 11                                                                    ' Значение столбца 1 полностью перенесено из файла калибровки.
    pelletCenterCols(2) = 11                                                                    ' Значение столбца 2 полностью перенесено из файла калибровки.
    pelletCenterCols(3) = 13                                                                    ' Значение столбца 3 полностью перенесено из файла калибровки.
    pelletCenterCols(4) = 18                                                                    ' Значение столбца 4 полностью перенесено из файла калибровки.
    pelletCenterCols(5) = 15                                                                    ' Значение столбца 5 полностью перенесено из файла калибровки.
    pelletCenterCols(6) = 14                                                                    ' Значение столбца 6 полностью перенесено из файла калибровки.
    pelletCenterCols(7) = 16                                                                    ' Значение столбца 7 полностью перенесено из файла калибровки.
    pelletCenterCols(8) = 14                                                                    ' Значение столбца 8 полностью перенесено из файла калибровки.
    pelletCenterCols(9) = 11                                                                    ' Значение столбца 9 полностью перенесено из файла калибровки.
    pelletCenterCols(10) = 12                                                                    ' Значение столбца 10 полностью перенесено из файла калибровки.
    pelletCenterCols(11) = 11                                                                    ' Значение столбца 11 полностью перенесено из файла калибровки.
    pelletCenterCols(12) = 12                                                                    ' Значение столбца 12 полностью перенесено из файла калибровки.
    pelletCenterCols(13) = 11                                                                    ' Значение столбца 13 полностью перенесено из файла калибровки.
    pelletCenterCols(14) = 11                                                                    ' Значение столбца 14 полностью перенесено из файла калибровки.
    pelletCenterCols(15) = 7                                                                    ' Значение столбца 15 полностью перенесено из файла калибровки.
    pelletCenterCols(16) = 6                                                                    ' Значение столбца 16 полностью перенесено из файла калибровки.
    pelletCenterCols(17) = 6                                                                    ' Значение столбца 17 полностью перенесено из файла калибровки.
    pelletCenterCols(18) = 3                                                                    ' Значение столбца 18 полностью перенесено из файла калибровки.
    pelletCenterCols(19) = 4                                                                    ' Значение столбца 19 полностью перенесено из файла калибровки.
    pelletCenterCols(20) = 3                                                                    ' Значение столбца 20 полностью перенесено из файла калибровки.
    pelletCenterCols(21) = 2                                                                    ' Значение столбца 21 полностью перенесено из файла калибровки.
    pelletCenterCols(22) = -1                                                                    ' Значение столбца 22 полностью перенесено из файла калибровки.
    pelletCenterCols(23) = 0                                                                    ' Значение столбца 23 полностью перенесено из файла калибровки.
    pelletCenterCols(24) = -2                                                                    ' Значение столбца 24 полностью перенесено из файла калибровки.
    pelletCenterCols(25) = -3                                                                    ' Значение столбца 25 полностью перенесено из файла калибровки.
    pelletCenterCols(26) = 0                                                                    ' Значение столбца 26 полностью перенесено из файла калибровки.
    pelletCenterCols(27) = 5                                                                    ' Значение столбца 27 полностью перенесено из файла калибровки.
    pelletCenterCols(28) = 6                                                                    ' Значение столбца 28 полностью перенесено из файла калибровки.
END SUB                                                                                         ' Завершаем настройку центров точек.
                                                                                         ' Завершаем настройку центров точек.
