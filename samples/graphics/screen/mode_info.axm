' Expected: graphics screen reports active mode and dimensions, then SCREEN 0 switches to text window.
SCREEN 5
PRINT "active="; SCREENISACTIVE()
PRINT "mode="; SCREENMODE()
PRINT "size="; SCREENWIDTH(); "x"; SCREENHEIGHT()
PRINT "Press ESC to close SCREEN"
DO WHILE NOT KEYPRESS("ESC")
LOOP
SCREEN 0
PRINT "text mode screen"
