' Этот пример показывает HUD-текст в современном кадре.
' Сначала камера смотрит на часть мира, затем HUD рисуется после RESETCAMERA.

CANVAS 320, 180

BEGINFRAME
' Смещаем мир вправо, чтобы фон и колонны рисовались в мировых координатах.
CAMERA 48, 0
CLS RGB(12, 18, 28)
FILLRECT 48, 28, 96, 96, RGB(26, 72, 140)
FILLRECT 180, 28, 48, 96, RGB(40, 110, 180)
DRAWRECT 48, 28, 96, 96, RGB(170, 220, 255)
DRAWRECT 180, 28, 48, 96, RGB(220, 240, 255)

' После сброса камеры HUD рисуется уже в экранных координатах.
RESETCAMERA
FILLRECT 0, 0, 320, 24, RGB(6, 8, 12)
DRAWTEXT "Очки: 12", 8, 6, RGB(255, 242, 170)
DRAWTEXT "HUD не уезжает вместе с камерой.", 8, 30, RGB(220, 230, 255)
PRESENT
SLEEP

BEGINFRAME
' Во втором кадре камера уходит ещё дальше по миру.
CAMERA 96, 0
CLS RGB(10, 14, 22)
FILLRECT 48, 28, 96, 96, RGB(26, 72, 140)
FILLRECT 180, 28, 48, 96, RGB(40, 110, 180)
FILLRECT 252, 44, 36, 64, RGB(205, 92, 35)
DRAWRECT 252, 44, 36, 64, RGB(255, 230, 200)

RESETCAMERA
FILLRECT 0, 0, 320, 24, RGB(6, 8, 12)
DRAWTEXT "Очки: 24", 8, 6, RGB(255, 242, 170)
DRAWTEXT "Текст HUD остаётся на месте.", 8, 30, RGB(220, 230, 255)
PRESENT
SLEEP
