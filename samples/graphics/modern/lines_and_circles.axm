' Этот пример показывает современные линии и круги.
' Он удобен для точечной проверки DRAWLINE, DRAWCIRCLE и FILLCIRCLE.

CANVAS 320, 180

BEGINFRAME
CLS RGB(14, 18, 28)
DRAWLINE 16, 16, 150, 16, RGB(255, 210, 70)
DRAWLINE 16, 16, 90, 90, RGB(120, 220, 255)
DRAWLINE 150, 16, 90, 90, RGB(255, 110, 120)
DRAWCIRCLE 228, 62, 28, RGB(255, 255, 255)
FILLCIRCLE 228, 62, 12, RGB(255, 196, 64)
FILLCIRCLE 64, 124, 18, RGB(72, 200, 120)
PRESENT
SLEEP

BEGINFRAME
CLS RGB(10, 12, 20)
DRAWLINE 24, 26, 296, 26, RGB(255, 255, 255)
DRAWLINE 24, 26, 160, 150, RGB(255, 140, 80)
DRAWLINE 296, 26, 160, 150, RGB(100, 210, 255)
DRAWCIRCLE 160, 94, 34, RGB(190, 220, 255)
FILLCIRCLE 160, 94, 8, RGB(255, 96, 96)
FILLCIRCLE 264, 122, 16, RGB(160, 120, 255)
PRESENT
SLEEP
