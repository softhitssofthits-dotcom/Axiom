' Этот пример показывает мировые координаты и камеру CANVAS.
' Один и тот же мир рисуется дважды, но камера показывает разные части.

CANVAS 320, 180

BEGINFRAME
CLS RGB(10, 12, 18)
CAMERA 0, 0

' Левая часть длинного мира.
FILLRECT 24, 52, 80, 56, RGB(32, 84, 160)
DRAWRECT 24, 52, 80, 56, RGB(200, 230, 255)
FILLRECT 184, 36, 68, 88, RGB(198, 92, 40)
DRAWRECT 184, 36, 68, 88, RGB(255, 220, 190)
DRAWLINE 0, 132, 460, 132, RGB(255, 255, 255)

RESETCAMERA
FILLRECT 0, 0, 320, 28, RGB(6, 8, 12)
DRAWTEXT "Камера смотрит на левую часть мира.", 8, 8, RGB(240, 240, 255)
PRESENT
SLEEP

BEGINFRAME
CLS RGB(10, 12, 18)
' Теперь камера смещается вправо.
CAMERA 132, 0

FILLRECT 24, 52, 80, 56, RGB(32, 84, 160)
DRAWRECT 24, 52, 80, 56, RGB(200, 230, 255)
FILLRECT 184, 36, 68, 88, RGB(198, 92, 40)
DRAWRECT 184, 36, 68, 88, RGB(255, 220, 190)
FILLRECT 356, 48, 56, 64, RGB(40, 146, 96)
DRAWRECT 356, 48, 56, 64, RGB(200, 255, 220)
DRAWLINE 0, 132, 460, 132, RGB(255, 255, 255)

RESETCAMERA
FILLRECT 0, 0, 320, 28, RGB(6, 8, 12)
DRAWTEXT "Теперь видна правая часть того же мира.", 8, 8, RGB(240, 240, 255)
PRESENT
SLEEP
